+                    DropdownMenuItem(
+                        text = { Text(entry.displayName) },
+                        onClick = {
+                            actions.onInterpolation(entry)
+                            interpolationMenu = false
+                        },
+                        trailingIcon = {
+                            if (entry == interpolation) Icon(Icons.Default.Check, contentDescription = null)
+                        },
+                    )
+                }
+            }
+        }
     }
 }
 
diff --git a/app/src/test/java/com/artflow/studio/core/pixels/BicubicTransformTest.kt b/app/src/test/java/com/artflow/studio/core/pixels/BicubicTransformTest.kt
new file mode 100644
index 0000000..5ef947f
--- /dev/null
+++ b/app/src/test/java/com/artflow/studio/core/pixels/BicubicTransformTest.kt
@@ -0,0 +1,180 @@
+package com.artflow.studio.core.pixels
+
+import com.artflow.studio.core.pixels.TransformQuad.Interpolation
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotSame
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.math.abs
+import kotlin.random.Random
+
+/** The Bicubic (Catmull-Rom) interpolation of Transform, checked against images whose right answer is known. */
+class BicubicTransformTest {
+    private val red = 0xFFFF0000.toInt()
+
+    private fun channels(argb: Int): IntArray = intArrayOf(argb ushr 24, (argb shr 16) and 0xFF, (argb shr 8) and 0xFF, argb and 0xFF)
+
+    @Test fun texelCentresComeBackBitForBit() {
+        val random = Random(41)
+        val buffer = PixelBuffer(7, 6, IntArray(42) { random.nextInt() })
+        val sampler = BicubicSampler(buffer)
+        for (y in 0 until 6) {
+            for (x in 0 until 7) assertEquals(buffer.pixels[y * 7 + x], sampler.sample(x + 0.5f, y + 0.5f))
+        }
+    }
+
+    @Test fun flatColourStaysFlatEverywhereInsideTheImage() {
+        val random = Random(5)
+        for (colour in listOf(0xFF3366CC.toInt(), 0x80FF8800.toInt(), 0x2A102030)) {
+            val sampler = BicubicSampler(PixelBuffer.filled(12, 12, colour))
+            repeat(500) {
+                // Two texels in from every edge, so the whole 4 x 4 footprint is image.
+                val x = 2f + random.nextFloat() * 8f
+                val y = 2f + random.nextFloat() * 8f
+                assertEquals("at $x,$y", colour, sampler.sample(x, y))
+            }
+        }
+    }
+
+    @Test fun aLinearRampIsReproducedExactly() {
+        // Catmull-Rom interpolates straight lines exactly, which checks the weights add up and sit at the right taps.
+        val width = 16
+        val buffer = PixelBuffer(width, 6, IntArray(width * 6) { 0xFF000000.toInt() or ((it % width) * 10 * 0x010101) })
+        val sampler = BicubicSampler(buffer)
+        val random = Random(9)
+        repeat(300) {
+            val x = 2f + random.nextFloat() * 11f
+            val expected = ((x - 0.5f) * 10f).let { Math.round(it) }
+            val got = channels(sampler.sample(x, 3f))
+            assertEquals("alpha at $x", 255, got[0])
+            for (c in 1..3) assertTrue("channel $c at $x: expected $expected got ${got[c]}", abs(got[c] - expected) <= 1)
+        }
+    }
+
+    @Test fun aHardEdgeRingsButNeverLeavesTheColourRange() {
+        // Black beside white: the negative lobes would overshoot past 0 and 255 and wrap around if they were not clamped.
+        val buffer = PixelBuffer(10, 8, IntArray(80) { if (it % 10 < 5) 0xFF000000.toInt() else 0xFFFFFFFF.toInt() })
+        val sampler = BicubicSampler(buffer)
+        var sawBlack = false
+        var sawWhite = false
+        var x = 2.5f
+        while (x < 7.5f) {
+            val got = channels(sampler.sample(x, 4f))
+            assertEquals(255, got[0])
+            for (c in 1..3) assertTrue("channel ${got[c]} at $x", got[c] in 0..255)
+            if (x < 4.4f) sawBlack = sawBlack || got[1] == 0
+            if (x > 5.6f) sawWhite = sawWhite || got[1] == 255
+            x += 0.037f
+        }
+        assertTrue("the clamped undershoot lands exactly on black", sawBlack)
+        assertTrue("the clamped overshoot lands exactly on white", sawWhite)
+    }
+
+    @Test fun softEdgesKeepTheColourOfTheirNeighbours() {
+        // Premultiplied weights: a red block on transparency fades out as red, not as a dark fringe.
+        val buffer = PixelBuffer(10, 10)
+        for (y in 3 until 7) for (x in 3 until 7) buffer.pixels[y * 10 + x] = red
+        val sampler = BicubicSampler(buffer)
+        var x = 1.2f
+        while (x < 8.8f) {
+            val got = sampler.sample(x, 5f)
+            if ((got ushr 24) != 0) assertEquals("at $x", 0xFF0000, got and 0xFFFFFF)
+            x += 0.05f
+        }
+    }
+
+    @Test fun samplesFarOutsideAreTransparentAndNonFiniteOnesAreRejected() {
+        val sampler = BicubicSampler(PixelBuffer.filled(4, 4, red))
+        assertEquals(0, sampler.sample(-3f, 2f))
+        assertEquals(0, sampler.sample(2f, 9f))
+        assertTrue(runCatching { sampler.sample(Float.NaN, 1f) }.isFailure)
+    }
+
+    @Test fun anIdentityRenderIsExactForEveryInterpolation() {
+        val random = Random(77)
+        val source = PixelBuffer(12, 12)
+        for (y in 3 until 9) for (x in 2 until 10) source.pixels[y * 12 + x] = (random.nextInt(1, 256) shl 24) or (random.nextInt() and 0xFFFFFF)
+        val bounds = LayerTransform.floatingBounds(source, null)!!
+        for (interpolation in Interpolation.entries) {
+            val out = PixelBuffer(12, 12)
+            TransformQuad.render(source, out, bounds, Quad.fromBounds(bounds), null, interpolation)
+            assertArrayEquals(interpolation.name, source.pixels, out.pixels)
+        }
+    }
+
+    @Test fun aQuarterTurnIsExactWithBicubic() {
+        val random = Random(3)
+        val source = PixelBuffer(11, 11)
+        for (y in 3 until 8) for (x in 3 until 8) source.pixels[y * 11 + x] = 0xFF000000.toInt() or (random.nextInt() and 0xFFFFFF)
+        val bounds = LayerTransform.floatingBounds(source, null)!!
+        val out = PixelBuffer(11, 11)
+        TransformQuad.render(source, out, bounds, TransformQuad.rotate(Quad.fromBounds(bounds), 90f), null, Interpolation.BICUBIC)
+        val expected = PixelBuffer(11, 11)
+        expected.drawInto(source.crop(bounds).rotated(90), 3, 3)
+        assertArrayEquals(expected.pixels, out.pixels)
+    }
+
+    @Test fun anUnbentMeshIsExactWithBicubicToo() {
+        val random = Random(12)
+        val source = PixelBuffer(16, 16)
+        for (y in 4 until 12) for (x in 5 until 13) source.pixels[y * 16 + x] = 0xFF000000.toInt() or (random.nextInt() and 0xFFFFFF)
+        val bounds = LayerTransform.floatingBounds(source, null)!!
+        val out = PixelBuffer(16, 16)
+        WarpMesh.render(source, out, bounds, WarpMesh.fromBounds(bounds), null, Interpolation.BICUBIC)
+        assertArrayEquals(source.pixels, out.pixels)
+    }
+
+    @Test fun theTwoWayChoiceStillMapsToNearestAndBilinear() {
+        assertEquals(Interpolation.BILINEAR, Interpolation.of(true))
+        assertEquals(Interpolation.NEAREST, Interpolation.of(false))
+    }
+
+    @Test fun aSplitLayerKeepsWhatIsNotSelectedAndFloatsWhatIs() {
+        val source = PixelBuffer(4, 1, intArrayOf(red, red, red, red))
+        val mask = SelectionMask(4, 1).also {
+            it.coverage[1] = 255.toByte()
+            it.coverage[2] = 128.toByte()
+        }
+        val split = TransformSource.of(source, mask)
+        assertTrue(split.blends)
+        val target = PixelBuffer(4, 1)
+        split.begin(target)
+        assertEquals(red, target.pixels[0])
+        assertEquals(0, target.pixels[1])
+        assertEquals(Channels.scaleAlpha(red, 1f - 128 / 255f), target.pixels[2])
+        assertEquals(Channels.scaleAlpha(red, 128 / 255f), split.floating.pixels[2])
+        assertEquals(red, split.floating.pixels[1])
+        assertEquals(0, split.floating.pixels[0])
+    }
+
+    @Test fun withoutASelectionEverythingFloatsAndNothingStaysBehind() {
+        val source = PixelBuffer.filled(3, 3, red)
+        val split = TransformSource.of(source, null)
+        assertSame(source, split.floating)
+        assertTrue(!split.blends)
+        val target = PixelBuffer.filled(3, 3, 0xFF00FF00.toInt())
+        split.begin(target)
+        assertTrue(target.isEmpty())
+        // A selection of another size is ignored in the same way.
+        assertSame(source, TransformSource.of(source, SelectionMask(2, 2)).floating)
+        assertNotSame(source, TransformSource.of(source, SelectionMask(3, 3)).floating)
+    }
+
+    @Test fun aRenderFromAPreparedSourceMatchesTheOneShotRender() {
+        val source = PixelBuffer(20, 20)
+        for (y in 4 until 12) for (x in 6 until 15) source.pixels[y * 20 + x] = red
+        val mask = SelectionMask.rectangle(20, 20, 5f, 3f, 11f, 13f)
+        val bounds = LayerTransform.floatingBounds(source, mask)!!
+        val quad = TransformQuad.rotate(TransformQuad.translate(Quad.fromBounds(bounds), 3f, 2f), 25f)
+        val direct = PixelBuffer(20, 20)
+        TransformQuad.render(source, direct, bounds, quad, mask, Interpolation.BICUBIC)
+        val prepared = PixelBuffer(20, 20)
+        val split = TransformSource.of(source, mask)
+        // Rendering twice from the same split must not accumulate: the second pass starts from the remainder again.
+        TransformQuad.render(split, prepared, bounds, TransformQuad.translate(quad, 4f, 4f), Interpolation.BICUBIC)
+        TransformQuad.render(split, prepared, bounds, quad, Interpolation.BICUBIC)
+        assertArrayEquals(direct.pixels, prepared.pixels)
+    }
+}
