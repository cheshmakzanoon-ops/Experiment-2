+++ b/app/src/main/java/com/artflow/studio/core/pixels/TransformSource.kt
@@ -0,0 +1,57 @@
+package com.artflow.studio.core.pixels
+
+/**
+ * A layer split for a transform: the pixels that float and the pixels that stay behind.
+ *
+ * Splitting costs a pass over the whole layer, so a Transform session does it once and every
+ * preview and the final render start from the same two buffers. Without a selection everything
+ * floats and [floating] is the source itself, which is only ever read.
+ */
+class TransformSource private constructor(
+    val floating: PixelBuffer,
+    /** What stays in place beneath the floating pixels, or null when everything floats. */
+    private val remainder: PixelBuffer?,
+) {
+    /** True when the floating pixels must blend over [begin]'s remainder (a selection is present). */
+    val blends: Boolean get() = remainder != null
+
+    /** Puts what stays behind into [target]: the unselected pixels, or nothing when everything floats. */
+    fun begin(target: PixelBuffer) {
+        require(target.width == floating.width && target.height == floating.height) { "Buffer sizes differ" }
+        if (remainder == null) target.clear() else remainder.pixels.copyInto(target.pixels)
+    }
+
+    companion object {
+        /**
+         * Splits [source] by [selection]. A selection of another size is ignored; a present but empty selection floats
+         * nothing, so the whole layer stays behind. Soft edges split a pixel's alpha between the two parts.
+         */
+        fun of(
+            source: PixelBuffer,
+            selection: SelectionMask?,
+        ): TransformSource {
+            val mask = selection?.takeIf { it.width == source.width && it.height == source.height } ?: return TransformSource(source, null)
+            val floating = PixelBuffer(source.width, source.height)
+            val remainder = PixelBuffer(source.width, source.height)
+            for (i in source.pixels.indices) {
+                val coverage = mask.alphaAt(i)
+                val pixel = source.pixels[i]
+                when {
+                    coverage <= 0f -> {
+                        remainder.pixels[i] = pixel
+                    }
+
+                    coverage >= 1f -> {
+                        floating.pixels[i] = pixel
+                    }
+
+                    else -> {
+                        remainder.pixels[i] = Channels.scaleAlpha(pixel, 1f - coverage)
+                        floating.pixels[i] = Channels.scaleAlpha(pixel, coverage)
+                    }
+                }
+            }
+            return TransformSource(floating, remainder)
+        }
+    }
+}
