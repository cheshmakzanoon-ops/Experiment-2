@@ -0,0 +1,101 @@
+package com.artflow.studio.core.pixels
+
+import kotlin.math.floor
+import kotlin.math.roundToInt
+
+/**
+ * Catmull-Rom bicubic sampling for [PixelBuffer], the "Bicubic" interpolation of the Transform tool.
+ *
+ * It reads the 4 x 4 texels around the sample, weights colour by alpha (as [PixelBuffer.sampleBilinear]
+ * does, so invisible RGB cannot bleed into the result) and returns straight ARGB. Catmull-Rom has
+ * small negative lobes, so a hard edge rings by a few percent; the result is clamped to a valid
+ * pixel and the colour is clamped to the colour range, which keeps ringing from wrapping around.
+ * Taps outside the buffer are transparent, like the bilinear sampler.
+ *
+ * One sampler belongs to one thread: it keeps its weights and sums in fields so that sampling a
+ * whole transform allocates nothing per pixel.
+ */
+internal class BicubicSampler(
+    private val buffer: PixelBuffer,
+) {
+    private val wx = FloatArray(TAPS)
+    private val wy = FloatArray(TAPS)
+    private var alpha = 0f
+    private var red = 0f
+    private var green = 0f
+    private var blue = 0f
+
+    fun sample(
+        xf: Float,
+        yf: Float,
+    ): Int {
+        require(xf.isFinite() && yf.isFinite()) { "Sampling coordinates must be finite" }
+        // The 4 x 4 footprint reaches two texels further than the bilinear one.
+        if (xf <= -OUTSIDE || xf >= buffer.width + OUTSIDE || yf <= -OUTSIDE || yf >= buffer.height + OUTSIDE) return 0
+        var x0 = floor(xf - 0.5f).toInt()
+        var y0 = floor(yf - 0.5f).toInt()
+        var fx = xf - 0.5f - x0
+        var fy = yf - 0.5f - y0
+        // A fraction this close to a texel centre is the texel itself: a 90 degree turn or an identity stays bit exact.
+        if (fx > 1f - SNAP) x0++
+        if (fy > 1f - SNAP) y0++
+        if (fx < SNAP || fx > 1f - SNAP) fx = 0f
+        if (fy < SNAP || fy > 1f - SNAP) fy = 0f
+        if (fx == 0f && fy == 0f) return buffer.getSafe(x0, y0)
+        weights(fx, wx)
+        weights(fy, wy)
+        alpha = 0f
+        red = 0f
+        green = 0f
+        blue = 0f
+        val inside = x0 >= 1 && y0 >= 1 && x0 + 2 < buffer.width && y0 + 2 < buffer.height
+        for (j in 0 until TAPS) {
+            if (wy[j] != 0f) addRow(x0 - 1, y0 - 1 + j, wy[j], inside)
+        }
+        return pack()
+    }
+
+    private fun addRow(
+        left: Int,
+        y: Int,
+        rowWeight: Float,
+        inside: Boolean,
+    ) {
+        for (i in 0 until TAPS) {
+            val pixel = if (inside) buffer.pixels[y * buffer.width + left + i] else buffer.getSafe(left + i, y)
+            val a = pixel ushr 24
+            if (a != 0 && wx[i] != 0f) {
+                val w = wx[i] * rowWeight * a
+                alpha += w
+                red += w * ((pixel ushr 16) and 0xFF)
+                green += w * ((pixel ushr 8) and 0xFF)
+                blue += w * (pixel and 0xFF)
+            }
+        }
+    }
+
+    private fun pack(): Int {
+        val outAlpha = alpha.coerceIn(0f, 255f).roundToInt()
+        if (outAlpha == 0) return 0
+        return (outAlpha shl 24) or (channel(red / alpha) shl 16) or (channel(green / alpha) shl 8) or channel(blue / alpha)
+    }
+
+    private fun channel(value: Float): Int = value.coerceIn(0f, 255f).roundToInt()
+
+    /** Catmull-Rom weights of the texels at -1, 0, 1 and 2 for the fraction [t] between texels 0 and 1. */
+    private fun weights(
+        t: Float,
+        into: FloatArray,
+    ) {
+        into[0] = ((-0.5f * t + 1f) * t - 0.5f) * t
+        into[1] = (1.5f * t - 2.5f) * t * t + 1f
+        into[2] = ((-1.5f * t + 2f) * t + 0.5f) * t
+        into[3] = (0.5f * t - 0.5f) * t * t
+    }
+
+    private companion object {
+        const val TAPS = 4
+        const val OUTSIDE = 1.5f
+        const val SNAP = 1f / 1024f
+    }
+}
