@@ -0,0 +1,121 @@
+package com.artflow.studio.core.pixels
+
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.roundToInt
+
+/**
+ * Procreate's Bloom: bright areas glow. Pixels above a luminance threshold set by Transition form a light pass, blurred
+ * to Size and screened back over the image at a strength set by the amount; Burn turns the screen into an additive
+ * blow-out. The light pass is blurred on a reduced grid, so a wide bloom costs little more than a narrow one.
+ */
+internal object BloomEffect {
+    /** Light-pass threshold at Transition 0 (only near-white glows) and how far Transition 1 lowers it. */
+    private const val HIGHEST_THRESHOLD = 0.9f
+    private const val THRESHOLD_RANGE = 0.8f
+    private const val KNEE = 0.12f
+
+    /** Glow size as a fraction of the canvas's shorter side, at Size 0 and the extra at Size 1. */
+    private const val SMALLEST_GLOW = 0.004f
+    private const val GLOW_RANGE = 0.06f
+
+    /** The reduced grid keeps at least this blur radius in its own cells. */
+    private const val GRID_SIGMA = 4f
+    private const val STRENGTH = 1.6f
+    private const val BURN_GAIN = 1.5f
+
+    /** How far full Burn turns the screen into an add. */
+    private const val BURN_ADD = 0.6f
+
+    fun apply(
+        source: PixelBuffer,
+        amount: Float,
+        transition: Float,
+        size: Float,
+        burn: Float,
+        checkpoint: () -> Unit,
+    ): PixelBuffer {
+        val sigma = max(1.5f, min(source.width, source.height) * (SMALLEST_GLOW + GLOW_RANGE * size.coerceIn(0f, 1f)))
+        val factor = max(1, (sigma / GRID_SIGMA).toInt())
+        val threshold = HIGHEST_THRESHOLD - THRESHOLD_RANGE * transition.coerceIn(0f, 1f)
+        val glow = lightPass(source, factor, threshold - KNEE, threshold + KNEE, checkpoint)
+        glow.blur(sigma / factor, checkpoint)
+        val clampedBurn = burn.coerceIn(0f, 1f)
+        return composite(source, glow, factor, amount * STRENGTH * (1f + BURN_GAIN * clampedBurn), clampedBurn, checkpoint)
+    }
+
+    /** The bright part of [source] at 1/[factor] scale, each pixel weighted by how far it clears the threshold. */
+    private fun lightPass(
+        source: PixelBuffer,
+        factor: Int,
+        low: Float,
+        high: Float,
+        checkpoint: () -> Unit,
+    ): ColorPlanes {
+        val planes = ColorPlanes((source.width + factor - 1) / factor, (source.height + factor - 1) / factor)
+        val counts = FloatArray(planes.width * planes.height)
+        for (y in 0 until source.height) {
+            checkpoint()
+            val row = (y / factor) * planes.width
+            for (x in 0 until source.width) {
+                val pixel = source.pixels[y * source.width + x]
+                val t = ((Channels.luminance(pixel) - low) / (high - low)).coerceIn(0f, 1f)
+                planes.add(row + x / factor, pixel, t * t * (3f - 2f * t))
+                counts[row + x / factor] += 1f
+            }
+        }
+        planes.divide(counts)
+        return planes
+    }
+
+    private fun composite(
+        source: PixelBuffer,
+        glow: ColorPlanes,
+        factor: Int,
+        gain: Float,
+        burn: Float,
+        checkpoint: () -> Unit,
+    ): PixelBuffer {
+        val out = source.copy()
+        val light = FloatArray(4)
+        for (y in 0 until source.height) {
+            checkpoint()
+            for (x in 0 until source.width) {
+                glow.sample((x + 0.5f) / factor, (y + 0.5f) / factor, light)
+                if (light[3] * gain < 1f / 512f) continue
+                val index = y * source.width + x
+                out.pixels[index] = screen(source.pixels[index], light, gain, burn)
+            }
+        }
+        return out
+    }
+
+    /** [base] with the premultiplied [light] screened over it (added, as [burn] rises), in premultiplied space. */
+    private fun screen(
+        base: Int,
+        light: FloatArray,
+        gain: Float,
+        burn: Float,
+    ): Int {
+        val baseAlpha = (base ushr 24) / 255f
+        val glowAlpha = min(1f, light[3] * gain)
+        val alpha = baseAlpha + glowAlpha - baseAlpha * glowAlpha
+        val keep = 1f - BURN_ADD * burn
+        val r = channel((base shr 16) and 0xFF, baseAlpha, min(1f, light[0] * gain), keep, alpha)
+        val g = channel((base shr 8) and 0xFF, baseAlpha, min(1f, light[1] * gain), keep, alpha)
+        val b = channel(base and 0xFF, baseAlpha, min(1f, light[2] * gain), keep, alpha)
+        return Channels.argb((alpha * 255f).roundToInt().coerceIn(0, 255), r, g, b)
+    }
+
+    private fun channel(
+        value: Int,
+        baseAlpha: Float,
+        glow: Float,
+        keep: Float,
+        alpha: Float,
+    ): Int {
+        val base = value / 255f * baseAlpha
+        val mixed = min(alpha, base + glow - keep * base * glow)
+        return (mixed / alpha * 255f).roundToInt().coerceIn(0, 255)
+    }
+}
