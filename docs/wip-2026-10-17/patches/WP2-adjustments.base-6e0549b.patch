@@ -0,0 +1,135 @@
+package com.artflow.studio.core.pixels
+
+import com.artflow.studio.core.tool.GradientTool
+import com.artflow.studio.core.tool.GradientTool.Gradient
+import com.artflow.studio.core.tool.GradientTool.Stop
+import kotlin.math.abs
+import kotlin.math.roundToInt
+
+/**
+ * Procreate's Gradient Map: every pixel takes the colour a gradient has at the pixel's luminance, dark pixels from the
+ * left end and light pixels from the right, and keeps its own alpha.
+ *
+ * An adjustment's parameter map stores the gradient as `gradient_stops` (the stop count, 2..16) and, for each stop i
+ * below the count, `gradient_<i>_position` (0..1) and `gradient_<i>_rgb` (its opaque colour as 0xRRGGBB, which a Float
+ * holds exactly). Keys at or past the count are ignored, so deleting a stop only lowers the count. A map without
+ * `gradient_stops` is the original two-hue map (`gradient_start_hue`, `gradient_end_hue`) and renders as it always did.
+ */
+object GradientMap {
+    const val STOPS = "gradient_stops"
+    const val LEGACY_START_HUE = "gradient_start_hue"
+    const val LEGACY_END_HUE = "gradient_end_hue"
+    const val MAX_STOPS = GradientTool.MAX_STOPS
+    private const val MIN_STOPS = 2
+    private const val RGB_MAX = 0xFFFFFF.toFloat()
+
+    /** Entries in the colour table over luminance: finer than 8 bits so smooth ramps do not band. */
+    const val TABLE_SIZE = 1024
+
+    fun positionKey(index: Int): String = "gradient_${index}_position"
+
+    fun colorKey(index: Int): String = "gradient_${index}_rgb"
+
+    /** The built-in gradients, darkest stop first. Their names are stable identifiers the interface translates. */
+    val LIBRARY: List<Gradient> =
+        listOf(
+            gradient("Noir", 0f to 0x000000, 1f to 0xFFFFFF),
+            gradient("Sepia", 0f to 0x1E120A, 0.45f to 0x7D5A3C, 0.8f to 0xCDB08A, 1f to 0xF6ECD6),
+            gradient("Midnight", 0f to 0x050A1F, 0.5f to 0x2A4A8C, 1f to 0xD6E6FF),
+            gradient("Rose Duotone", 0f to 0x2B0F3A, 1f to 0xFFB7C9),
+            gradient("Teal Duotone", 0f to 0x0B2027, 1f to 0x9EF0E0),
+            gradient("Sunset", 0f to 0x1B0A33, 0.35f to 0xB5297A, 0.7f to 0xF26B38, 1f to 0xFFE08A),
+            gradient(
+                "Thermal",
+                0f to 0x000000,
+                0.25f to 0x2A12A8,
+                0.5f to 0xC2187A,
+                0.75f to 0xFF7A00,
+                0.92f to 0xFFE14D,
+                1f to 0xFFFFFF,
+            ),
+            gradient("Cool", 0f to 0x08162B, 0.5f to 0x2E8B9A, 1f to 0xE8F7FF),
+            gradient("Warm", 0f to 0x2A0E0A, 0.5f to 0xD9822B, 1f to 0xFFF1D6),
+            gradient("Neon", 0f to 0x14002B, 0.5f to 0xFF2E97, 1f to 0x3CF5FF),
+            gradient("Ocean", 0f to 0x02111B, 0.35f to 0x0B3954, 0.7f to 0x087E8B, 1f to 0xBFD7EA),
+            gradient("Forest", 0f to 0x0B1A0E, 0.4f to 0x2F5D34, 0.75f to 0x9BBF6A, 1f to 0xF0F5D8),
+            gradient("Golden Hour", 0f to 0x1E0F1C, 0.35f to 0x7A2E3A, 0.7f to 0xE08A3C, 1f to 0xFFE7A8),
+            gradient("Cyanotype", 0f to 0x062A4D, 0.55f to 0x2F6F9F, 1f to 0xEAF4F8),
+            gradient("Synthwave", 0f to 0x2B1055, 0.45f to 0xD53A9D, 0.75f to 0xFFB86C, 1f to 0xF9F871),
+            gradient("Vintage", 0f to 0x2E2A24, 0.4f to 0x8C7A5B, 0.75f to 0xD8C7A0, 1f to 0xF4EDE0),
+        )
+
+    /** A new Gradient Map starts as Noir, which has the same numbers in every colour profile. */
+    val DEFAULT_PARAMETERS: Map<String, Float> = encode(LIBRARY.first())
+
+    /** Every key a Gradient Map map may hold, the original two hues included. */
+    val PARAMETER_RANGES: Map<String, ClosedFloatingPointRange<Float>> =
+        buildMap {
+            put(LEGACY_START_HUE, 0f..360f)
+            put(LEGACY_END_HUE, 0f..360f)
+            put(STOPS, MIN_STOPS.toFloat()..MAX_STOPS.toFloat())
+            for (index in 0 until MAX_STOPS) {
+                put(positionKey(index), 0f..1f)
+                put(colorKey(index), 0f..RGB_MAX)
+            }
+        }
+
+    /** Parameter entries for [gradient]; stop colours lose their alpha, as a gradient map's colours are opaque. */
+    fun encode(gradient: Gradient): Map<String, Float> {
+        val stops = gradient.sortedStops
+        val entries = LinkedHashMap<String, Float>()
+        entries[STOPS] = stops.size.toFloat()
+        stops.forEachIndexed { index, stop ->
+            entries[positionKey(index)] = stop.position.coerceIn(0f, 1f)
+            entries[colorKey(index)] = (stop.color and 0xFFFFFF).toFloat()
+        }
+        return entries
+    }
+
+    /** The gradient stored in [parameters], or null when they hold the original two-hue map. */
+    fun decode(parameters: Map<String, Float>): Gradient? {
+        val count = parameters[STOPS]?.takeIf { it.isFinite() }?.roundToInt() ?: return null
+        if (count !in MIN_STOPS..MAX_STOPS) return null
+        val stops = ArrayList<Stop>(count)
+        for (index in 0 until count) {
+            val position = parameters[positionKey(index)]?.takeIf { it.isFinite() }
+            val rgb = parameters[colorKey(index)]?.takeIf { it.isFinite() }
+            if (position == null || rgb == null) return null
+            stops += Stop(position.coerceIn(0f, 1f), ALPHA or rgb.coerceIn(0f, RGB_MAX).roundToInt())
+        }
+        return Gradient("", GradientTool.GradientType.LINEAR, stops.sortedBy { it.position })
+    }
+
+    /** Colours (opaque ARGB) of [gradient] at [TABLE_SIZE] even steps from its dark end to its light end. */
+    fun table(gradient: Gradient): IntArray {
+        val sorted = Gradient(gradient.name, gradient.type, gradient.sortedStops)
+        return IntArray(TABLE_SIZE) { ALPHA or sorted.colorAt(it / (TABLE_SIZE - 1f)) }
+    }
+
+    /** [pixel] recoloured from [table] by its luminance, keeping its alpha. */
+    fun map(
+        pixel: Int,
+        table: IntArray,
+    ): Int {
+        val index = (Channels.luminance(pixel) * (TABLE_SIZE - 1)).roundToInt().coerceIn(0, TABLE_SIZE - 1)
+        return (pixel and ALPHA) or (table[index] and 0xFFFFFF)
+    }
+
+    /** True when [gradient] has the same stops as [other], ignoring names. */
+    fun sameStops(
+        gradient: Gradient,
+        other: Gradient,
+    ): Boolean {
+        val a = gradient.sortedStops
+        val b = other.sortedStops
+        return a.size == b.size &&
+            a.indices.all { (a[it].color and 0xFFFFFF) == (b[it].color and 0xFFFFFF) && abs(a[it].position - b[it].position) < 1e-4f }
+    }
+
+    private fun gradient(
+        name: String,
+        vararg stops: Pair<Float, Int>,
+    ): Gradient = Gradient(name, GradientTool.GradientType.LINEAR, stops.map { (position, rgb) -> Stop(position, ALPHA or rgb) })
+
+    private const val ALPHA = 0xFF000000.toInt()
+}
diff --git a/app/src/main/java/com/artflow/studio/core/pixels/HalftoneEffect.kt b/app/src/main/java/com/artflow/studio/core/pixels/HalftoneEffect.kt
