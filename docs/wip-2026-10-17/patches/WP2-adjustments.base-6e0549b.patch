--- /dev/null
+++ b/app/src/main/java/com/artflow/studio/core/pixels/HalftoneEffect.kt
@@ -0,0 +1,271 @@
+package com.artflow.studio.core.pixels
+
+import com.artflow.studio.core.pixels.AdjustmentOptions.HalftoneMode
+import kotlin.math.PI
+import kotlin.math.acos
+import kotlin.math.cos
+import kotlin.math.floor
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.roundToInt
+import kotlin.math.sin
+import kotlin.math.sqrt
+
+/**
+ * Procreate's Halftone. Full Colour prints cyan, magenta, yellow and black dot screens at their classic angles (15, 75,
+ * 0 and 45 degrees); Screen Print prints one 45-degree screen whose dots are each spot's own ink colour; Newspaper prints
+ * black dots at 45 degrees. A dot covers as much of its cell as the ink it stands for, its edge is anti-aliased (Sharpness
+ * sets how soft), and the layer keeps its alpha. The amount sets the dot size.
+ */
+internal object HalftoneEffect {
+    /** Dot spacing as a fraction of the canvas's shorter side at amount 0, and the extra at amount 1. */
+    private const val SMALLEST_CELL = 0.006f
+    private const val CELL_RANGE = 0.04f
+
+    /** Edge softness in pixels at full Sharpness, and as a fraction of the cell at none. */
+    private const val CRISP_EDGE = 0.6f
+    private const val SOFT_EDGE = 0.45f
+
+    private val SQRT_HALF = sqrt(0.5f)
+
+    /** Dot radius (in cells) whose share of its cell is i / 255. */
+    private val RADII = FloatArray(256) { radiusFor(it / 255f) }
+
+    fun apply(
+        source: PixelBuffer,
+        amount: Float,
+        mode: HalftoneMode,
+        sharpness: Float,
+        checkpoint: () -> Unit,
+    ): PixelBuffer {
+        val cell = max(3f, min(source.width, source.height) * (SMALLEST_CELL + CELL_RANGE * amount.coerceIn(0f, 1f)))
+        val softness = CRISP_EDGE + (SOFT_EDGE * cell - CRISP_EDGE) * (1f - sharpness.coerceIn(0f, 1f))
+        val factor = max(1, (cell / 2f).toInt())
+        val average = ColorPlanes.downsample(source, factor, checkpoint)
+        val screens = inksFor(mode).map { Screen(source.width, source.height, cell, it, average, factor, checkpoint) }
+        val coverage = FloatArray(screens.size)
+        val out = PixelBuffer(source.width, source.height)
+        for (y in 0 until source.height) {
+            checkpoint()
+            for (x in 0 until source.width) {
+                val index = y * source.width + x
+                val alpha = source.pixels[index] ushr 24
+                if (alpha == 0) continue
+                for (s in screens.indices) coverage[s] = screens[s].coverage(x + 0.5f, y + 0.5f, softness)
+                out.pixels[index] = print(mode, coverage, screens[0].dotColour, alpha)
+            }
+        }
+        return out
+    }
+
+    /** The ink a dot screen prints and the angle of its rows. */
+    private enum class Ink(
+        val angleDegrees: Float,
+    ) {
+        CYAN(15f),
+        MAGENTA(75f),
+        YELLOW(0f),
+        BLACK(45f),
+        SPOT(45f),
+        GREY(45f),
+        ;
+
+        /** How much of this ink a colour (straight red, green, blue in 0..1) needs, with black replacing the shared grey. */
+        fun amount(
+            r: Float,
+            g: Float,
+            b: Float,
+        ): Float {
+            val brightest = max(r, max(g, b))
+            return when (this) {
+                CYAN -> brightest - r
+                MAGENTA -> brightest - g
+                YELLOW -> brightest - b
+                BLACK -> 1f - brightest
+                SPOT -> 1f - min(r, min(g, b))
+                GREY -> 1f - (0.2126f * r + 0.7152f * g + 0.0722f * b)
+            }
+        }
+    }
+
+    private fun inksFor(mode: HalftoneMode): List<Ink> =
+        when (mode) {
+            HalftoneMode.FULL_COLOUR -> listOf(Ink.CYAN, Ink.MAGENTA, Ink.YELLOW, Ink.BLACK)
+            HalftoneMode.SCREEN_PRINT -> listOf(Ink.SPOT)
+            HalftoneMode.NEWSPAPER -> listOf(Ink.GREY)
+        }
+
+    /** The printed colour of one pixel from its screens' dot coverage, over white paper. */
+    private fun print(
+        mode: HalftoneMode,
+        coverage: FloatArray,
+        spot: Int,
+        alpha: Int,
+    ): Int =
+        when (mode) {
+            HalftoneMode.FULL_COLOUR -> {
+                val paper = 1f - coverage[3]
+                rgb(alpha, (1f - coverage[0]) * paper, (1f - coverage[1]) * paper, (1f - coverage[2]) * paper)
+            }
+            HalftoneMode.NEWSPAPER -> {
+                val paper = 1f - coverage[0]
+                rgb(alpha, paper, paper, paper)
+            }
+            HalftoneMode.SCREEN_PRINT -> {
+                val ink = coverage[0]
+                rgb(
+                    alpha,
+                    1f - ink * (1f - ((spot shr 16) and 0xFF) / 255f),
+                    1f - ink * (1f - ((spot shr 8) and 0xFF) / 255f),
+                    1f - ink * (1f - (spot and 0xFF) / 255f),
+                )
+            }
+        }
+
+    private fun rgb(
+        alpha: Int,
+        r: Float,
+        g: Float,
+        b: Float,
+    ): Int = Channels.argb(alpha, (r * 255f).roundToInt(), (g * 255f).roundToInt(), (b * 255f).roundToInt())
+
+    /** Share of a unit cell covered by a centred dot of radius [r] (dots of neighbouring cells meet past 0.5). */
+    private fun area(r: Float): Float =
+        when {
+            r <= 0.5f -> PI.toFloat() * r * r
+            r >= SQRT_HALF -> 1f
+            else -> PI.toFloat() * r * r - 4f * (r * r * acos(0.5f / r) - 0.5f * sqrt(r * r - 0.25f))
+        }
+
+    private fun radiusFor(share: Float): Float {
+        var low = 0f
+        var high = SQRT_HALF
+        repeat(32) {
+            val middle = (low + high) / 2f
+            if (area(middle) < share) low = middle else high = middle
+        }
+        return (low + high) / 2f
+    }
+
+    /** Dot radius, in cells, for [ink] (0..1). */
+    private fun radius(ink: Float): Float = RADII[(ink.coerceIn(0f, 1f) * 255f).roundToInt()]
+
+    /**
+     * One rotated dot screen over the canvas. Each cell's dot size (and, for spot colour, its colour) is worked out once
+     * from the layer's average colour at the cell's centre; a pixel then takes the strongest of its four nearest dots.
+     */
+    private class Screen(
+        width: Int,
+        height: Int,
+        private val cell: Float,
+        ink: Ink,
+        average: ColorPlanes,
+        factor: Int,
+        checkpoint: () -> Unit,
+    ) {
+        private val cos = cos(Math.toRadians(ink.angleDegrees.toDouble())).toFloat()
+        private val sin = sin(Math.toRadians(ink.angleDegrees.toDouble())).toFloat()
+        private val firstColumn: Int
+        private val firstRow: Int
+        private val columns: Int
+        private val rows: Int
+        private val radii: FloatArray
+        private val colours: IntArray?
+
+        /** The colour of the dot that won the last [coverage] call; spot screens only. */
+        var dotColour = 0
+            private set
+
+        init {
+            val us = floatArrayOf(0f, width * cos, height * sin, width * cos + height * sin)
+            val vs = floatArrayOf(0f, -width * sin, height * cos, -width * sin + height * cos)
+            firstColumn = floor(us.min() / cell).toInt() - 1
+            firstRow = floor(vs.min() / cell).toInt() - 1
+            columns = floor(us.max() / cell).toInt() + 2 - firstColumn
+            rows = floor(vs.max() / cell).toInt() + 2 - firstRow
+            radii = FloatArray(columns * rows)
+            colours = if (ink == Ink.SPOT) IntArray(columns * rows) else null
+            val sample = FloatArray(4)
+            for (row in 0 until rows) {
+                checkpoint()
+                for (column in 0 until columns) {
+                    val u = (firstColumn + column + 0.5f) * cell
+                    val v = (firstRow + row + 0.5f) * cell
+                    average.sample((u * cos - v * sin) / factor, (u * sin + v * cos) / factor, sample)
+                    measure(row * columns + column, ink, sample)
+                }
+            }
+        }
+
+        private fun measure(
+            index: Int,
+            ink: Ink,
+            sample: FloatArray,
+        ) {
+            val alpha = sample[3]
+            if (alpha <= 1f / 255f) return
+            val r = (sample[0] / alpha).coerceIn(0f, 1f)
+            val g = (sample[1] / alpha).coerceIn(0f, 1f)
+            val b = (sample[2] / alpha).coerceIn(0f, 1f)
+            val amount = ink.amount(r, g, b)
+            radii[index] = cell * radius(amount)
+            colours?.set(index, spotColour(r, g, b, amount))
+        }
+
+        /** The ink colour whose dots, covering [amount] of white paper, average to ([r], [g], [b]). */
+        private fun spotColour(
+            r: Float,
+            g: Float,
+            b: Float,
+            amount: Float,
+        ): Int {
+            if (amount <= 1e-3f) return 0xFFFFFF
+
+            fun channel(value: Float): Int = ((1f - (1f - value) / amount).coerceIn(0f, 1f) * 255f).roundToInt()
+            return (channel(r) shl 16) or (channel(g) shl 8) or channel(b)
+        }
+
+        /** How much of the pixel centred at ([x], [y]) the screen's dots cover, 0..1. */
+        fun coverage(
+            x: Float,
+            y: Float,
+            softness: Float,
+        ): Float {
+            val u = (x * cos + y * sin) / cell - firstColumn
+            val v = (-x * sin + y * cos) / cell - firstRow
+            val column = floor(u).toInt()
+            val row = floor(v).toInt()
+            val du = u - column - 0.5f
+            val dv = v - row - 0.5f
+            val stepU = if (du >= 0f) 1 else -1
+            val stepV = if (dv >= 0f) 1 else -1
+            var best = 0f
+            var winner = -1
+            for (k in 0 until 4) {
+                val c = column + (k and 1) * stepU
+                val r = row + (k shr 1) * stepV
+                val index = if (c in 0 until columns && r in 0 until rows) r * columns + c else -1
+                val dot = if (index < 0) 0f else dot(radii[index], du - (k and 1) * stepU, dv - (k shr 1) * stepV, softness)
+                if (dot > best) {
+                    best = dot
+                    winner = index
+                }
+            }
+            if (colours != null && winner >= 0) dotColour = colours[winner]
+            return best
+        }
+
+        /** Coverage of a dot of [radius] pixels at offset ([du], [dv]) cells, faded out while it is smaller than its edge. */
+        private fun dot(
+            radius: Float,
+            du: Float,
+            dv: Float,
+            softness: Float,
+        ): Float {
+            if (radius <= 0f) return 0f
+            val distance = sqrt(du * du + dv * dv) * cell
+            val edge = ((radius - distance) / softness + 0.5f).coerceIn(0f, 1f)
+            return edge * min(1f, 2f * radius / softness)
+        }
+    }
+}
