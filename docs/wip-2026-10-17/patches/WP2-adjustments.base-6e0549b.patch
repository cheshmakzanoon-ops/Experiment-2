+++ b/app/src/main/java/com/artflow/studio/core/pixels/GlitchEffect.kt
@@ -0,0 +1,165 @@
+package com.artflow.studio.core.pixels
+
+import com.artflow.studio.core.pixels.AdjustmentOptions.GlitchMode
+import com.artflow.studio.core.pixels.PixelHash.hash
+import com.artflow.studio.core.pixels.PixelHash.unit
+import kotlin.math.PI
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.roundToInt
+import kotlin.math.sin
+
+/**
+ * Procreate-style Glitch in five modes. Every random choice comes from a hash of its position and the seed, so the same
+ * settings always give the same pixels and a preview does not flicker between slider moves. Pixels wrap around the
+ * canvas edges, and the colour channels keep their own coverage when they separate.
+ */
+internal object GlitchEffect {
+    fun apply(
+        source: PixelBuffer,
+        amount: Float,
+        mode: GlitchMode,
+        size: Float,
+        seed: Int,
+        checkpoint: () -> Unit,
+    ): PixelBuffer {
+        val glitch = Glitch(source, amount.coerceIn(0f, 1f), size.coerceIn(0f, 1f), seed)
+        for (y in 0 until source.height) {
+            checkpoint()
+            when (mode) {
+                GlitchMode.ARTIFACT -> glitch.artifactRow(y)
+                GlitchMode.WAVE -> glitch.waveRow(y)
+                GlitchMode.SIGNAL -> glitch.signalRow(y)
+                GlitchMode.DIVERGE -> glitch.divergeRow(y)
+                GlitchMode.DISPLACE -> glitch.displaceRow(y)
+            }
+        }
+        return glitch.out
+    }
+
+    private class Glitch(
+        val source: PixelBuffer,
+        val amount: Float,
+        val size: Float,
+        val seed: Int,
+    ) {
+        val out = PixelBuffer(source.width, source.height)
+        private val width = source.width
+        private val height = source.height
+        private val shortSide = min(width, height).toFloat()
+
+        /** Artifact: runs of blocks jump to other places, smear, split their channels or turn coarse, like a broken JPEG. */
+        fun artifactRow(y: Int) {
+            val block = max(4, (shortSide * (0.012f + 0.07f * size)).roundToInt())
+            val blockY = y / block
+            val run = 1 + hash(blockY, seed, 11) % 4
+            for (x in 0 until width) {
+                val h = hash(x / block / run, blockY, seed)
+                out.pixels[y * width + x] =
+                    if (unit(h) >= amount * 0.6f) {
+                        source.pixels[y * width + x]
+                    } else {
+                        corruptPixel(x, y, block, h)
+                    }
+            }
+        }
+
+        private fun corruptPixel(
+            x: Int,
+            y: Int,
+            block: Int,
+            h: Int,
+        ): Int =
+            when ((h ushr 8) and 3) {
+                0 -> at(x + ((h ushr 10) % 9 - 4) * block, y + ((h ushr 14) % 3 - 1) * block)
+                1 -> at((x / block) * block, y)
+                2 -> split(x + block / 3, x, x - block / 3, y)
+                else -> {
+                    val coarse = max(2, block / 4)
+                    at((x / coarse) * coarse, (y / coarse) * coarse)
+                }
+            }
+
+        /** Wave: rows sway sideways along a wavy line, each colour channel a little out of step. */
+        fun waveRow(y: Int) {
+            val wavelength = shortSide * (0.03f + 0.4f * size)
+            val amplitude = amount * shortSide * 0.05f
+            val phase = unit(hash(seed, 3, 5)) * 2f * PI.toFloat()
+            val angle = 2f * PI.toFloat() * y / wavelength + phase
+            val sway = sin(angle) + 0.35f * sin(angle * 2.7f + phase)
+            val green = (amplitude * sway).roundToInt()
+            val red = (amplitude * sin(angle + 0.45f) * 1.1f).roundToInt()
+            val blue = (amplitude * sin(angle - 0.45f) * 0.9f).roundToInt()
+            for (x in 0 until width) out.pixels[y * width + x] = split(x - red, x - green, x - blue, y)
+        }
+
+        /** Signal: a bad video signal, with split channels, jittering bands, dark scan lines and bright noise rows. */
+        fun signalRow(y: Int) {
+            val spacing = max(2, (shortSide * (0.003f + 0.02f * size)).roundToInt())
+            val band = y / (spacing * 6)
+            val jumps = unit(hash(band, seed, 17)) < amount * 0.35f
+            val jitter = if (jumps) ((unit(hash(band, seed, 19)) - 0.5f) * amount * shortSide * 0.06f).roundToInt() else 0
+            val offset = (amount * shortSide * 0.01f).roundToInt()
+            val dim = if ((y / spacing) % 2 == 1) 1f - 0.4f * amount else 1f
+            val flare = if (unit(hash(y, seed, 23)) < amount * 0.015f) 90f * amount else 0f
+            for (x in 0 until width) {
+                val pixel = split(x + jitter + offset, x + jitter, x + jitter - offset, y)
+                out.pixels[y * width + x] = shade(pixel, dim, flare)
+            }
+        }
+
+        /** Diverge: red and blue pull apart sideways by a different distance in every band. */
+        fun divergeRow(y: Int) {
+            val band = max(2, (shortSide * (0.01f + 0.12f * size)).roundToInt())
+            val spread = (amount * shortSide * 0.04f * (0.3f + 0.7f * unit(hash(y / band, seed, 29)))).roundToInt()
+            for (x in 0 until width) out.pixels[y * width + x] = split(x + spread, x, x - spread, y)
+        }
+
+        /** Displace: thin bands of rows slip sideways and the red channel lags behind. */
+        fun displaceRow(y: Int) {
+            val bandHeight = max(2, (shortSide * (0.004f + 0.04f * size)).roundToInt())
+            val band = y / bandHeight
+            val reach = (width * 0.08f * amount).roundToInt()
+            val shift = if (hash(band, seed, 31) % 3 == 0) hash(band, seed, 37) % (2 * reach + 1) - reach else 0
+            val lag = max(1, (amount * shortSide * 0.006f).roundToInt())
+            for (x in 0 until width) out.pixels[y * width + x] = split(x - shift + lag, x - shift, x - shift, y)
+        }
+
+        private fun at(
+            x: Int,
+            y: Int,
+        ): Int = source.pixels[wrap(y, height) * width + wrap(x, width)]
+
+        /** A pixel whose red, green and blue come from different columns of row [y]; see [ChromaticAberration.combine]. */
+        private fun split(
+            redX: Int,
+            greenX: Int,
+            blueX: Int,
+            y: Int,
+        ): Int {
+            val row = wrap(y, height) * width
+            return ChromaticAberration.combine(
+                source.pixels[row + wrap(redX, width)],
+                source.pixels[row + wrap(greenX, width)],
+                source.pixels[row + wrap(blueX, width)],
+            )
+        }
+
+        private fun shade(
+            pixel: Int,
+            dim: Float,
+            flare: Float,
+        ): Int =
+            Channels.argb(
+                pixel ushr 24,
+                (((pixel shr 16) and 0xFF) * dim + flare).roundToInt().coerceIn(0, 255),
+                (((pixel shr 8) and 0xFF) * dim + flare).roundToInt().coerceIn(0, 255),
+                ((pixel and 0xFF) * dim + flare).roundToInt().coerceIn(0, 255),
+            )
+    }
+
+    private fun wrap(
+        value: Int,
+        size: Int,
+    ): Int = ((value % size) + size) % size
+}
