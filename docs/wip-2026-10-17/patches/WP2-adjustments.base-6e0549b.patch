+
+class ColorBalanceTest {
+    private fun balance(
+        pixel: Int,
+        parameters: Map<String, Float>,
+    ): Int = AdjustmentProcessor.apply(PixelBuffer.filled(1, 1, pixel), AdjustmentType.COLOR_BALANCE, parameters).pixels[0]
+
+    private fun red(pixel: Int) = (pixel shr 16) and 0xFF
+
+    private fun grey(level: Int) = Channels.argb(255, level, level, level)
+
+    @Test
+    fun allZeroChangesNothing() {
+        val image = LegacyAdjustmentMaths.sampleImage()
+        val out = AdjustmentProcessor.apply(image, AdjustmentType.COLOR_BALANCE, AdjustmentType.COLOR_BALANCE.defaultParameters)
+        assertArrayEquals(image.pixels, out.pixels)
+    }
+
+    @Test
+    fun theRangeWeightsAddUpToOneAndPeakWhereTheyShould() {
+        for (step in 0..100) {
+            val l = step / 100f
+            val sum = ColorBalance.shadowWeight(l) + ColorBalance.midtoneWeight(l) + ColorBalance.highlightWeight(l)
+            assertEquals(1f, sum, 1e-5f)
+        }
+        assertEquals(1f, ColorBalance.shadowWeight(0f), 0f)
+        assertEquals(1f, ColorBalance.midtoneWeight(0.5f), 0f)
+        assertEquals(1f, ColorBalance.highlightWeight(1f), 0f)
+    }
+
+    @Test
+    fun shadowsMoveDarkPixelsMoreThanLightOnes() {
+        val shadows = mapOf(ColorBalance.key(Range.SHADOWS, Axis.CYAN_RED) to 60f)
+        val darkGain = red(balance(grey(30), shadows)) - 30
+        val lightGain = red(balance(grey(220), shadows)) - 220
+        assertTrue("dark +$darkGain vs light +$lightGain", darkGain > 40 && lightGain == 0)
+    }
+
+    @Test
+    fun highlightsMoveLightPixelsMoreThanDarkOnes() {
+        val highlights = mapOf(ColorBalance.key(Range.HIGHLIGHTS, Axis.CYAN_RED) to -60f)
+        val darkLoss = 30 - red(balance(grey(30), highlights))
+        val lightLoss = 220 - red(balance(grey(220), highlights))
+        assertTrue("dark -$darkLoss vs light -$lightLoss", lightLoss > 40 && darkLoss == 0)
+    }
+
+    @Test
+    fun midtonesLeaveBlackAndWhiteAlone() {
+        val midtones = mapOf(ColorBalance.key(Range.MIDTONES, Axis.YELLOW_BLUE) to 100f)
+        assertEquals(grey(0), balance(grey(0), midtones))
+        assertEquals(grey(255), balance(grey(255), midtones))
+        assertTrue(balance(grey(128), midtones) and 0xFF > 200)
+    }
+
+    @Test
+    fun eachAxisMovesItsOwnChannel() {
+        val pixel = grey(128)
+        for (axis in Axis.entries) {
+            val out = balance(pixel, mapOf(ColorBalance.key(Range.MIDTONES, axis) to -50f))
+            Axis.entries.forEach { other ->
+                // Cyan-Red moves red, Magenta-Green green and Yellow-Blue blue.
+                val channel = (out shr (16 - 8 * other.ordinal)) and 0xFF
+                if (other == axis) assertTrue(channel < 100) else assertEquals(128, channel)
+            }
+        }
+    }
+
+    @Test
+    fun alphaNeverChanges() {
+        val image = LegacyAdjustmentMaths.sampleImage()
+        val parameters = Range.entries.associate { ColorBalance.key(it, Axis.MAGENTA_GREEN) to 70f } + ("yellow_blue" to -40f)
+        val out = AdjustmentProcessor.apply(image, AdjustmentType.COLOR_BALANCE, parameters)
+        for (i in image.pixels.indices) assertEquals(image.pixels[i] ushr 24, out.pixels[i] ushr 24)
+    }
+
+    @Test
+    fun theSameShiftInAllThreeRangesMovesEveryLevelAlike() {
+        val all = Range.entries.associate { ColorBalance.key(it, Axis.CYAN_RED) to 40f }
+        val shifts = (0..255 step 5).map { red(balance(grey(it).let { p -> p and 0xFF00FFFF.toInt() }, all)) }
+        // Red starts at 0 for every pixel here, so every level gets the same lift.
+        assertTrue(shifts.toString(), shifts.all { kotlin.math.abs(it - shifts[0]) <= 1 })
+    }
+
+    @Test
+    fun olderEvenShiftsRenderExactlyAsBefore() {
+        val random = Random(8)
+        val image = LegacyAdjustmentMaths.sampleImage()
+        repeat(40) {
+            val parameters =
+                listOf("cyan_red", "magenta_green", "yellow_blue")
+                    .filter { random.nextInt(4) != 0 }
+                    .associateWith { random.nextFloat() * 200f - 100f }
+            val expected = LegacyAdjustmentMaths.applyAll(image) { LegacyAdjustmentMaths.colorBalance(it, parameters) }
+            assertArrayEquals(expected, AdjustmentProcessor.apply(image, AdjustmentType.COLOR_BALANCE, parameters).pixels)
+        }
+    }
+
+    @Test
+    fun everyKeyIsInTheParameterRanges() {
+        Range.entries.forEach { range ->
+            Axis.entries.forEach { axis -> assertTrue(ColorBalance.key(range, axis) in AdjustmentType.COLOR_BALANCE.parameterRanges) }
+        }
+        Axis.entries.forEach { assertTrue(ColorBalance.legacyKey(it) in AdjustmentType.COLOR_BALANCE.parameterRanges) }
+    }
+}
diff --git a/app/src/test/java/com/artflow/studio/core/pixels/CurveSetTest.kt b/app/src/test/java/com/artflow/studio/core/pixels/CurveSetTest.kt
new file mode 100644
index 0000000..ab5a9f4
--- /dev/null
+++ b/app/src/test/java/com/artflow/studio/core/pixels/CurveSetTest.kt
@@ -0,0 +1,175 @@
+package com.artflow.studio.core.pixels
+
+import com.artflow.studio.core.pixels.CurveSet.Channel
+import com.artflow.studio.domain.model.layer.AdjustmentType
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.util.Random
+
+class CurveSetTest {
+    private fun curve(vararg points: Pair<Float, Float>) = ToneCurve(points.map { ToneCurve.Point(it.first, it.second) })
+
+    private fun identity() = IntArray(256) { it }
+
+    @Test
+    fun theDefaultsAreStraightCurvesThatChangeNothing() {
+        val decoded = CurveSet.decode(CurveSet.DEFAULT_PARAMETERS)
+        assertEquals(CurveSet.IDENTITY, decoded)
+        val image = LegacyAdjustmentMaths.sampleImage()
+        for (defaults in listOf(CurveSet.DEFAULT_PARAMETERS, AdjustmentType.CURVES.defaultParameters)) {
+            CurveSet.decode(defaults).channelLuts().forEach { assertArrayEquals(identity(), it) }
+            assertArrayEquals(image.pixels, AdjustmentProcessor.apply(image, AdjustmentType.CURVES, defaults).pixels)
+        }
+    }
+
+    @Test
+    fun anEmptyMapIsStraightToo() {
+        CurveSet.decode(emptyMap()).channelLuts().forEach { assertArrayEquals(identity(), it) }
+    }
+
+    @Test
+    fun risingPointsGiveARisingTableThroughEveryPoint() {
+        val random = Random(5)
+        repeat(200) {
+            val count = 2 + random.nextInt(ToneCurve.MAX_POINTS - 1)
+            val xs = (List(count - 2) { 1f + random.nextInt(253) } + listOf(0f, 255f)).distinct().sorted()
+            val ys = xs.map { random.nextFloat() * 255f }.sorted()
+            val lut = ToneCurve(xs.zip(ys).map { ToneCurve.Point(it.first, it.second) }).lut()
+            for (i in 1..255) assertTrue("table falls at $i", lut[i] >= lut[i - 1])
+            xs.zip(ys).forEach { (x, y) -> assertEquals(y, lut[x.toInt()].toFloat(), 0.51f) }
+        }
+    }
+
+    @Test
+    fun aChannelCurveChangesOnlyItsChannelAndGammaFollowsIt() {
+        val brighterRed = CurveSet(red = curve(0f to 0f, 128f to 200f, 255f to 255f))
+        val pixel = 0xFF808080.toInt()
+        val parameters = brighterRed.encode()
+        val out = AdjustmentProcessor.apply(PixelBuffer.filled(1, 1, pixel), AdjustmentType.CURVES, parameters).pixels[0]
+        assertEquals(200, (out shr 16) and 0xFF)
+        assertEquals(128, (out shr 8) and 0xFF)
+        assertEquals(128, out and 0xFF)
+        assertEquals(0xFF, out ushr 24)
+
+        // Gamma inverts after the red curve: red 128 -> 200 -> 55, the others 128 -> 127.
+        val inverted = brighterRed.copy(gamma = curve(0f to 255f, 255f to 0f))
+        val both = AdjustmentProcessor.apply(PixelBuffer.filled(1, 1, pixel), AdjustmentType.CURVES, inverted.encode()).pixels[0]
+        assertEquals(55, (both shr 16) and 0xFF)
+        assertEquals(127, (both shr 8) and 0xFF)
+        assertEquals(127, both and 0xFF)
+    }
+
+    @Test
+    fun curvesKeepAlphaAndLeaveTransparentPixelsAlone() {
+        val image = LegacyAdjustmentMaths.sampleImage()
+        val out = AdjustmentProcessor.apply(image, AdjustmentType.CURVES, CurveSet(gamma = curve(0f to 255f, 255f to 0f)).encode())
+        for (i in image.pixels.indices) {
+            assertEquals(image.pixels[i] ushr 24, out.pixels[i] ushr 24)
+            if (image.pixels[i] ushr 24 == 0) assertEquals(image.pixels[i], out.pixels[i])
+        }
+    }
+
+    @Test
+    fun encodingRoundTripsEveryChannel() {
+        val random = Random(11)
+        repeat(50) {
+            val set =
+                Channel.entries.fold(CurveSet()) { acc, channel ->
+                    val count = 2 + random.nextInt(ToneCurve.MAX_POINTS - 1)
+                    val xs = (List(count - 2) { 1f + random.nextInt(253) } + listOf(0f, 255f)).distinct().sorted()
+                    acc.with(channel, ToneCurve(xs.map { ToneCurve.Point(it, random.nextInt(256).toFloat()) }))
+                }
+            assertEquals(set, CurveSet.decode(set.encode()))
+            set.encode().keys.forEach { assertTrue(it, it in CurveSet.PARAMETER_RANGES) }
+        }
+    }
+
+    @Test
+    fun keysPastTheCountAreIgnoredSoRemovingAPointOnlyLowersIt() {
+        val three = CurveSet(gamma = curve(0f to 0f, 100f to 200f, 255f to 255f))
+        val two = CurveSet(gamma = ToneCurve.IDENTITY)
+        // Merging the shorter curve over the longer leaves point 2 behind, as an adjustment layer's map would.
+        assertEquals(two, CurveSet.decode(three.encode() + two.encode()))
+    }
+
+    @Test
+    fun malformedChannelsFallBackToStraight() {
+        val good = CurveSet(red = curve(0f to 0f, 128f to 200f, 255f to 255f)).encode(Channel.RED)
+        val missing = good - CurveSet.yKey(Channel.RED, 1)
+        assertEquals(ToneCurve.IDENTITY, CurveSet.decode(missing).red)
+        assertEquals(ToneCurve.IDENTITY, CurveSet.decode(good + (CurveSet.countKey(Channel.RED) to 40f)).red)
+        assertEquals(ToneCurve.IDENTITY, CurveSet.decode(good + (CurveSet.countKey(Channel.RED) to Float.NaN)).red)
+        assertEquals(ToneCurve.IDENTITY, CurveSet.decode(good + (CurveSet.xKey(Channel.RED, 0) to Float.POSITIVE_INFINITY)).red)
+    }
+
+    @Test
+    fun olderFivePointMapsRenderExactlyAsBefore() {
+        val random = Random(3)
+        val image = LegacyAdjustmentMaths.sampleImage()
+        repeat(60) { round ->
+            val parameters =
+                (0..4)
+                    .flatMap { i ->
+                        listOfNotNull(
+                            ("point_${i}_x" to random.nextFloat() * 300f - 20f).takeIf { round % 3 != 0 || i != 2 },
+                            "point_${i}_y" to random.nextFloat() * 255f,
+                        )
+                    }.toMap()
+            val expected = LegacyAdjustmentMaths.applyAll(image) { LegacyAdjustmentMaths.curves(it, parameters) }
+            assertArrayEquals("round $round", expected, AdjustmentProcessor.apply(image, AdjustmentType.CURVES, parameters).pixels)
+            assertArrayEquals(LegacyAdjustmentMaths.curveLut(parameters), AdjustmentProcessor.buildCurveLut(parameters))
+        }
+    }
+
+    @Test
+    fun newGammaKeysWinOverOlderPointsLeftInTheMap() {
+        val legacy = mapOf("point_2_x" to 128f, "point_2_y" to 255f)
+        val straight = legacy + CurveSet.IDENTITY.encode()
+        CurveSet.decode(straight).channelLuts().forEach { assertArrayEquals(identity(), it) }
+        // Without the new keys the older points still count.
+        assertEquals(255, CurveSet.decode(legacy).channelLuts()[0][128])
+    }
+
+    @Test
+    fun addingAPointPutsItOnTheCurveInOrder() {
+        val (added, index) = requireNotNull(ToneCurve.IDENTITY.withPointAt(100f))
+        assertEquals(1, index)
+        assertEquals(ToneCurve.Point(100f, 100f), added.points[1])
+        assertArrayEquals(identity(), added.lut())
+        assertNull("too close to a point", added.withPointAt(101f))
+        var full = ToneCurve.IDENTITY
+        for (x in 1 until ToneCurve.MAX_POINTS - 1) full = requireNotNull(full.withPointAt(x * 15f)).first
+        assertEquals(ToneCurve.MAX_POINTS, full.points.size)
+        assertNull("a curve holds at most 16 points", full.withPointAt(250f))
+    }
+
+    @Test
+    fun endpointsMoveOnlyUpAndDownAndInnerPointsStayBetweenTheirNeighbours() {
+        val curve = curve(0f to 0f, 100f to 100f, 200f to 200f, 255f to 255f)
+        assertEquals(ToneCurve.Point(0f, 80f), curve.withPointMoved(0, 50f, 80f).points[0])
+        assertEquals(ToneCurve.Point(255f, 0f), curve.withPointMoved(3, 10f, -20f).points[3])
+        val dragged = curve.withPointMoved(1, 250f, 300f).points[1]
+        assertEquals(200f - ToneCurve.MIN_GAP, dragged.x, 0f)
+        assertEquals(255f, dragged.y, 0f)
+        assertEquals(curve, curve.withPointMoved(1, Float.NaN, 3f))
+    }
+
+    @Test
+    fun removingKeepsTheEndpoints() {
+        val curve = curve(0f to 0f, 100f to 150f, 255f to 255f)
+        assertEquals(ToneCurve.IDENTITY, curve.withoutPoint(1))
+        assertEquals(curve, curve.withoutPoint(0))
+        assertEquals(curve, curve.withoutPoint(2))
+        assertEquals(ToneCurve.IDENTITY, ToneCurve.IDENTITY.withoutPoint(1))
+    }
+
+    @Test
+    fun theNearestPointWithinReachIsFound() {
+        val curve = curve(0f to 0f, 100f to 150f, 255f to 255f)
+        assertEquals(1, curve.pointNear(104f, 147f, 10f))
+        assertNull(curve.pointNear(160f, 40f, 10f))
+    }
+}
