+package com.artflow.studio.core.pixels
+
+import com.artflow.studio.core.tool.GradientTool
+import com.artflow.studio.domain.model.layer.AdjustmentType
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.util.Random
+
+class GradientMapTest {
+    private val navy = 0xFF102040.toInt()
+    private val orange = 0xFFFF8000.toInt()
+    private val twoTone =
+        GradientTool.Gradient("", GradientTool.GradientType.LINEAR, listOf(GradientTool.Stop(0f, navy), GradientTool.Stop(1f, orange)))
+
+    private fun map(
+        pixel: Int,
+        parameters: Map<String, Float> = GradientMap.encode(twoTone),
+    ): Int = AdjustmentProcessor.apply(PixelBuffer.filled(1, 1, pixel), AdjustmentType.GRADIENT_MAP, parameters).pixels[0]
+
+    @Test
+    fun blackTakesTheFirstStopAndWhiteTheLast() {
+        assertEquals(navy, map(0xFF000000.toInt()))
+        assertEquals(orange, map(0xFFFFFFFF.toInt()))
+    }
+
+    @Test
+    fun middleGreyTakesTheColourHalfwayAlong() {
+        val mid = map(0xFF808080.toInt())
+        val expected = GradientTool.lerpColor(navy, orange, Channels.luminance(0xFF808080.toInt()))
+        for (shift in listOf(16, 8, 0)) assertEquals(((expected shr shift) and 0xFF).toFloat(), ((mid shr shift) and 0xFF).toFloat(), 1f)
+    }
+
+    @Test
+    fun alphaIsKept() {
+        val image = LegacyAdjustmentMaths.sampleImage()
+        val out = AdjustmentProcessor.apply(image, AdjustmentType.GRADIENT_MAP, GradientMap.encode(GradientMap.LIBRARY[5]))
+        for (i in image.pixels.indices) assertEquals(image.pixels[i] ushr 24, out.pixels[i] ushr 24)
+    }
+
+    @Test
+    fun theLibraryHoldsAtLeastTwelveWellFormedGradients() {
+        assertTrue(GradientMap.LIBRARY.size >= 12)
+        val names = GradientMap.LIBRARY.map { it.name }
+        assertEquals("names are unique", names.size, names.toSet().size)
+        GradientMap.LIBRARY.forEach { gradient ->
+            val stops = gradient.stops
+            assertTrue(gradient.name, stops.size in 2..GradientMap.MAX_STOPS)
+            assertEquals(gradient.name, 0f, stops.first().position, 0f)
+            assertEquals(gradient.name, 1f, stops.last().position, 0f)
+            assertEquals(gradient.name, stops.sortedBy { it.position }, stops)
+            stops.forEach { assertEquals(gradient.name, 0xFF, it.color ushr 24) }
+            assertTrue(gradient.name, GradientMap.sameStops(gradient, requireNotNull(GradientMap.decode(GradientMap.encode(gradient)))))
+            // Darkest stop first, so a gradient maps shadows to its dark end.
+            assertTrue(gradient.name, Channels.luminance(stops.first().color) < Channels.luminance(stops.last().color))
+        }
+    }
+
+    @Test
+    fun encodingRoundTripsColoursExactly() {
+        val random = Random(2)
+        repeat(100) {
+            val count = 2 + random.nextInt(GradientMap.MAX_STOPS - 1)
+            val stops = List(count) { GradientTool.Stop(random.nextFloat(), 0xFF000000.toInt() or random.nextInt(0x1000000)) }
+            val gradient = GradientTool.Gradient("", GradientTool.GradientType.LINEAR, stops)
+            val decoded = requireNotNull(GradientMap.decode(GradientMap.encode(gradient)))
+            assertEquals(gradient.sortedStops.map { it.color }, decoded.stops.map { it.color })
+            assertTrue(GradientMap.sameStops(gradient, decoded))
+            GradientMap.encode(gradient).keys.forEach { assertTrue(it, it in GradientMap.PARAMETER_RANGES) }
+        }
+    }
+
+    @Test
+    fun stopsPastTheCountAreIgnored() {
+        val three = GradientMap.LIBRARY.first { it.stops.size >= 3 }
+        val merged = GradientMap.encode(three) + GradientMap.encode(twoTone)
+        assertTrue(GradientMap.sameStops(twoTone, requireNotNull(GradientMap.decode(merged))))
+    }
+
+    @Test
+    fun malformedStopsAreTheOriginalTwoHueMap() {
+        assertNull(GradientMap.decode(emptyMap()))
+        assertNull(GradientMap.decode(mapOf(GradientMap.STOPS to 1f)))
+        assertNull(GradientMap.decode(GradientMap.encode(twoTone) - GradientMap.colorKey(1)))
+        assertNull(GradientMap.decode(GradientMap.encode(twoTone) + (GradientMap.STOPS to Float.NaN)))
+        assertNotNull(GradientMap.decode(GradientMap.encode(twoTone)))
+    }
+
+    @Test
+    fun olderTwoHueMapsRenderExactlyAsBefore() {
+        val random = Random(4)
+        val image = LegacyAdjustmentMaths.sampleImage()
+        val maps =
+            listOf(emptyMap(), mapOf("gradient_start_hue" to 0f, "gradient_end_hue" to 360f)) +
+                List(20) {
+                    listOf("gradient_start_hue", "gradient_end_hue")
+                        .filter { random.nextInt(3) != 0 }
+                        .associateWith { random.nextFloat() * 360f }
+                }
+        maps.forEach { parameters ->
+            val expected = LegacyAdjustmentMaths.applyAll(image) { LegacyAdjustmentMaths.gradientMap(it, parameters) }
+            val actual = AdjustmentProcessor.apply(image, AdjustmentType.GRADIENT_MAP, parameters).pixels
+            assertArrayEquals(parameters.toString(), expected, actual)
+        }
+    }
+
+    @Test
+    fun theStopDefaultsAreNoir() {
+        val grey = 0xFF6A6A6A.toInt()
+        assertEquals(grey, map(grey, GradientMap.DEFAULT_PARAMETERS))
+    }
+
+    @Test
+    fun theLayerDefaultsAreStillTheOriginalTwoHueMap() {
+        val image = LegacyAdjustmentMaths.sampleImage()
+        val defaults = AdjustmentType.GRADIENT_MAP.defaultParameters
+        val expected = LegacyAdjustmentMaths.applyAll(image) { LegacyAdjustmentMaths.gradientMap(it, defaults) }
+        assertArrayEquals(expected, AdjustmentProcessor.apply(image, AdjustmentType.GRADIENT_MAP, defaults).pixels)
+    }
+}
diff --git a/app/src/test/java/com/artflow/studio/core/pixels/LegacyAdjustmentMaths.kt b/app/src/test/java/com/artflow/studio/core/pixels/LegacyAdjustmentMaths.kt
new file mode 100644
index 0000000..69c269b
--- /dev/null
+++ b/app/src/test/java/com/artflow/studio/core/pixels/LegacyAdjustmentMaths.kt
@@ -0,0 +1,154 @@
+package com.artflow.studio.core.pixels
+
+import com.artflow.studio.domain.model.Color
+import kotlin.math.abs
+import kotlin.math.roundToInt
+import kotlin.math.sqrt
+
+/**
+ * The Curves, Colour Balance and Gradient Map maths exactly as they were before per-channel curves, tonal ranges and
+ * gradient stops, copied here so tests can prove that maps saved back then still render bit for bit the same.
+ */
+object LegacyAdjustmentMaths {
+    private val CURVE_DEFAULTS =
+        mapOf(
+            "point_0_x" to 0f,
+            "point_0_y" to 0f,
+            "point_1_x" to 64f,
+            "point_1_y" to 64f,
+            "point_2_x" to 128f,
+            "point_2_y" to 128f,
+            "point_3_x" to 192f,
+            "point_3_y" to 192f,
+            "point_4_x" to 255f,
+            "point_4_y" to 255f,
+        )
+
+    /** Curves: one table from the five points over their old defaults, applied to red, green and blue. */
+    fun curves(
+        pixel: Int,
+        parameters: Map<String, Float>,
+    ): Int {
+        val lut = curveLut(CURVE_DEFAULTS + parameters)
+        return Channels.argb(
+            Channels.alpha(pixel).toInt(),
+            lut[Channels.red(pixel).toInt().coerceIn(0, 255)],
+            lut[Channels.green(pixel).toInt().coerceIn(0, 255)],
+            lut[Channels.blue(pixel).toInt().coerceIn(0, 255)],
+        )
+    }
+
+    /** Colour Balance: one even shift of each channel. */
+    fun colorBalance(
+        pixel: Int,
+        parameters: Map<String, Float>,
+    ): Int {
+        val cyanRed = (parameters["cyan_red"] ?: 0f) / 100f * 255f
+        val magentaGreen = (parameters["magenta_green"] ?: 0f) / 100f * 255f
+        val yellowBlue = (parameters["yellow_blue"] ?: 0f) / 100f * 255f
+        return Channels.argb(
+            Channels.alpha(pixel).toInt(),
+            clamp(Channels.red(pixel) + cyanRed),
+            clamp(Channels.green(pixel) + magentaGreen),
+            clamp(Channels.blue(pixel) + yellowBlue),
+        )
+    }
+
+    /** Gradient Map: a hue sweep from `gradient_start_hue` (0) to `gradient_end_hue` (360) by luminance. */
+    fun gradientMap(
+        pixel: Int,
+        parameters: Map<String, Float>,
+    ): Int {
+        val startHue = parameters["gradient_start_hue"] ?: 0f
+        val endHue = parameters["gradient_end_hue"] ?: 360f
+        val luminance = Channels.luminance(pixel)
+        val hue = startHue + (endHue - startHue) * luminance
+        val mapped = Color.hsvToRgb(hue, if (luminance > 0.5f) 1f - (luminance - 0.5f) * 2f * 0.2f else 1f, 1f)
+        return Channels.withAlpha(mapped, Channels.alpha(pixel).toInt())
+    }
+
+    /** What the old per-pixel pass did with a transform: transparent pixels kept, the rest replaced. */
+    fun applyAll(
+        source: PixelBuffer,
+        transform: (Int) -> Int,
+    ): IntArray = IntArray(source.pixels.size) { i -> source.pixels[i].let { if ((it ushr 24) == 0) it else transform(it) } }
+
+    private fun clamp(value: Float): Int = value.roundToInt().coerceIn(0, 255)
+
+    fun curveLut(parameters: Map<String, Float>): IntArray {
+        val points =
+            (0..4)
+                .mapNotNull { index ->
+                    val x = parameters["point_${index}_x"] ?: return@mapNotNull null
+                    val y = parameters["point_${index}_y"] ?: return@mapNotNull null
+                    (x.coerceIn(0f, 255f) to y.coerceIn(0f, 255f))
+                }.sortedBy { it.first }
+
+        val lut = IntArray(256)
+        if (points.size < 2) {
+            for (i in 0..255) lut[i] = i
+            return lut
+        }
+        val xs = FloatArray(points.size) { points[it].first }
+        val ys = FloatArray(points.size) { points[it].second }
+        val n = points.size
+        val slopes =
+            FloatArray(n - 1) { i ->
+                val dx = xs[i + 1] - xs[i]
+                if (abs(dx) < 1e-4f) 0f else (ys[i + 1] - ys[i]) / dx
+            }
+        val tangents = FloatArray(n)
+        tangents[0] = slopes[0]
+        tangents[n - 1] = slopes[n - 2]
+        for (i in 1 until n - 1) {
+            tangents[i] = if (slopes[i - 1] * slopes[i] <= 0f) 0f else (slopes[i - 1] + slopes[i]) / 2f
+        }
+        for (i in 0 until n - 1) {
+            if (abs(slopes[i]) < 1e-5f) {
+                tangents[i] = 0f
+                tangents[i + 1] = 0f
+            } else {
+                val a = tangents[i] / slopes[i]
+                val b = tangents[i + 1] / slopes[i]
+                val h = a * a + b * b
+                if (h > 9f) {
+                    val t = 3f / sqrt(h)
+                    tangents[i] = t * a * slopes[i]
+                    tangents[i + 1] = t * b * slopes[i]
+                }
+            }
+        }
+        var segment = 0
+        for (x in 0..255) {
+            val xf = x.toFloat()
+            while (segment < n - 2 && xf > xs[segment + 1]) segment++
+            val h = (xs[segment + 1] - xs[segment]).coerceAtLeast(1e-4f)
+            val t = ((xf - xs[segment]) / h).coerceIn(0f, 1f)
+            val t2 = t * t
+            val t3 = t2 * t
+            val h00 = 2f * t3 - 3f * t2 + 1f
+            val h10 = t3 - 2f * t2 + t
+            val h01 = -2f * t3 + 3f * t2
+            val h11 = t3 - t2
+            val value = h00 * ys[segment] + h10 * h * tangents[segment] + h01 * ys[segment + 1] + h11 * h * tangents[segment + 1]
+            lut[x] = value.roundToInt().coerceIn(0, 255)
+        }
+        return lut
+    }
+
+    /** A varied test image: every 8-bit level in each channel somewhere, some translucent and transparent pixels. */
+    fun sampleImage(): PixelBuffer {
+        val random = java.util.Random(99)
+        return PixelBuffer(64, 64).also { buffer ->
+            for (i in buffer.pixels.indices) {
+                val alpha =
+                    when {
+                        i % 17 == 0 -> 0
+                        i % 5 == 0 -> 40 + random.nextInt(200)
+                        else -> 255
+                    }
+                buffer.pixels[i] = Channels.argb(alpha, (i * 7) and 0xFF, random.nextInt(256), (i / 64 * 4 + i % 3) and 0xFF)
+            }
+        }
+    }
+}
