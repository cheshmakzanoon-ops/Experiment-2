@@ -0,0 +1,193 @@
+package com.artflow.studio.core.pixels
+
+import com.artflow.studio.core.pixels.LiveAdjustments.Kind
+import kotlin.math.roundToInt
+
+/**
+ * The controls a live adjustment has besides its amount: a mode and sliders, with their parameter keys, ranges and
+ * defaults. Effects read them through [value], so a missing, non-finite or out-of-range entry means the default.
+ */
+object AdjustmentOptions {
+    /**
+     * A slider over [min]..[max] or, when [modes] is above zero, a choice of [modes] named modes (values 0 until [modes]).
+     * [shownIn] lists the values of the kind's first mode option that the control applies to; empty means all of them.
+     */
+    data class Option(
+        val key: String,
+        val min: Float,
+        val max: Float,
+        val default: Float,
+        val modes: Int = 0,
+        val wholeNumbers: Boolean = false,
+        val shownIn: Set<Int> = emptySet(),
+    ) {
+        val isMode: Boolean get() = modes > 0
+    }
+
+    /** How a touch on the canvas drives an adjustment. */
+    enum class Gesture {
+        /** Nothing on the canvas; the bottom bar holds every control. */
+        NONE,
+
+        /** Slide left or right to set the amount. */
+        AMOUNT,
+
+        /** Slide in a direction: the slide's length is the amount and its direction the angle. */
+        VECTOR,
+
+        /** Touch to place the effect's point. */
+        POINT,
+    }
+
+    enum class GlitchMode { ARTIFACT, WAVE, SIGNAL, DIVERGE, DISPLACE }
+
+    enum class HalftoneMode { FULL_COLOUR, SCREEN_PRINT, NEWSPAPER }
+
+    enum class AberrationMode { PERSPECTIVE, DISPLACE }
+
+    enum class NoiseMode { CLOUDS, BILLOW, RIDGES, WHITE }
+
+    enum class PerspectiveMode { POSITIONAL, DIRECTIONAL }
+
+    const val BLOOM_TRANSITION = "bloom_transition"
+    const val BLOOM_SIZE = "bloom_size"
+    const val BLOOM_BURN = "bloom_burn"
+    const val GLITCH_MODE = "glitch_mode"
+    const val GLITCH_SIZE = "glitch_size"
+
+    /** Varies a glitch's pattern; it has no slider, the bar's shuffle button changes it. */
+    const val GLITCH_SEED = "glitch_seed"
+    const val HALFTONE_MODE = "halftone_mode"
+    const val HALFTONE_SHARPNESS = "halftone_sharpness"
+    const val ABERRATION_MODE = "aberration_mode"
+    const val ABERRATION_FALLOFF = "aberration_falloff"
+    const val NOISE_MODE = "noise_mode"
+    const val NOISE_SCALE = "noise_scale"
+    const val NOISE_OCTAVES = "noise_octaves"
+    const val NOISE_ROUGHNESS = "noise_roughness"
+
+    /** 0 for one grey noise over all channels, 1 for a separate noise per channel. */
+    const val NOISE_COLOUR = "noise_colour"
+    const val PERSPECTIVE_MODE = "perspective_mode"
+    const val PERSPECTIVE_ANGLE = "perspective_angle"
+    const val MAX_SEED = 9999f
+
+    private val NOISE_FIELDS = setOf(NoiseMode.CLOUDS.ordinal, NoiseMode.BILLOW.ordinal, NoiseMode.RIDGES.ordinal)
+
+    private val BLOOM =
+        listOf(
+            Option(BLOOM_TRANSITION, 0f, 1f, 0.5f),
+            Option(BLOOM_SIZE, 0f, 1f, 0.35f),
+            Option(BLOOM_BURN, 0f, 1f, 0f),
+        )
+    private val GLITCH =
+        listOf(
+            mode(GLITCH_MODE, GlitchMode.entries.size),
+            Option(GLITCH_SIZE, 0f, 1f, 0.4f),
+        )
+    private val HALFTONE =
+        listOf(
+            mode(HALFTONE_MODE, HalftoneMode.entries.size),
+            Option(HALFTONE_SHARPNESS, 0f, 1f, 0.7f),
+        )
+    private val ABERRATION =
+        listOf(
+            mode(ABERRATION_MODE, AberrationMode.entries.size),
+            Option(ABERRATION_FALLOFF, 0f, 1f, 0f, shownIn = setOf(AberrationMode.PERSPECTIVE.ordinal)),
+        )
+    private val NOISE =
+        listOf(
+            mode(NOISE_MODE, NoiseMode.entries.size),
+            Option(NOISE_SCALE, 0f, 1f, 0.35f, shownIn = NOISE_FIELDS),
+            Option(NOISE_OCTAVES, 1f, 8f, 4f, wholeNumbers = true, shownIn = NOISE_FIELDS),
+            Option(NOISE_ROUGHNESS, 0f, 1f, 0.5f, shownIn = NOISE_FIELDS),
+            mode(NOISE_COLOUR, 2),
+        )
+    private val PERSPECTIVE =
+        listOf(
+            mode(PERSPECTIVE_MODE, PerspectiveMode.entries.size),
+            Option(PERSPECTIVE_ANGLE, 0f, 360f, 0f, shownIn = setOf(PerspectiveMode.DIRECTIONAL.ordinal)),
+        )
+
+    /** Every control of [kind] besides its amount, modes first. */
+    fun forKind(kind: Kind): List<Option> =
+        when (kind) {
+            Kind.BLOOM -> BLOOM
+            Kind.GLITCH -> GLITCH
+            Kind.HALFTONE -> HALFTONE
+            Kind.CHROMATIC_ABERRATION -> ABERRATION
+            Kind.NOISE -> NOISE
+            Kind.PERSPECTIVE_BLUR -> PERSPECTIVE
+            else -> emptyList()
+        }
+
+    /** The controls of [kind] that apply in the mode [parameters] select. */
+    fun visible(
+        kind: Kind,
+        parameters: Map<String, Float>,
+    ): List<Option> {
+        val options = forKind(kind)
+        val mode = options.firstOrNull { it.isMode }?.let { value(parameters, it).toInt() }
+        return options.filter { it.shownIn.isEmpty() || mode in it.shownIn }
+    }
+
+    /** [option]'s value in [parameters]: its default when missing or not finite, clamped, whole for modes. */
+    fun value(
+        parameters: Map<String, Float>,
+        option: Option,
+    ): Float {
+        val raw = parameters[option.key]?.takeIf { it.isFinite() } ?: return option.default
+        val clamped = raw.coerceIn(option.min, option.max)
+        return if (option.wholeNumbers || option.isMode) clamped.roundToInt().toFloat() else clamped
+    }
+
+    /** The value of [kind]'s option [key] in [parameters]. */
+    fun value(
+        kind: Kind,
+        parameters: Map<String, Float>,
+        key: String,
+    ): Float = value(parameters, forKind(kind).first { it.key == key })
+
+    /** How a canvas touch drives [kind] in the mode [parameters] select. */
+    fun gesture(
+        kind: Kind,
+        parameters: Map<String, Float>,
+    ): Gesture =
+        when {
+            kind.usesPoint -> Gesture.POINT
+            kind == Kind.MOTION_BLUR -> Gesture.VECTOR
+            kind == Kind.CHROMATIC_ABERRATION && aberrationMode(parameters) == AberrationMode.DISPLACE -> Gesture.VECTOR
+            kind.slidesAmount -> Gesture.AMOUNT
+            else -> Gesture.NONE
+        }
+
+    /** True when [kind] has a centre to drag on the canvas while a slide anywhere else sets the amount. */
+    fun hasMovableCentre(
+        kind: Kind,
+        parameters: Map<String, Float>,
+    ): Boolean = kind == Kind.CHROMATIC_ABERRATION && aberrationMode(parameters) == AberrationMode.PERSPECTIVE
+
+    fun glitchMode(parameters: Map<String, Float>): GlitchMode = GlitchMode.entries[modeIndex(GLITCH, parameters)]
+
+    fun halftoneMode(parameters: Map<String, Float>): HalftoneMode = HalftoneMode.entries[modeIndex(HALFTONE, parameters)]
+
+    fun aberrationMode(parameters: Map<String, Float>): AberrationMode = AberrationMode.entries[modeIndex(ABERRATION, parameters)]
+
+    fun noiseMode(parameters: Map<String, Float>): NoiseMode = NoiseMode.entries[modeIndex(NOISE, parameters)]
+
+    fun perspectiveMode(parameters: Map<String, Float>): PerspectiveMode = PerspectiveMode.entries[modeIndex(PERSPECTIVE, parameters)]
+
+    /** The glitch pattern's seed, a whole number from 0 to [MAX_SEED]. */
+    fun glitchSeed(parameters: Map<String, Float>): Int =
+        (parameters[GLITCH_SEED]?.takeIf { it.isFinite() } ?: 0f).coerceIn(0f, MAX_SEED).roundToInt()
+
+    private fun modeIndex(
+        options: List<Option>,
+        parameters: Map<String, Float>,
+    ): Int = value(parameters, options.first { it.isMode }).toInt()
+
+    private fun mode(
+        key: String,
+        count: Int,
+    ): Option = Option(key, 0f, (count - 1).toFloat(), 0f, modes = count)
+}
