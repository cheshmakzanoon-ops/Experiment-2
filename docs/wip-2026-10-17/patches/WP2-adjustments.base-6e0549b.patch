+++ b/app/src/main/java/com/artflow/studio/core/pixels/ColorBalance.kt
@@ -0,0 +1,123 @@
+package com.artflow.studio.core.pixels
+
+import kotlin.math.roundToInt
+
+/**
+ * Colour Balance with Procreate's Shadows, Midtones and Highlights. Each range has a Cyan-Red, a Magenta-Green and a
+ * Yellow-Blue shift from -100 to 100, weighted by the pixel's luminance with smooth curves that add up to one: Shadows
+ * acts on dark pixels, Midtones on the middle and Highlights on light pixels, and the same shift in all three ranges moves
+ * every pixel alike. Alpha never changes.
+ *
+ * Range shifts are stored as `<range>_<axis>`, for example `shadows_cyan_red`. The keys `cyan_red`, `magenta_green` and
+ * `yellow_blue` from before the ranges existed still shift every pixel evenly, exactly as they did, so older Colour
+ * Balance layers look unchanged.
+ */
+object ColorBalance {
+    enum class Range(
+        val key: String,
+    ) {
+        SHADOWS("shadows"),
+        MIDTONES("midtones"),
+        HIGHLIGHTS("highlights"),
+    }
+
+    /** A slider's axis; positive values move toward the second colour (Red, Green, Blue). */
+    enum class Axis(
+        val key: String,
+    ) {
+        CYAN_RED("cyan_red"),
+        MAGENTA_GREEN("magenta_green"),
+        YELLOW_BLUE("yellow_blue"),
+    }
+
+    fun key(
+        range: Range,
+        axis: Axis,
+    ): String = "${range.key}_${axis.key}"
+
+    /** The even, all-tones shift of older Colour Balance layers. */
+    fun legacyKey(axis: Axis): String = axis.key
+
+    const val MAX_SHIFT = 100f
+
+    /** Levels a full-strength range shift moves a channel where its weight is one. */
+    private const val RANGE_LEVELS = 0.55f * 255f
+
+    val DEFAULT_PARAMETERS: Map<String, Float> =
+        buildMap {
+            Axis.entries.forEach { put(legacyKey(it), 0f) }
+            Range.entries.forEach { range -> Axis.entries.forEach { put(key(range, it), 0f) } }
+        }
+
+    val PARAMETER_RANGES: Map<String, ClosedFloatingPointRange<Float>> = DEFAULT_PARAMETERS.mapValues { -MAX_SHIFT..MAX_SHIFT }
+
+    /** How much Shadows acts at [luminance] (0..1): fully on black, fading out by the middle grey. */
+    fun shadowWeight(luminance: Float): Float = 1f - smoothstep(0f, 0.5f, luminance)
+
+    /** How much Highlights acts at [luminance] (0..1): none up to the middle grey, fully on white. */
+    fun highlightWeight(luminance: Float): Float = smoothstep(0.5f, 1f, luminance)
+
+    /** How much Midtones acts at [luminance]: whatever Shadows and Highlights leave, peaking at the middle grey. */
+    fun midtoneWeight(luminance: Float): Float = 1f - shadowWeight(luminance) - highlightWeight(luminance)
+
+    private fun smoothstep(
+        edge0: Float,
+        edge1: Float,
+        value: Float,
+    ): Float {
+        val t = ((value - edge0) / (edge1 - edge0)).coerceIn(0f, 1f)
+        return t * t * (3f - 2f * t)
+    }
+
+    /** The shifts of one Colour Balance map, in channel levels, ready to apply to many pixels. */
+    class Shifts(
+        parameters: Map<String, Float>,
+    ) {
+        // The even shift keeps the arithmetic it always had, so older layers render bit for bit as before.
+        private val evenRed = even(parameters, Axis.CYAN_RED)
+        private val evenGreen = even(parameters, Axis.MAGENTA_GREEN)
+        private val evenBlue = even(parameters, Axis.YELLOW_BLUE)
+
+        /** Shadows, Midtones and Highlights shifts for red, green and blue: index `range * 3 + axis`. */
+        private val ranged =
+            FloatArray(Range.entries.size * Axis.entries.size) { index ->
+                val shift = finite(parameters[key(Range.entries[index / 3], Axis.entries[index % 3])])
+                shift.coerceIn(-MAX_SHIFT, MAX_SHIFT) / MAX_SHIFT * RANGE_LEVELS
+            }
+
+        private val hasRanges = ranged.any { it != 0f }
+
+        /** True when no shift is set, so every pixel stays as it is. */
+        val isIdentity: Boolean get() = !hasRanges && evenRed == 0f && evenGreen == 0f && evenBlue == 0f
+
+        fun apply(pixel: Int): Int {
+            var r = Channels.red(pixel) + evenRed
+            var g = Channels.green(pixel) + evenGreen
+            var b = Channels.blue(pixel) + evenBlue
+            if (hasRanges) {
+                val luminance = Channels.luminance(pixel)
+                val shadows = shadowWeight(luminance)
+                val highlights = highlightWeight(luminance)
+                val midtones = 1f - shadows - highlights
+                r += shadows * ranged[0] + midtones * ranged[3] + highlights * ranged[6]
+                g += shadows * ranged[1] + midtones * ranged[4] + highlights * ranged[7]
+                b += shadows * ranged[2] + midtones * ranged[5] + highlights * ranged[8]
+            }
+            return Channels.argb(
+                pixel ushr 24,
+                r.roundToInt().coerceIn(0, 255),
+                g.roundToInt().coerceIn(0, 255),
+                b.roundToInt().coerceIn(0, 255),
+            )
+        }
+
+        private companion object {
+            fun finite(value: Float?): Float = value?.takeIf { it.isFinite() } ?: 0f
+
+            fun even(
+                parameters: Map<String, Float>,
+                axis: Axis,
+            ): Float = finite(parameters[legacyKey(axis)]) / 100f * 255f
+        }
+    }
+}
