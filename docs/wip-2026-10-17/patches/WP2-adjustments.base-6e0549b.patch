+++ b/app/src/main/java/com/artflow/studio/core/pixels/ColorPlanes.kt
@@ -0,0 +1,175 @@
+package com.artflow.studio.core.pixels
+
+import kotlin.math.ceil
+import kotlin.math.exp
+import kotlin.math.max
+
+/**
+ * Premultiplied colour as four float planes (0..1), for effects that work on a reduced-resolution copy of a layer:
+ * a wide blur on a small grid costs a fraction of the same blur at full size and looks the same once sampled back.
+ */
+internal class ColorPlanes(
+    val width: Int,
+    val height: Int,
+) {
+    val red = FloatArray(width * height)
+    val green = FloatArray(width * height)
+    val blue = FloatArray(width * height)
+    val alpha = FloatArray(width * height)
+
+    /** Gaussian blur in place, [sigma] in grid cells; the edges extend outward. [checkpoint] runs once per row. */
+    fun blur(
+        sigma: Float,
+        checkpoint: () -> Unit,
+    ) {
+        if (sigma < MIN_SIGMA) return
+        val kernel = kernel(sigma)
+        val scratch = FloatArray(width * height)
+        for (plane in arrayOf(red, green, blue, alpha)) {
+            horizontal(plane, scratch, kernel, checkpoint)
+            vertical(scratch, plane, kernel, checkpoint)
+        }
+    }
+
+    /**
+     * Bilinear sample at grid position ([x], [y]), where cell i covers i..i+1, clamped to the edges; writes premultiplied
+     * red, green, blue and alpha into [out] so that sampling allocates nothing.
+     */
+    fun sample(
+        x: Float,
+        y: Float,
+        out: FloatArray,
+    ) {
+        val gx = (x - 0.5f).coerceIn(0f, (width - 1).toFloat())
+        val gy = (y - 0.5f).coerceIn(0f, (height - 1).toFloat())
+        val x0 = gx.toInt()
+        val y0 = gy.toInt()
+        val x1 = if (x0 + 1 < width) x0 + 1 else x0
+        val y1 = if (y0 + 1 < height) y0 + 1 else y0
+        val fx = gx - x0
+        val fy = gy - y0
+        val i00 = y0 * width + x0
+        val i10 = y0 * width + x1
+        val i01 = y1 * width + x0
+        val i11 = y1 * width + x1
+        out[0] = mix(red, i00, i10, i01, i11, fx, fy)
+        out[1] = mix(green, i00, i10, i01, i11, fx, fy)
+        out[2] = mix(blue, i00, i10, i01, i11, fx, fy)
+        out[3] = mix(alpha, i00, i10, i01, i11, fx, fy)
+    }
+
+    private fun mix(
+        plane: FloatArray,
+        i00: Int,
+        i10: Int,
+        i01: Int,
+        i11: Int,
+        fx: Float,
+        fy: Float,
+    ): Float {
+        val top = plane[i00] + (plane[i10] - plane[i00]) * fx
+        val bottom = plane[i01] + (plane[i11] - plane[i01]) * fx
+        return top + (bottom - top) * fy
+    }
+
+    private fun horizontal(
+        source: FloatArray,
+        target: FloatArray,
+        kernel: FloatArray,
+        checkpoint: () -> Unit,
+    ) {
+        val radius = kernel.size / 2
+        for (y in 0 until height) {
+            checkpoint()
+            val row = y * width
+            for (x in 0 until width) {
+                var sum = 0f
+                for (k in -radius..radius) sum += source[row + (x + k).coerceIn(0, width - 1)] * kernel[k + radius]
+                target[row + x] = sum
+            }
+        }
+    }
+
+    private fun vertical(
+        source: FloatArray,
+        target: FloatArray,
+        kernel: FloatArray,
+        checkpoint: () -> Unit,
+    ) {
+        val radius = kernel.size / 2
+        for (y in 0 until height) {
+            checkpoint()
+            for (x in 0 until width) {
+                var sum = 0f
+                for (k in -radius..radius) sum += source[(y + k).coerceIn(0, height - 1) * width + x] * kernel[k + radius]
+                target[y * width + x] = sum
+            }
+        }
+    }
+
+    /** Adds [pixel] (straight ARGB) to cell [index] premultiplied, scaled by [weight]. */
+    fun add(
+        index: Int,
+        pixel: Int,
+        weight: Float,
+    ) {
+        val a = (pixel ushr 24) / 255f * weight
+        if (a <= 0f) return
+        alpha[index] += a
+        red[index] += ((pixel shr 16) and 0xFF) / 255f * a
+        green[index] += ((pixel shr 8) and 0xFF) / 255f * a
+        blue[index] += (pixel and 0xFF) / 255f * a
+    }
+
+    /** Divides every cell by its entry in [counts], turning sums into averages. */
+    fun divide(counts: FloatArray) {
+        for (i in counts.indices) {
+            val count = counts[i]
+            if (count > 0f) {
+                red[i] /= count
+                green[i] /= count
+                blue[i] /= count
+                alpha[i] /= count
+            }
+        }
+    }
+
+    companion object {
+        private const val MIN_SIGMA = 0.2f
+
+        /** [source] averaged over [factor] × [factor] blocks (the last row and column of blocks may be partial). */
+        fun downsample(
+            source: PixelBuffer,
+            factor: Int,
+            checkpoint: () -> Unit,
+        ): ColorPlanes {
+            val step = max(1, factor)
+            val planes = ColorPlanes(ceil(source.width / step.toFloat()).toInt(), ceil(source.height / step.toFloat()).toInt())
+            val counts = FloatArray(planes.width * planes.height)
+            for (y in 0 until source.height) {
+                checkpoint()
+                val row = (y / step) * planes.width
+                for (x in 0 until source.width) {
+                    planes.add(row + x / step, source.pixels[y * source.width + x], 1f)
+                    counts[row + x / step] += 1f
+                }
+            }
+            planes.divide(counts)
+            return planes
+        }
+
+        /** Normalised Gaussian weights out to three standard deviations. */
+        fun kernel(sigma: Float): FloatArray {
+            val half = max(1, ceil(sigma * 3f).toInt())
+            val weights = FloatArray(half * 2 + 1)
+            var sum = 0f
+            for (i in -half..half) {
+                val weight = exp(-(i * i) / (2f * sigma * sigma))
+                weights[i + half] = weight
+                sum += weight
+            }
+            for (i in weights.indices) weights[i] /= sum
+            return weights
+        }
+    }
+}
diff --git a/app/src/main/java/com/artflow/studio/core/pixels/CurveSet.kt b/app/src/main/java/com/artflow/studio/core/pixels/CurveSet.kt
new file mode 100644
index 0000000..005c4ba
--- /dev/null
+++ b/app/src/main/java/com/artflow/studio/core/pixels/CurveSet.kt
@@ -0,0 +1,324 @@
+package com.artflow.studio.core.pixels
+
+import kotlin.math.abs
+import kotlin.math.roundToInt
+import kotlin.math.sqrt
+
+/**
+ * One tone curve: control points on a 0..255 by 0..255 graph, sorted by input ([Point.x]). The curve runs through every
+ * point by monotone cubic interpolation, so it never overshoots between two points, and it stays flat beyond the first
+ * and the last point.
+ */
+data class ToneCurve(
+    val points: List<Point>,
+) {
+    data class Point(
+        val x: Float,
+        val y: Float,
+    )
+
+    /** The 256-entry table this curve maps 8-bit channel values through. */
+    fun lut(): IntArray = monotoneLut(FloatArray(points.size) { points[it].x }, FloatArray(points.size) { points[it].y })
+
+    /** True when the curve maps every value to itself, whatever its points. */
+    fun isIdentity(): Boolean {
+        val lut = lut()
+        return lut.indices.all { lut[it] == it }
+    }
+
+    /** Index of the point nearest ([x], [y]) no farther than [radius] graph units, or null. */
+    fun pointNear(
+        x: Float,
+        y: Float,
+        radius: Float,
+    ): Int? {
+        var best: Int? = null
+        var bestDistance = radius
+        points.forEachIndexed { index, point ->
+            val distance = sqrt((point.x - x) * (point.x - x) + (point.y - y) * (point.y - y))
+            if (distance <= bestDistance) {
+                best = index
+                bestDistance = distance
+            }
+        }
+        return best
+    }
+
+    /**
+     * This curve with a new point at input [x], placed on the curve so that adding it changes nothing until it is
+     * dragged, and the new point's index; null when the curve is full or [x] is too close to an existing point.
+     */
+    fun withPointAt(x: Float): Pair<ToneCurve, Int>? {
+        val input = x.coerceIn(0f, MAX_VALUE)
+        if (points.size >= MAX_POINTS || points.any { abs(it.x - input) < MIN_GAP }) return null
+        val output = lut()[input.roundToInt()].toFloat()
+        val index = points.indexOfFirst { it.x > input }.let { if (it < 0) points.size else it }
+        val added = points.toMutableList().apply { add(index, Point(input, output)) }
+        return ToneCurve(added) to index
+    }
+
+    /**
+     * This curve with point [index] dragged to ([x], [y]). The first and the last point move only up and down; the
+     * others stay between their neighbours, at least [MIN_GAP] from each.
+     */
+    fun withPointMoved(
+        index: Int,
+        x: Float,
+        y: Float,
+    ): ToneCurve {
+        if (index !in points.indices || !x.isFinite() || !y.isFinite()) return this
+        val input =
+            if (index == 0 || index == points.lastIndex) {
+                points[index].x
+            } else {
+                val low = points[index - 1].x + MIN_GAP
+                val high = points[index + 1].x - MIN_GAP
+                if (low <= high) x.coerceIn(low, high) else points[index].x
+            }
+        val moved = points.toMutableList().apply { set(index, Point(input, y.coerceIn(0f, MAX_VALUE))) }
+        return ToneCurve(moved)
+    }
+
+    /** This curve without point [index]. The first and the last point always stay. */
+    fun withoutPoint(index: Int): ToneCurve =
+        if (index <= 0 || index >= points.lastIndex || points.size <= MIN_POINTS) {
+            this
+        } else {
+            ToneCurve(points.filterIndexed { i, _ -> i != index })
+        }
+
+    companion object {
+        const val MIN_POINTS = 2
+        const val MAX_POINTS = 16
+        const val MAX_VALUE = 255f
+
+        /** Smallest input gap kept between neighbouring points while editing. */
+        const val MIN_GAP = 4f
+
+        val IDENTITY = ToneCurve(listOf(Point(0f, 0f), Point(MAX_VALUE, MAX_VALUE)))
+
+        /**
+         * 256-entry table through points sorted by x, by monotone cubic Hermite interpolation (Fritsch-Carlson), so the
+         * curve cannot overshoot into artifacts. Fewer than two points give the identity.
+         */
+        fun monotoneLut(
+            xs: FloatArray,
+            ys: FloatArray,
+        ): IntArray {
+            val lut = IntArray(256)
+            val n = xs.size
+            if (n < 2) {
+                for (i in 0..255) lut[i] = i
+                return lut
+            }
+            val tangents = tangents(xs, ys)
+            var segment = 0
+            for (x in 0..255) {
+                val xf = x.toFloat()
+                while (segment < n - 2 && xf > xs[segment + 1]) segment++
+                val h = (xs[segment + 1] - xs[segment]).coerceAtLeast(1e-4f)
+                val t = ((xf - xs[segment]) / h).coerceIn(0f, 1f)
+                val t2 = t * t
+                val t3 = t2 * t
+                val h00 = 2f * t3 - 3f * t2 + 1f
+                val h10 = t3 - 2f * t2 + t
+                val h01 = -2f * t3 + 3f * t2
+                val h11 = t3 - t2
+                val value =
+                    h00 * ys[segment] + h10 * h * tangents[segment] +
+                        h01 * ys[segment + 1] + h11 * h * tangents[segment + 1]
+                lut[x] = value.roundToInt().coerceIn(0, 255)
+            }
+            return lut
+        }
+
+        private fun tangents(
+            xs: FloatArray,
+            ys: FloatArray,
+        ): FloatArray {
+            val n = xs.size
+            val slopes =
+                FloatArray(n - 1) { i ->
+                    val dx = xs[i + 1] - xs[i]
+                    if (abs(dx) < 1e-4f) 0f else (ys[i + 1] - ys[i]) / dx
+                }
+            val tangents = FloatArray(n)
+            tangents[0] = slopes[0]
+            tangents[n - 1] = slopes[n - 2]
+            for (i in 1 until n - 1) {
+                tangents[i] = if (slopes[i - 1] * slopes[i] <= 0f) 0f else (slopes[i - 1] + slopes[i]) / 2f
+            }
+            for (i in 0 until n - 1) {
+                if (abs(slopes[i]) < 1e-5f) {
+                    tangents[i] = 0f
+                    tangents[i + 1] = 0f
+                } else {
+                    val a = tangents[i] / slopes[i]
+                    val b = tangents[i + 1] / slopes[i]
+                    val h = a * a + b * b
+                    if (h > 9f) {
+                        val t = 3f / sqrt(h)
+                        tangents[i] = t * a * slopes[i]
+                        tangents[i + 1] = t * b * slopes[i]
+                    }
+                }
+            }
+            return tangents
+        }
+    }
+}
+
+/**
+ * Procreate's Curves: a Gamma curve for all three colour channels plus a curve each for Red, Green and Blue. A channel
+ * goes through its own curve first and then through Gamma.
+ *
+ * An adjustment's parameter map stores channel `c` (`rgb`, `r`, `g` or `b`) as `curve_c_n`, the point count, and
+ * `curve_c_<i>_x` / `curve_c_<i>_y` (0..255) for each point i below the count; keys at or past the count are ignored, so
+ * removing a point only lowers the count. Maps written before these keys existed hold a single curve as `point_<i>_x` /
+ * `point_<i>_y` (i = 0..4); while there is no `curve_rgb_n`, those points are the Gamma curve, so older Curves layers
+ * render exactly as they did.
+ */
+data class CurveSet(
+    val gamma: ToneCurve = ToneCurve.IDENTITY,
+    val red: ToneCurve = ToneCurve.IDENTITY,
+    val green: ToneCurve = ToneCurve.IDENTITY,
+    val blue: ToneCurve = ToneCurve.IDENTITY,
+) {
+    enum class Channel(
+        val key: String,
+    ) {
+        GAMMA("rgb"),
+        RED("r"),
+        GREEN("g"),
+        BLUE("b"),
+    }
+
+    operator fun get(channel: Channel): ToneCurve =
+        when (channel) {
+            Channel.GAMMA -> gamma
+            Channel.RED -> red
+            Channel.GREEN -> green
+            Channel.BLUE -> blue
+        }
+
+    fun with(
+        channel: Channel,
+        curve: ToneCurve,
+    ): CurveSet =
+        when (channel) {
+            Channel.GAMMA -> copy(gamma = curve)
+            Channel.RED -> copy(red = curve)
+            Channel.GREEN -> copy(green = curve)
+            Channel.BLUE -> copy(blue = curve)
+        }
+
+    /** The red, green and blue tables to apply: each channel's own curve followed by Gamma. */
+    fun channelLuts(): Array<IntArray> {
+        val shared = gamma.lut()
+        return arrayOf(red, green, blue)
+            .map { curve ->
+                val own = curve.lut()
+                IntArray(256) { shared[own[it]] }
+            }.toTypedArray()
+    }
+
+    /** Parameter entries for [channel]'s curve. */
+    fun encode(channel: Channel): Map<String, Float> {
+        val curve = get(channel)
+        val entries = LinkedHashMap<String, Float>()
+        entries[countKey(channel)] = curve.points.size.toFloat()
+        curve.points.forEachIndexed { index, point ->
+            entries[xKey(channel, index)] = point.x
+            entries[yKey(channel, index)] = point.y
+        }
+        return entries
+    }
+
+    /** Parameter entries for all four curves. */
+    fun encode(): Map<String, Float> = Channel.entries.fold(emptyMap()) { entries, channel -> entries + encode(channel) }
+
+    companion object {
+        val IDENTITY = CurveSet()
+
+        fun countKey(channel: Channel): String = "curve_${channel.key}_n"
+
+        fun xKey(
+            channel: Channel,
+            index: Int,
+        ): String = "curve_${channel.key}_${index}_x"
+
+        fun yKey(
+            channel: Channel,
+            index: Int,
+        ): String = "curve_${channel.key}_${index}_y"
+
+        /** The five-point curve every Curves map held before per-channel curves, as it was by default. */
+        val LEGACY_DEFAULTS: Map<String, Float> =
+            mapOf(
+                "point_0_x" to 0f,
+                "point_0_y" to 0f,
+                "point_1_x" to 64f,
+                "point_1_y" to 64f,
+                "point_2_x" to 128f,
+                "point_2_y" to 128f,
+                "point_3_x" to 192f,
+                "point_3_y" to 192f,
+                "point_4_x" to 255f,
+                "point_4_y" to 255f,
+            )
+
+        /** Four straight curves. */
+        val DEFAULT_PARAMETERS: Map<String, Float> = IDENTITY.encode()
+
+        /** Every key a Curves map may hold, legacy points included. */
+        val PARAMETER_RANGES: Map<String, ClosedFloatingPointRange<Float>> =
+            buildMap {
+                LEGACY_DEFAULTS.keys.forEach { put(it, 0f..ToneCurve.MAX_VALUE) }
+                Channel.entries.forEach { channel ->
+                    put(countKey(channel), ToneCurve.MIN_POINTS.toFloat()..ToneCurve.MAX_POINTS.toFloat())
+                    for (index in 0 until ToneCurve.MAX_POINTS) {
+                        put(xKey(channel, index), 0f..ToneCurve.MAX_VALUE)
+                        put(yKey(channel, index), 0f..ToneCurve.MAX_VALUE)
+                    }
+                }
+            }
+
+        /** The curves stored in [parameters]; anything missing or malformed is a straight line. */
+        fun decode(parameters: Map<String, Float>): CurveSet =
+            CurveSet(
+                gamma = channel(parameters, Channel.GAMMA) ?: legacy(parameters),
+                red = channel(parameters, Channel.RED) ?: ToneCurve.IDENTITY,
+                green = channel(parameters, Channel.GREEN) ?: ToneCurve.IDENTITY,
+                blue = channel(parameters, Channel.BLUE) ?: ToneCurve.IDENTITY,
+            )
+
+        private fun channel(
+            parameters: Map<String, Float>,
+            channel: Channel,
+        ): ToneCurve? {
+            val count = parameters[countKey(channel)]?.takeIf { it.isFinite() }?.roundToInt() ?: return null
+            if (count !in ToneCurve.MIN_POINTS..ToneCurve.MAX_POINTS) return null
+            val points = ArrayList<ToneCurve.Point>(count)
+            for (index in 0 until count) {
+                val x = parameters[xKey(channel, index)]?.takeIf { it.isFinite() }
+                val y = parameters[yKey(channel, index)]?.takeIf { it.isFinite() }
+                if (x == null || y == null) return null
+                points += ToneCurve.Point(x.coerceIn(0f, ToneCurve.MAX_VALUE), y.coerceIn(0f, ToneCurve.MAX_VALUE))
+            }
+            return ToneCurve(points.sortedBy { it.x })
+        }
+
+        /** The curve of a map from before per-channel curves: its points over the old defaults, sorted by input. */
+        private fun legacy(parameters: Map<String, Float>): ToneCurve {
+            val merged = LEGACY_DEFAULTS + parameters
+            val points =
+                (0..4)
+                    .mapNotNull { index ->
+                        val x = merged["point_${index}_x"] ?: return@mapNotNull null
+                        val y = merged["point_${index}_y"] ?: return@mapNotNull null
+                        ToneCurve.Point(x.coerceIn(0f, ToneCurve.MAX_VALUE), y.coerceIn(0f, ToneCurve.MAX_VALUE))
+                    }.sortedBy { it.x }
+            return ToneCurve(points)
+        }
+    }
+}
