@@ -0,0 +1,19 @@
+package com.artflow.studio.core.pixels
+
+/** Position hashing for effects that need randomness that is the same on every run, preview and commit alike. */
+internal object PixelHash {
+    /** A well-mixed non-negative hash of three integers. */
+    fun hash(
+        a: Int,
+        b: Int,
+        c: Int,
+    ): Int {
+        var h = a * 374761393 + b * 668265263 + c * 1274126177
+        h = (h xor (h ushr 13)) * 1103515245
+        h = h xor (h ushr 16)
+        return h and 0x7FFFFFFF
+    }
+
+    /** [h] as a fraction from 0 (inclusive) to 1 (exclusive). */
+    fun unit(h: Int): Float = (h and 0xFFFFFF) / 16777216f
+}
