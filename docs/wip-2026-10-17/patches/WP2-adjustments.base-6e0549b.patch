@@ -0,0 +1,253 @@
+package com.artflow.studio.core.pixels
+
+import com.artflow.studio.core.pixels.AdjustmentOptions.NoiseMode
+import kotlin.math.PI
+import kotlin.math.abs
+import kotlin.math.cos
+import kotlin.math.floor
+import kotlin.math.ln
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.roundToInt
+import kotlin.math.sin
+
+/**
+ * Procreate-style Noise. Clouds, Billow and Ridges are fractal Perlin noise (several octaves, each twice as fine as the
+ * last and weaker by the Roughness factor): soft clouds, puffy billows, or sharp ridges. White is per-pixel grain. The
+ * fractal noise tiles: its lattice repeats exactly across the canvas, so the image's opposite edges join seamlessly.
+ * Grey noise moves all three channels together; colour noise gives each its own field. The amount sets the strength.
+ */
+internal object NoiseEffect {
+    /** Feature size as a fraction of the canvas's shorter side at Scale 0, and the extra at Scale 1 (squared). */
+    private const val FINEST_FEATURE = 0.01f
+    private const val FEATURE_RANGE = 0.5f
+
+    /** Octaves finer than this many pixels only alias, so they are left out. */
+    private const val FINEST_WAVELENGTH = 2f
+
+    /** The field is sampled on a grid this many times finer than the finest octave, then interpolated. */
+    private const val SAMPLES_PER_WAVELENGTH = 3f
+    private const val MAX_GRID_STEP = 16
+
+    /** Channel levels a full-strength noise value moves a pixel. */
+    private const val LEVELS = 140f
+
+    /** Average of |noise| and of the ridge shape, so Billow and Ridges neither darken nor lighten the image overall. */
+    private const val BILLOW_MEAN = 0.178f
+    private const val RIDGES_MEAN = 0.546f
+
+    private const val GRADIENTS = 16
+    private val GRADIENT_X = FloatArray(GRADIENTS) { cos(2.0 * PI * it / GRADIENTS).toFloat() }
+    private val GRADIENT_Y = FloatArray(GRADIENTS) { sin(2.0 * PI * it / GRADIENTS).toFloat() }
+
+    fun apply(
+        source: PixelBuffer,
+        amount: Float,
+        mode: NoiseMode,
+        field: Field,
+        colour: Boolean,
+        checkpoint: () -> Unit,
+    ): PixelBuffer {
+        if (mode == NoiseMode.WHITE) return ImageFilters.addNoise(source, amount, monochrome = !colour, checkpoint = checkpoint)
+        val channels = if (colour) 3 else 1
+        val sampler = GridSampler(source.width, field, mode, channels)
+        val out = source.copy()
+        val values = FloatArray(channels)
+        val strength = amount.coerceIn(0f, 1f) * LEVELS
+        for (y in 0 until source.height) {
+            checkpoint()
+            sampler.moveTo(y)
+            for (x in 0 until source.width) {
+                val index = y * source.width + x
+                val pixel = source.pixels[index]
+                if ((pixel ushr 24) == 0) continue
+                sampler.values(x, values)
+                out.pixels[index] = shift(pixel, values, strength)
+            }
+        }
+        return out
+    }
+
+    private fun shift(
+        pixel: Int,
+        values: FloatArray,
+        strength: Float,
+    ): Int {
+        val red = values[0] * strength
+        val green = values[min(1, values.size - 1)] * strength
+        val blue = values[min(2, values.size - 1)] * strength
+        return Channels.argb(
+            pixel ushr 24,
+            (((pixel shr 16) and 0xFF) + red).roundToInt().coerceIn(0, 255),
+            (((pixel shr 8) and 0xFF) + green).roundToInt().coerceIn(0, 255),
+            ((pixel and 0xFF) + blue).roundToInt().coerceIn(0, 255),
+        )
+    }
+
+    /**
+     * The fractal noise's settings for a canvas: the lattice cells across and down (so the field tiles), how many
+     * octaves are worth computing, and the weight of each octave relative to the one before.
+     */
+    class Field(
+        val width: Int,
+        val height: Int,
+        scale: Float,
+        octaves: Int,
+        roughness: Float,
+    ) {
+        val feature = min(width, height) * (FINEST_FEATURE + FEATURE_RANGE * scale.coerceIn(0f, 1f).let { it * it })
+        val cellsAcross = max(1, (width / feature).roundToInt())
+        val cellsDown = max(1, (height / feature).roundToInt())
+        val octaves = octaves.coerceIn(1, max(1, 1 + floor(ln(feature / FINEST_WAVELENGTH) / ln(2f)).toInt()))
+        val persistence = 0.25f + 0.5f * roughness.coerceIn(0f, 1f)
+
+        /** Grid spacing, in pixels, fine enough for the finest octave. */
+        val gridStep: Int = ((feature / (1 shl (this.octaves - 1))) / SAMPLES_PER_WAVELENGTH).toInt().coerceIn(1, MAX_GRID_STEP)
+
+        /** The fractal value at pixel position ([x], [y]) for [channel], roughly -1..1. */
+        fun value(
+            x: Float,
+            y: Float,
+            mode: NoiseMode,
+            channel: Int,
+        ): Float {
+            var sum = 0f
+            var weight = 1f
+            var total = 0f
+            var across = cellsAcross
+            var down = cellsDown
+            for (octave in 0 until octaves) {
+                val n = perlin(x / width * across, y / height * down, across, down, channel * 92821 + octave * 68917)
+                sum += weight * shape(n, mode)
+                total += weight
+                weight *= persistence
+                across *= 2
+                down *= 2
+            }
+            return finish(sum / total, mode)
+        }
+
+        private fun shape(
+            n: Float,
+            mode: NoiseMode,
+        ): Float =
+            when (mode) {
+                NoiseMode.BILLOW -> abs(n)
+                NoiseMode.RIDGES -> (1f - abs(n) * 1.6f).coerceAtLeast(0f).let { it * it }
+                else -> n
+            }
+
+        /** Centres each shape on zero (the averages measured over many fields) and scales it to about the same spread. */
+        private fun finish(
+            value: Float,
+            mode: NoiseMode,
+        ): Float =
+            when (mode) {
+                NoiseMode.BILLOW -> (value - BILLOW_MEAN) * 3.6f
+                NoiseMode.RIDGES -> (value - RIDGES_MEAN) * 1.8f
+                else -> value * 2.2f
+            }.coerceIn(-1f, 1f)
+    }
+
+    /**
+     * Samples a [Field] on a grid of [Field.gridStep] pixels and interpolates between grid rows, holding just two grid
+     * rows per channel, so memory stays proportional to the canvas width.
+     */
+    private class GridSampler(
+        width: Int,
+        private val field: Field,
+        private val mode: NoiseMode,
+        private val channels: Int,
+    ) {
+        private val step = field.gridStep
+        private val columns = width / step + 2
+        private var above = Array(channels) { FloatArray(columns) }
+        private var below = Array(channels) { FloatArray(columns) }
+        private var gridRow = -1
+        private var rowWeight = 0f
+
+        fun moveTo(y: Int) {
+            val row = y / step
+            if (row != gridRow) {
+                if (row == gridRow + 1) {
+                    val swap = above
+                    above = below
+                    below = swap
+                } else {
+                    fill(above, row)
+                }
+                fill(below, row + 1)
+                gridRow = row
+            }
+            rowWeight = (y - row * step) / step.toFloat()
+        }
+
+        fun values(
+            x: Int,
+            out: FloatArray,
+        ) {
+            val column = x / step
+            val t = (x - column * step) / step.toFloat()
+            for (c in 0 until channels) {
+                val top = above[c][column] + (above[c][column + 1] - above[c][column]) * t
+                val bottom = below[c][column] + (below[c][column + 1] - below[c][column]) * t
+                out[c] = top + (bottom - top) * rowWeight
+            }
+        }
+
+        private fun fill(
+            target: Array<FloatArray>,
+            row: Int,
+        ) {
+            val y = row * step + 0.5f
+            for (c in 0 until channels) {
+                for (column in 0 until columns) target[c][column] = field.value(column * step + 0.5f, y, mode, c)
+            }
+        }
+    }
+
+    /** Tileable 2D gradient noise: the lattice repeats every [periodX] by [periodY] cells. Roughly -0.7..0.7. */
+    fun perlin(
+        x: Float,
+        y: Float,
+        periodX: Int,
+        periodY: Int,
+        seed: Int,
+    ): Float {
+        val x0 = floor(x).toInt()
+        val y0 = floor(y).toInt()
+        val fx = x - x0
+        val fy = y - y0
+        val ix0 = wrap(x0, periodX)
+        val ix1 = wrap(x0 + 1, periodX)
+        val iy0 = wrap(y0, periodY)
+        val iy1 = wrap(y0 + 1, periodY)
+        val n00 = gradient(ix0, iy0, seed, fx, fy)
+        val n10 = gradient(ix1, iy0, seed, fx - 1f, fy)
+        val n01 = gradient(ix0, iy1, seed, fx, fy - 1f)
+        val n11 = gradient(ix1, iy1, seed, fx - 1f, fy - 1f)
+        val u = fade(fx)
+        val v = fade(fy)
+        val top = n00 + (n10 - n00) * u
+        val bottom = n01 + (n11 - n01) * u
+        return top + (bottom - top) * v
+    }
+
+    private fun gradient(
+        ix: Int,
+        iy: Int,
+        seed: Int,
+        dx: Float,
+        dy: Float,
+    ): Float {
+        val h = PixelHash.hash(ix, iy, seed) and (GRADIENTS - 1)
+        return GRADIENT_X[h] * dx + GRADIENT_Y[h] * dy
+    }
+
+    private fun fade(t: Float): Float = t * t * t * (t * (t * 6f - 15f) + 10f)
+
+    private fun wrap(
+        value: Int,
+        period: Int,
+    ): Int = ((value % period) + period) % period
+}
