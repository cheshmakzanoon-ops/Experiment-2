+package com.artflow.studio.core.pixels
+
+import com.artflow.studio.core.pixels.AdjustmentOptions.AberrationMode
+import com.artflow.studio.core.pixels.AdjustmentOptions.GlitchMode
+import com.artflow.studio.core.pixels.AdjustmentOptions.HalftoneMode
+import com.artflow.studio.core.pixels.AdjustmentOptions.NoiseMode
+import com.artflow.studio.core.pixels.AdjustmentOptions.PerspectiveMode
+import com.artflow.studio.core.pixels.LiveAdjustments.Kind
+import com.artflow.studio.core.pixels.LiveAdjustments.Settings
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.math.abs
+
+class LiveEffectsTest {
+    private class Superseded : RuntimeException()
+
+    /** A colourful, partly translucent picture with a bright spot, sharp edges and a dark block. */
+    private fun picture(
+        width: Int = 48,
+        height: Int = 40,
+    ): PixelBuffer =
+        PixelBuffer(width, height).also { buffer ->
+            for (y in 0 until height) {
+                for (x in 0 until width) {
+                    val alpha =
+                        when {
+                            x > width - 6 && y < 6 -> 0
+                            y > height - 4 -> 120
+                            else -> 255
+                        }
+                    val bright = (x - 30) * (x - 30) + (y - 12) * (y - 12) < 30
+                    val dark = x in 6..14 && y in 20..30
+                    buffer.pixels[y * width + x] =
+                        when {
+                            bright -> Channels.argb(alpha, 255, 255, 240)
+                            dark -> Channels.argb(alpha, 20, 20, 30)
+                            else -> Channels.argb(alpha, x * 255 / width, y * 255 / height, 128)
+                        }
+                }
+            }
+        }
+
+    /** Every live effect in every mode, with settings that change the picture. */
+    private val cases: List<Pair<Kind, Settings>> =
+        buildList {
+            add(Kind.BLOOM to Settings(0.8f, mapOf(AdjustmentOptions.BLOOM_TRANSITION to 0.8f, AdjustmentOptions.BLOOM_BURN to 0.5f)))
+            GlitchMode.entries.forEach { add(Kind.GLITCH to Settings(0.7f, mapOf(AdjustmentOptions.GLITCH_MODE to it.ordinal.toFloat()))) }
+            HalftoneMode.entries.forEach {
+                add(Kind.HALFTONE to Settings(0.3f, mapOf(AdjustmentOptions.HALFTONE_MODE to it.ordinal.toFloat())))
+            }
+            NoiseMode.entries.forEach { mode ->
+                listOf(0f, 1f).forEach { colour ->
+                    val parameters = mapOf(AdjustmentOptions.NOISE_MODE to mode.ordinal.toFloat(), AdjustmentOptions.NOISE_COLOUR to colour)
+                    add(Kind.NOISE to Settings(0.6f, parameters))
+                }
+            }
+            AberrationMode.entries.forEach {
+                val parameters = mapOf(AdjustmentOptions.ABERRATION_MODE to it.ordinal.toFloat())
+                add(Kind.CHROMATIC_ABERRATION to Settings(1f, parameters, angleDegrees = 30f))
+            }
+            PerspectiveMode.entries.forEach {
+                add(Kind.PERSPECTIVE_BLUR to Settings(0.8f, mapOf(AdjustmentOptions.PERSPECTIVE_MODE to it.ordinal.toFloat())))
+            }
+        }
+
+    private fun label(
+        kind: Kind,
+        settings: Settings,
+    ) = "$kind ${settings.parameters}"
+
+    @Test
+    fun theSameSettingsAlwaysGiveTheSamePixels() {
+        val source = picture()
+        cases.forEach { (kind, settings) ->
+            val first = LiveAdjustments.apply(kind, source, settings)
+            val second = LiveAdjustments.apply(kind, picture(), settings)
+            assertArrayEquals(label(kind, settings), first.pixels, second.pixels)
+        }
+    }
+
+    @Test
+    fun everyModeChangesThePictureAndNoneTouchesItsSource() {
+        cases.forEach { (kind, settings) ->
+            val source = picture()
+            val out = LiveAdjustments.apply(kind, source, settings)
+            assertFalse(label(kind, settings), out.pixels.contentEquals(source.pixels))
+            assertArrayEquals(label(kind, settings), picture().pixels, source.pixels)
+        }
+    }
+
+    @Test
+    fun noAmountLeavesEveryModeAlone() {
+        val source = picture()
+        cases.forEach { (kind, settings) ->
+            val out = LiveAdjustments.apply(kind, source, settings.copy(amount = 0f))
+            assertArrayEquals(label(kind, settings), source.pixels, out.pixels)
+        }
+    }
+
+    @Test
+    fun pixelsOutsideTheSelectionStayAsTheyWere() {
+        val source = picture()
+        val selection = SelectionMask(source.width, source.height)
+        for (i in 0 until source.width * 20) selection.coverage[i] = -1
+        cases.forEach { (kind, settings) ->
+            val out = LiveAdjustments.apply(kind, source, settings, selection)
+            for (i in source.width * 20 until source.pixels.size) assertEquals(label(kind, settings), source.pixels[i], out.pixels[i])
+        }
+    }
+
+    @Test
+    fun alphaLockKeepsEveryPixelsCoverage() {
+        val source = picture()
+        cases.forEach { (kind, settings) ->
+            val out = LiveAdjustments.apply(kind, source, settings, alphaLocked = true)
+            for (i in source.pixels.indices) assertEquals(label(kind, settings), source.pixels[i] ushr 24, out.pixels[i] ushr 24)
+        }
+    }
+
+    @Test
+    fun colourEffectsKeepAlphaEvenWithoutAlphaLock() {
+        val source = picture()
+        cases.filter { it.first == Kind.HALFTONE || it.first == Kind.NOISE }.forEach { (kind, settings) ->
+            val out = LiveAdjustments.apply(kind, source, settings)
+            for (i in source.pixels.indices) assertEquals(label(kind, settings), source.pixels[i] ushr 24, out.pixels[i] ushr 24)
+        }
+    }
+
+    @Test
+    fun aThrowFromTheCheckpointStopsEveryEffectPartWay() {
+        cases.forEach { (kind, settings) ->
+            var calls = 0
+            assertThrows(label(kind, settings), Superseded::class.java) {
+                LiveAdjustments.apply(kind, picture(400, 300), settings, checkpoint = { if (++calls == 5) throw Superseded() })
+            }
+            assertEquals(label(kind, settings), 5, calls)
+        }
+    }
+
+    @Test
+    fun colourAdjustmentsCheckInOncePerRow() {
+        var calls = 0
+        LiveAdjustments.apply(Kind.CURVES, picture(), Settings(1f, CurveSet.IDENTITY.encode()), checkpoint = { calls++ })
+        assertEquals(40, calls)
+    }
+
+    @Test
+    fun anotherGlitchSeedGivesAnotherPattern() {
+        val settings = Settings(0.8f, mapOf(AdjustmentOptions.GLITCH_MODE to GlitchMode.ARTIFACT.ordinal.toFloat()))
+        val first = LiveAdjustments.apply(Kind.GLITCH, picture(), settings)
+        val reseed = settings.copy(parameters = settings.parameters + (AdjustmentOptions.GLITCH_SEED to 7f))
+        val reseeded = LiveAdjustments.apply(Kind.GLITCH, picture(), reseed)
+        assertFalse(first.pixels.contentEquals(reseeded.pixels))
+    }
+
+    @Test
+    fun aWiderBloomReachesFarther() {
+        val source = PixelBuffer.filled(80, 80, 0xFF000000.toInt())
+        for (y in 36..44) for (x in 36..44) source.pixels[y * 80 + x] = -1
+
+        fun glowAt(size: Float): Int {
+            val settings = Settings(1f, mapOf(AdjustmentOptions.BLOOM_SIZE to size, AdjustmentOptions.BLOOM_TRANSITION to 0.5f))
+            return LiveAdjustments.apply(Kind.BLOOM, source, settings).pixels[40 * 80 + 52] and 0xFF
+        }
+        assertTrue("${glowAt(0f)} vs ${glowAt(1f)}", glowAt(1f) > glowAt(0f))
+    }
+
+    @Test
+    fun greyNoiseKeepsGreyPixelsGreyAndColourNoiseDoesNot() {
+        val grey = PixelBuffer.filled(32, 32, 0xFF808080.toInt())
+        val mono = LiveAdjustments.apply(Kind.NOISE, grey, Settings(0.8f))
+        assertTrue(mono.pixels.all { ((it shr 16) and 0xFF) == (it and 0xFF) && ((it shr 8) and 0xFF) == (it and 0xFF) })
+        val colour = LiveAdjustments.apply(Kind.NOISE, grey, Settings(0.8f, mapOf(AdjustmentOptions.NOISE_COLOUR to 1f)))
+        assertTrue(colour.pixels.any { ((it shr 16) and 0xFF) != (it and 0xFF) })
+    }
+
+    @Test
+    fun fractalNoiseTilesAcrossTheCanvas() {
+        val field = NoiseEffect.Field(200, 120, 0.3f, 5, 0.6f)
+        for (y in 0 until 120 step 7) {
+            assertEquals(field.value(0f, y.toFloat(), NoiseMode.CLOUDS, 0), field.value(200f, y.toFloat(), NoiseMode.CLOUDS, 0), 1e-4f)
+        }
+        for (x in 0 until 200 step 9) {
+            assertEquals(field.value(x.toFloat(), 0f, NoiseMode.RIDGES, 1), field.value(x.toFloat(), 120f, NoiseMode.RIDGES, 1), 1e-4f)
+        }
+    }
+
+    @Test
+    fun billowsAndRidgesNeitherDarkenNorLightenOnAverage() {
+        val grey = PixelBuffer.filled(256, 256, 0xFF808080.toInt())
+        NoiseMode.entries.forEach { mode ->
+            val out = LiveAdjustments.apply(Kind.NOISE, grey, Settings(1f, mapOf(AdjustmentOptions.NOISE_MODE to mode.ordinal.toFloat())))
+            val mean = out.pixels.map { (it and 0xFF) - 128 }.average()
+            assertTrue("$mode mean $mean", abs(mean) < 12)
+        }
+    }
+
+    @Test
+    fun perspectiveAberrationLeavesItsCentreAlone() {
+        val source = picture()
+        val settings = Settings(1f, mapOf(LiveAdjustments.RECOLOR_X to 30.5f, LiveAdjustments.RECOLOR_Y to 20.5f))
+        val out = LiveAdjustments.apply(Kind.CHROMATIC_ABERRATION, source, settings)
+        assertEquals(source.pixels[20 * source.width + 30], out.pixels[20 * source.width + 30])
+        assertFalse(out.pixels.contentEquals(source.pixels))
+    }
+
+    @Test
+    fun displacedAberrationMovesRedAndBlueOppositeWays() {
+        // A white bar on black: red shifts one way along the angle and blue the other.
+        val source = PixelBuffer.filled(60, 60, 0xFF000000.toInt())
+        for (y in 0 until 60) for (x in 25 until 35) source.pixels[y * 60 + x] = -1
+        val displace = Settings(1f, mapOf(AdjustmentOptions.ABERRATION_MODE to 1f), angleDegrees = 0f)
+        val out = LiveAdjustments.apply(Kind.CHROMATIC_ABERRATION, source, displace)
+        val leftOfBar = out.pixels[5 * 60 + 24]
+        val rightOfBar = out.pixels[5 * 60 + 35]
+        assertTrue((leftOfBar and 0xFF) > 200 && ((leftOfBar shr 16) and 0xFF) < 50)
+        assertTrue(((rightOfBar shr 16) and 0xFF) > 200 && (rightOfBar and 0xFF) < 50)
+    }
+
+    @Test
+    fun directionalPerspectiveBlurStreaksAlongItsAngle() {
+        // A vertical edge far from the focus point: horizontal streaks smear it, vertical ones do not.
+        val source = PixelBuffer.filled(60, 60, 0xFF000000.toInt())
+        for (y in 0 until 60) for (x in 45 until 60) source.pixels[y * 60 + x] = -1
+
+        fun blurred(angle: Float) =
+            LiveAdjustments.apply(
+                Kind.PERSPECTIVE_BLUR,
+                source,
+                Settings(
+                    1f,
+                    mapOf(AdjustmentOptions.PERSPECTIVE_MODE to 1f, AdjustmentOptions.PERSPECTIVE_ANGLE to angle, "x" to 5f, "y" to 30f),
+                ),
+            )
+        val across = blurred(0f).pixels[30 * 60 + 43] and 0xFF
+        val along = blurred(90f).pixels[30 * 60 + 43] and 0xFF
+        assertTrue("across $across along $along", across > 40 && along == 0)
+    }
+
+    @Test
+    fun halftoneDotsAreBlackOnWhitePaperForNewspaper() {
+        val grey = PixelBuffer.filled(120, 120, 0xFF808080.toInt())
+        val newspaper = mapOf(AdjustmentOptions.HALFTONE_MODE to 2f, AdjustmentOptions.HALFTONE_SHARPNESS to 1f)
+        val out = LiveAdjustments.apply(Kind.HALFTONE, grey, Settings(1f, newspaper))
+        assertTrue(out.pixels.any { (it and 0xFFFFFF) == 0 })
+        assertTrue(out.pixels.any { (it and 0xFFFFFF) == 0xFFFFFF })
+        // About as much ink as the grey it stands for.
+        val mean = out.pixels.map { it and 0xFF }.average()
+        assertTrue("mean $mean", abs(mean - 128) < 20)
+    }
+}
