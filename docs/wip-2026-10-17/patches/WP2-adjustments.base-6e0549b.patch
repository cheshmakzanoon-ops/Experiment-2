index 0000000..d02f165
--- /dev/null
+++ b/app/src/main/java/com/artflow/studio/core/pixels/ChromaticAberration.kt
@@ -0,0 +1,105 @@
+package com.artflow.studio.core.pixels
+
+import kotlin.math.cos
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.pow
+import kotlin.math.sin
+import kotlin.math.sqrt
+
+/**
+ * Procreate's Chromatic Aberration. Perspective spreads red outward and blue inward from a centre point, more the farther
+ * a pixel is from it (Falloff keeps the middle cleaner and pushes the fringes to the edges); Displace offsets red and blue
+ * in opposite directions along one angle. A bright edge's fringe can spill onto transparent pixels (see [combine]), and
+ * samples beyond the canvas repeat its edge.
+ */
+internal object ChromaticAberration {
+    /** Largest radial spread at amount 1, as a fraction of a pixel's distance from the centre. */
+    private const val MAX_SPREAD = 0.05f
+
+    /** Largest Displace offset at amount 1, as a fraction of the canvas's shorter side. */
+    private const val MAX_OFFSET = 0.03f
+
+    fun perspective(
+        source: PixelBuffer,
+        amount: Float,
+        centreX: Float,
+        centreY: Float,
+        falloff: Float,
+        checkpoint: () -> Unit,
+    ): PixelBuffer {
+        val spread = amount.coerceIn(0f, 1f) * MAX_SPREAD
+        val power = 2f * falloff.coerceIn(0f, 1f)
+        val reach = max(1f, sqrt(source.width * source.width + source.height * source.height.toFloat()) / 2f)
+        val out = PixelBuffer(source.width, source.height)
+        for (y in 0 until source.height) {
+            checkpoint()
+            for (x in 0 until source.width) {
+                val dx = x + 0.5f - centreX
+                val dy = y + 0.5f - centreY
+                val k = if (power > 0f) spread * (sqrt(dx * dx + dy * dy) / reach).pow(power) else spread
+                out.pixels[y * source.width + x] =
+                    combine(
+                        sample(source, centreX + dx * (1f + k), centreY + dy * (1f + k)),
+                        sample(source, x + 0.5f, y + 0.5f),
+                        sample(source, centreX + dx * (1f - k), centreY + dy * (1f - k)),
+                    )
+            }
+        }
+        return out
+    }
+
+    fun displace(
+        source: PixelBuffer,
+        amount: Float,
+        angleDegrees: Float,
+        checkpoint: () -> Unit,
+    ): PixelBuffer {
+        val distance = amount.coerceIn(0f, 1f) * MAX_OFFSET * min(source.width, source.height)
+        val radians = Math.toRadians(angleDegrees.toDouble())
+        val offsetX = (cos(radians) * distance).toFloat()
+        val offsetY = (sin(radians) * distance).toFloat()
+        val out = PixelBuffer(source.width, source.height)
+        for (y in 0 until source.height) {
+            checkpoint()
+            for (x in 0 until source.width) {
+                val px = x + 0.5f
+                val py = y + 0.5f
+                out.pixels[y * source.width + x] =
+                    combine(
+                        sample(source, px - offsetX, py - offsetY),
+                        source.pixels[y * source.width + x],
+                        sample(source, px + offsetX, py + offsetY),
+                    )
+            }
+        }
+        return out
+    }
+
+    private fun sample(
+        source: PixelBuffer,
+        x: Float,
+        y: Float,
+    ): Int = source.sampleBilinear(x.coerceIn(0.5f, source.width - 0.5f), y.coerceIn(0.5f, source.height - 0.5f))
+
+    /**
+     * Red from [red], green from [green] and blue from [blue]. The green sample keeps the layer's coverage; the red and
+     * blue samples add coverage only as far as they carry light in their own channel, so a bright edge can throw a
+     * coloured fringe onto transparent pixels without dark ghosts of the other channels, and dark line art stays as it is.
+     */
+    fun combine(
+        red: Int,
+        green: Int,
+        blue: Int,
+    ): Int {
+        val ra = red ushr 24
+        val ga = green ushr 24
+        val ba = blue ushr 24
+        val r = (red shr 16) and 0xFF
+        val g = (green shr 8) and 0xFF
+        val b = blue and 0xFF
+        val alpha = max(ga, max(ra * r / 255, ba * b / 255))
+        if (alpha == 0) return 0
+        return Channels.argb(alpha, min(255, r * ra / alpha), min(255, g * ga / alpha), min(255, b * ba / alpha))
+    }
+}
