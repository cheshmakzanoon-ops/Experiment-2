@@ -0,0 +1,129 @@
+package com.artflow.studio.data
+
+import android.content.Context
+import com.artflow.studio.core.pixels.PixelBuffer
+import com.artflow.studio.core.text.TextLayerContent
+import com.artflow.studio.core.text.TextLayout
+import com.artflow.studio.data.local.ProjectStorage
+import com.artflow.studio.data.repository.canvas.CanvasRepositoryImpl
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.test.UnconfinedTestDispatcher
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import org.junit.After
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.mockito.Mockito.mock
+import kotlin.random.Random
+
+/**
+ * The history keeps steps deeper than the old 30-step limit as tile deltas; undoing and redoing all
+ * of them must still give back every earlier document exactly. Real document operations; only the
+ * Android Context and main dispatcher are replaced.
+ */
+@OptIn(ExperimentalCoroutinesApi::class)
+class DeepUndoTest {
+    private lateinit var repository: CanvasRepositoryImpl
+
+    @Before
+    fun setUp() {
+        Dispatchers.setMain(UnconfinedTestDispatcher())
+        repository = CanvasRepositoryImpl(ProjectStorage(mock(Context::class.java)))
+    }
+
+    @After
+    fun tearDown() {
+        repository.dispose()
+        Dispatchers.resetMain()
+    }
+
+    /** What the document looks like: its layers (with whether they have a mask), their pixels, and the composite. */
+    private class State(
+        val layers: List<Pair<Long, Boolean>>,
+        /** Null for a layer that has no pixels yet. */
+        val pixels: List<IntArray?>,
+        val composite: IntArray,
+    )
+
+    private suspend fun state(): State =
+        State(
+            repository.getAllLayers().map { it.id to it.hasMask() },
+            repository.getAllLayers().map { repository.layerPixels(it.id)?.pixels },
+            requireNotNull(repository.compositeFrame(0, transparentBackground = true)).pixels,
+        )
+
+    private fun assertSameState(
+        label: String,
+        expected: State,
+        actual: State,
+    ) {
+        assertEquals(label, expected.layers, actual.layers)
+        expected.pixels.zip(actual.pixels).forEach { (want, got) -> assertArrayEquals(label, want, got) }
+        assertArrayEquals(label, expected.composite, actual.composite)
+    }
+
+    private suspend fun dab(
+        layerId: Long,
+        random: Random,
+    ) {
+        val pixels = requireNotNull(repository.layerPixels(layerId))
+        val x = random.nextInt(pixels.width - 6)
+        val y = random.nextInt(pixels.height - 6)
+        val colour = random.nextInt() or 0xFF000000.toInt()
+        for (py in y until y + 6) for (px in x until x + 6) pixels.setUnchecked(px, py, colour)
+        assertTrue(repository.setLayerPixels(layerId, pixels, "Dab"))
+    }
+
+    @Test
+    fun everyStepOfALongSessionUndoesAndRedoesExactly() =
+        runTest {
+            // 260 x 130 spans 5 x 3 tiles, so most steps change one or two tiles of one layer.
+            repository.createCanvas(260, 130, 72)
+            val random = Random(17)
+            val states = mutableListOf(state())
+            repeat(60) { step ->
+                val layers = repository.getAllLayers()
+                when {
+                    step % 15 == 4 -> repository.addLayer("Layer $step")
+                    step % 15 == 9 -> assertTrue(repository.addLayerMask(layers.last().id))
+                    step % 15 == 14 && layers.size > 2 -> assertTrue(repository.removeLayer(layers[1].id))
+                    else -> dab(layers[random.nextInt(layers.size)].id, random)
+                }
+                states += state()
+            }
+            assertEquals("Sixty steps fit where thirty used to", 60, repository.undoDepth)
+            states.asReversed().drop(1).forEachIndexed { index, expected ->
+                assertTrue(repository.undo())
+                assertSameState("undo ${index + 1}", expected, state())
+            }
+            assertFalse(repository.undo())
+            states.drop(1).forEachIndexed { index, expected ->
+                assertTrue(repository.redo())
+                assertSameState("redo ${index + 1}", expected, state())
+            }
+            assertFalse(repository.redo())
+        }
+
+    @Test
+    fun aTextLayerStaysEditableThroughDeepUndo() =
+        runTest {
+            repository.createCanvas(200, 150, 72)
+            val text = TextLayerContent("Hi", TextLayout.TextStyle(), 0xFFFF0000.toInt(), 0f, 0f)
+            val glyphs = PixelBuffer(200, 150).also { it.setUnchecked(10, 10, 0xFF000000.toInt()) }
+            val layer = requireNotNull(repository.addTextLayer(text, glyphs))
+            val background = repository.getAllLayers().first().id
+            val random = Random(3)
+            repeat(12) { dab(background, random) }
+            repeat(12) { assertTrue(repository.undo()) }
+            val restored = repository.getAllLayers().first { it.id == layer }
+            assertNotNull("Moving through the history must not turn text into pixels", restored.textContent)
+            assertArrayEquals(glyphs.pixels, requireNotNull(repository.layerPixels(layer)).pixels)
+        }
+}
