@@ -0,0 +1,61 @@
+package com.artflow.studio.core.animation
+
+import kotlin.math.floor
+import kotlin.math.max
+import kotlin.math.min
+
+/**
+ * The index and scroll arithmetic behind the timeline strip's touch handling (scrubbing,
+ * reordering and keeping the current frame in view), kept out of the composable so it can be
+ * tested. All distances are in pixels. There is no timeline strip yet; this is the part of it that
+ * can be checked without a device.
+ */
+object TimelineStrip {
+    /**
+     * The frame under a pointer [x] pixels from the strip's left edge when the strip is scrolled by
+     * [scrollPx]. Frame tiles sit [extentPx] apart (tile plus gap) and the first one starts
+     * [startPx] in. Dragging past either end gives the first or last frame.
+     */
+    fun indexAt(
+        x: Float,
+        scrollPx: Float,
+        extentPx: Float,
+        startPx: Float,
+        count: Int,
+    ): Int {
+        if (count <= 0 || extentPx <= 0f) return 0
+        return floor((x + scrollPx - startPx) / extentPx).toInt().coerceIn(0, count - 1)
+    }
+
+    /**
+     * How far to scroll per animation frame while a finger is held at [x] in a strip [viewportPx]
+     * wide: nothing in the middle, then faster as it nears an edge, up to [maxStepPx] at the edge.
+     * Negative scrolls towards the start. Lets one drag reach frames that are off screen.
+     */
+    fun edgeScroll(
+        x: Float,
+        viewportPx: Float,
+        edgePx: Float,
+        maxStepPx: Float,
+    ): Float {
+        if (edgePx <= 0f || viewportPx <= 2 * edgePx) return 0f
+        val fromStart = max(0f, edgePx - x)
+        val fromEnd = max(0f, x - (viewportPx - edgePx))
+        return maxStepPx * (min(fromEnd, edgePx) - min(fromStart, edgePx)) / edgePx
+    }
+
+    /**
+     * The first tile to scroll to so that [active] is visible when tiles [firstVisible]..[lastVisible]
+     * are showing, or null when it already is. A frame off to the right ends up the last one showing.
+     */
+    fun revealFrom(
+        active: Int,
+        firstVisible: Int,
+        lastVisible: Int,
+    ): Int? =
+        when {
+            active < firstVisible -> active
+            active > lastVisible -> max(0, active - (lastVisible - firstVisible))
+            else -> null
+        }
+}
