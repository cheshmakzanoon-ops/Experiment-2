+package com.artflow.studio.core.animation
+
+import com.artflow.studio.domain.model.animation.AnimationFrame
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class HoldDurationTest {
+    @Test
+    fun aFrameHeldForOneFrameLastsOneFrameTime() {
+        // 12 fps is 83 ms a frame.
+        assertEquals(83, HoldDuration.duration(1, 12))
+        assertEquals(1, HoldDuration.frames(83, 12))
+    }
+
+    @Test
+    fun longerHoldsAreWholeMultiplesOfTheFrameTime() {
+        assertEquals(3 * 83, HoldDuration.duration(3, 12))
+        assertEquals(3, HoldDuration.frames(3 * 83, 12))
+    }
+
+    @Test
+    fun aHoldSetByTheExactTimeSliderRoundsToTheNearestFrame() {
+        assertEquals(2, HoldDuration.frames(150, 12))
+        // Just over and just under one and a half frames of 83 ms.
+        assertEquals(2, HoldDuration.frames(125, 12))
+        assertEquals(1, HoldDuration.frames(124, 12))
+        assertEquals(1, HoldDuration.frames(100, 12))
+    }
+
+    @Test
+    fun aHoldIsNeverLessThanOneFrame() {
+        assertEquals(1, HoldDuration.frames(16, 12))
+        assertEquals(83, HoldDuration.duration(0, 12))
+        assertEquals(83, HoldDuration.duration(-4, 12))
+    }
+
+    @Test
+    fun steppingMovesByWholeFramesFromTheRoundedHold() {
+        assertEquals(3 * 83, HoldDuration.step(150, 12, +1))
+        assertEquals(83, HoldDuration.step(150, 12, -1))
+        assertEquals(83, HoldDuration.step(83, 12, -5))
+    }
+
+    @Test
+    fun theFrameRateScalesTheHold() {
+        assertEquals(2 * 41, HoldDuration.duration(2, 24))
+        assertEquals(2 * 1000, HoldDuration.duration(2, 1))
+    }
+
+    @Test
+    fun aHoldStopsAtTheLongestAFrameCanBeHeld() {
+        assertEquals(AnimationFrame.MAX_DURATION_MS, HoldDuration.duration(10_000, 12))
+        assertEquals(AnimationFrame.MAX_DURATION_MS, HoldDuration.step(AnimationFrame.MAX_DURATION_MS, 1, +1))
+    }
+}
