+        assertEquals(3 to 5, pair(PlaybackRange.afterInsert(range(2, 4), 2)))
+    }
+
+    @Test
+    fun aFrameInsertedInsideTheRangeJoinsIt() {
+        assertEquals(2 to 5, pair(PlaybackRange.afterInsert(range(2, 4), 3)))
+        assertEquals(2 to 5, pair(PlaybackRange.afterInsert(range(2, 4), 4)))
+    }
+
+    @Test
+    fun framesInsertedAfterTheRangeLeaveItAlone() {
+        assertEquals(2 to 4, pair(PlaybackRange.afterInsert(range(2, 4), 5)))
+    }
+
+    @Test
+    fun insertingAtTheVeryStartOfAWholeTimelineKeepsItWhole() {
+        assertEquals(0 to -1, pair(PlaybackRange.afterInsert(range(0), 0)))
+        assertEquals(0 to -1, pair(PlaybackRange.afterInsert(range(0), 3)))
+    }
+
+    @Test
+    fun deletingBeforeTheRangeShiftsIt() {
+        assertEquals(1 to 3, pair(PlaybackRange.afterDelete(range(2, 4), 0)))
+    }
+
+    @Test
+    fun deletingInsideTheRangeShrinksIt() {
+        assertEquals(2 to 3, pair(PlaybackRange.afterDelete(range(2, 4), 3)))
+        assertEquals(2 to 3, pair(PlaybackRange.afterDelete(range(2, 4), 4)))
+        assertEquals(2 to 3, pair(PlaybackRange.afterDelete(range(2, 4), 2)))
+    }
+
+    @Test
+    fun deletingAfterTheRangeLeavesItAlone() {
+        assertEquals(2 to 4, pair(PlaybackRange.afterDelete(range(2, 4), 5)))
+    }
+
+    @Test
+    fun aRangeLeftWithNoFramePlaysTheWholeTimeline() {
+        assertEquals(0 to -1, pair(PlaybackRange.afterDelete(range(2, 2), 2)))
+    }
+
+    @Test
+    fun anOpenEndedRangeKeepsItsStartAsFramesComeAndGo() {
+        assertEquals(3 to -1, pair(PlaybackRange.afterInsert(range(2), 0)))
+        assertEquals(1 to -1, pair(PlaybackRange.afterDelete(range(2), 0)))
+        assertEquals(2 to -1, pair(PlaybackRange.afterDelete(range(2), 6)))
+    }
+
+    @Test
+    fun movingAFrameIntoTheRangeBringsItAlong() {
+        // Frames 2..4 play; frame 1 is dragged to position 3.
+        assertEquals(1 to 4, pair(PlaybackRange.afterMove(range(2, 4), from = 1, to = 3)))
+    }
+
+    @Test
+    fun movingAFrameOutOfTheRangeLeavesItBehind() {
+        // Frame 3 is dragged to the very end: the others close up.
+        assertEquals(2 to 3, pair(PlaybackRange.afterMove(range(2, 4), from = 3, to = 7)))
+    }
+
+    @Test
+    fun movingAFrameWithinTheRangeKeepsTheRange() {
+        assertEquals(2 to 4, pair(PlaybackRange.afterMove(range(2, 4), from = 2, to = 4)))
+    }
+}
