+        assertEquals(1 to 3, pair(PlaybackRange.withStart(range(0, 3), 1)))
+    }
+
+    @Test
+    fun endMovesALaterStartDownWithIt() {
+        assertEquals(1 to 3, pair(PlaybackRange.withEnd(range(1), 3, frameCount = 8)))
+        assertEquals(2 to 2, pair(PlaybackRange.withEnd(range(5), 2, frameCount = 8)))
+    }
+
+    @Test
+    fun endingOnTheLastFrameKeepsPlayingFramesAddedAfterIt() {
+        assertEquals(1 to -1, pair(PlaybackRange.withEnd(range(1), 7, frameCount = 8)))
+    }
+
+    @Test
+    fun wholeTimelineClearsTheRange() {
+        assertEquals(0 to -1, pair(PlaybackRange.whole(range(2, 4))))
+        assertEquals(0..5, played(6, PlaybackRange.whole(range(2, 4))))
+        assertEquals(2..4, played(6, range(2, 4)))
+    }
+
+    @Test
+    fun theStoredRangeIsWhatPlaybackPlays() {
+        // End of -1 plays to the last frame, so frames added later are played too.
+        assertEquals(1..5, played(6, PlaybackRange.withEnd(range(1), 5, frameCount = 6)))
+        assertEquals(1..7, played(8, PlaybackRange.withEnd(range(1), 5, frameCount = 6)))
+        assertEquals(1..2, played(8, PlaybackRange.withEnd(range(1), 2, frameCount = 8)))
+    }
+
+    @Test
+    fun framesInsertedBeforeTheRangeShiftIt() {
