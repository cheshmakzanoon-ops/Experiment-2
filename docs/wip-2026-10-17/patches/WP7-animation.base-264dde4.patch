@@ -0,0 +1,88 @@
+package com.artflow.studio.core.animation
+
+import com.artflow.studio.domain.model.animation.AnimationSettings
+import kotlin.math.max
+
+/**
+ * Editing the playback range kept in [AnimationSettings] (`playbackRangeStart` to `playbackRangeEnd`,
+ * the end being -1 for "to the last frame"). The range is stored as frame positions, so adding,
+ * deleting and moving frames has to carry it along or it would quietly cover other frames.
+ * Playback already honours the stored range; nothing sets it yet, and the repository's frame
+ * operations do not call the shift functions here yet.
+ */
+object PlaybackRange {
+    /** Starts the range at [index]; an end before it moves up to it. */
+    fun withStart(
+        settings: AnimationSettings,
+        index: Int,
+    ): AnimationSettings {
+        val start = max(0, index)
+        val end = settings.playbackRangeEnd
+        return settings.copy(playbackRangeStart = start, playbackRangeEnd = if (end in 0 until start) start else end)
+    }
+
+    /**
+     * Ends the range at [index], a position among [frameCount] frames. The last frame is stored as
+     * "to the end", so frames added later at the end are played too. A start after it moves down.
+     */
+    fun withEnd(
+        settings: AnimationSettings,
+        index: Int,
+        frameCount: Int,
+    ): AnimationSettings {
+        val end = max(0, index)
+        return settings.copy(
+            playbackRangeStart = minOf(settings.playbackRangeStart, end),
+            playbackRangeEnd = if (end >= frameCount - 1) -1 else end,
+        )
+    }
+
+    /** Plays the whole timeline. */
+    fun whole(settings: AnimationSettings): AnimationSettings = settings.copy(playbackRangeStart = 0, playbackRangeEnd = -1)
+
+    /** After a frame was inserted at [at]: the frames of the range keep their place, and a frame inserted inside joins it. */
+    fun afterInsert(
+        settings: AnimationSettings,
+        at: Int,
+    ): AnimationSettings {
+        val start = settings.playbackRangeStart
+        val end = settings.playbackRangeEnd
+        return settings.copy(
+            playbackRangeStart = if (start > 0 && at <= start) start + 1 else start,
+            playbackRangeEnd = if (end >= 0 && at <= end) end + 1 else end,
+        )
+    }
+
+    /** After the frame at [at] was removed. A range left with no frame of its own plays the whole timeline. */
+    fun afterDelete(
+        settings: AnimationSettings,
+        at: Int,
+    ): AnimationSettings {
+        val start = settings.playbackRangeStart
+        val end = settings.playbackRangeEnd
+        val newStart = if (at < start) start - 1 else start
+        val newEnd = if (end >= 0 && at <= end) end - 1 else end
+        val emptied = end >= 0 && newEnd < newStart
+        return if (emptied) whole(settings) else settings.copy(playbackRangeStart = newStart, playbackRangeEnd = newEnd)
+    }
+
+    /**
+     * After the frame at [from] was moved to [to]: the range stays on the same frames; the moved one
+     * leaves it if it lands outside, joins it if it lands inside and stays in it if it moved within.
+     */
+    fun afterMove(
+        settings: AnimationSettings,
+        from: Int,
+        to: Int,
+    ): AnimationSettings =
+        if (contains(settings, from) && contains(settings, to)) {
+            settings
+        } else {
+            afterInsert(afterDelete(settings, from), to)
+        }
+
+    private fun contains(
+        settings: AnimationSettings,
+        index: Int,
+    ): Boolean = index >= settings.playbackRangeStart && (settings.playbackRangeEnd < 0 || index <= settings.playbackRangeEnd)
+}
