+package com.artflow.studio.core.animation
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class TimelineStripTest {
+    // Tiles 72 px wide with 8 px gaps are 80 px apart; the first starts 16 px in.
+    private fun at(
+        x: Float,
+        scroll: Float = 0f,
+        count: Int = 10,
+    ) = TimelineStrip.indexAt(x, scroll, extentPx = 80f, startPx = 16f, count = count)
+
+    @Test
+    fun aPointerMapsToTheTileUnderIt() {
+        assertEquals(0, at(16f))
+        assertEquals(0, at(95f))
+        assertEquals(1, at(96f))
+        assertEquals(3, at(16f + 3 * 80f + 10f))
+    }
+
+    @Test
+    fun scrollingShiftsWhichTileIsUnderThePointer() {
+        assertEquals(4, at(16f, scroll = 320f))
+        assertEquals(5, at(96f, scroll = 320f))
+    }
+
+    @Test
+    fun dragPastEitherEndHoldsTheFirstOrLastFrame() {
+        assertEquals(0, at(-200f))
+        assertEquals(0, at(0f))
+        assertEquals(9, at(5000f))
+        assertEquals(2, at(5000f, count = 3))
+    }
+
+    @Test
+    fun anEmptyTimelineMapsToTheFirstFrame() {
+        assertEquals(0, at(300f, count = 0))
+    }
+
+    @Test
+    fun edgeScrollIsStillInTheMiddleOfTheStrip() {
+        assertEquals(0f, TimelineStrip.edgeScroll(x = 200f, viewportPx = 400f, edgePx = 60f, maxStepPx = 30f), 0f)
+        assertEquals(0f, TimelineStrip.edgeScroll(x = 60f, viewportPx = 400f, edgePx = 60f, maxStepPx = 30f), 0f)
+    }
+
+    @Test
+    fun edgeScrollSpeedsUpTowardsTheEdgeAndPointsTheRightWay() {
+        assertEquals(-15f, TimelineStrip.edgeScroll(x = 30f, viewportPx = 400f, edgePx = 60f, maxStepPx = 30f), 1e-4f)
+        assertEquals(-30f, TimelineStrip.edgeScroll(x = 0f, viewportPx = 400f, edgePx = 60f, maxStepPx = 30f), 1e-4f)
+        assertEquals(15f, TimelineStrip.edgeScroll(x = 370f, viewportPx = 400f, edgePx = 60f, maxStepPx = 30f), 1e-4f)
+        assertEquals(30f, TimelineStrip.edgeScroll(x = 400f, viewportPx = 400f, edgePx = 60f, maxStepPx = 30f), 1e-4f)
+    }
+
+    @Test
+    fun edgeScrollIsCappedWhenThePointerLeavesTheStrip() {
+        assertEquals(-30f, TimelineStrip.edgeScroll(x = -500f, viewportPx = 400f, edgePx = 60f, maxStepPx = 30f), 1e-4f)
+        assertEquals(30f, TimelineStrip.edgeScroll(x = 900f, viewportPx = 400f, edgePx = 60f, maxStepPx = 30f), 1e-4f)
+    }
+
+    @Test
+    fun aStripTooNarrowForTwoEdgesDoesNotScroll() {
+        assertEquals(0f, TimelineStrip.edgeScroll(x = 10f, viewportPx = 100f, edgePx = 60f, maxStepPx = 30f), 0f)
+    }
+
+    @Test
+    fun aVisibleFrameNeedsNoScrolling() {
+        assertNull(TimelineStrip.revealFrom(active = 4, firstVisible = 2, lastVisible = 6))
+        assertNull(TimelineStrip.revealFrom(active = 2, firstVisible = 2, lastVisible = 6))
+        assertNull(TimelineStrip.revealFrom(active = 6, firstVisible = 2, lastVisible = 6))
+    }
+
+    @Test
+    fun aFrameOffTheLeftBecomesTheFirstShown() {
+        assertEquals(1, TimelineStrip.revealFrom(active = 1, firstVisible = 3, lastVisible = 7))
+    }
+
+    @Test
+    fun aFrameOffTheRightBecomesTheLastShown() {
+        // Five tiles show (3..7); frame 12 scrolls in at the right edge, so 8..12 show.
+        assertEquals(8, TimelineStrip.revealFrom(active = 12, firstVisible = 3, lastVisible = 7))
+    }
+}
