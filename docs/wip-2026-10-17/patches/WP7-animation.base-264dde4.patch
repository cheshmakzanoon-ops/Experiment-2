+package com.artflow.studio.core.animation
+
+import com.artflow.studio.core.pixels.PixelBuffer
+import com.artflow.studio.domain.model.animation.AnimationSettings
+
+/**
+ * Onion skin: the frames next to the current one, drawn as tinted ghosts over it so the drawing can
+ * be traced and timed. Previous frames take one colour and following frames another, as in
+ * Procreate's Animation Assist; nearer frames are stronger than farther ones.
+ *
+ * The ghost list and the tint are not drawn by the canvas yet: it still shows untinted ghosts.
+ */
+object OnionSkin {
+    /** The lowest strength a ghost can be given, so switching ghosts on always shows something. */
+    const val MIN_OPACITY = 0.05f
+
+    private const val ALPHA_MASK = 0xFF000000.toInt()
+    private const val RGB_MASK = 0x00FFFFFF
+
+    /** What the ghosts look like; the part of [AnimationSettings] that is saved with each artwork. */
+    data class Style(
+        val frames: Int,
+        val opacity: Float,
+        val previousColor: Int,
+        val nextColor: Int,
+    ) {
+        companion object {
+            fun of(settings: AnimationSettings): Style =
+                Style(settings.onionSkinFrames, settings.onionSkinOpacity, settings.onionSkinPreviousColor, settings.onionSkinNextColor)
+        }
+    }
+
+    /** One ghost: the frame to show, how strongly (0..1) and in which colour. */
+    data class Ghost(
+        val frameIndex: Int,
+        val alpha: Float,
+        val color: Int,
+    )
+
+    /**
+     * The ghosts around frame [activeIndex] of [frameCount], farthest first so nearer ghosts end up
+     * on top: up to [Style.frames] frames before it in the previous colour, then after it in the
+     * next colour. The strength falls off with distance (one over the distance).
+     */
+    fun ghosts(
+        activeIndex: Int,
+        frameCount: Int,
+        style: Style,
+    ): List<Ghost> {
+        val count = style.frames.coerceIn(0, AnimationSettings.MAX_ONION_SKIN_FRAMES)
+        val base = style.opacity.coerceIn(MIN_OPACITY, 1f)
+        val ghosts = ArrayList<Ghost>(count * 2)
+        for (distance in count downTo 1) {
+            val index = activeIndex - distance
+            if (index in 0 until frameCount) ghosts += Ghost(index, base / distance, style.previousColor)
+        }
+        for (distance in count downTo 1) {
+            val index = activeIndex + distance
+            if (index in 0 until frameCount) ghosts += Ghost(index, base / distance, style.nextColor)
+        }
+        return ghosts
+    }
+
+    /**
+     * A flat-colour copy of [source]: every pixel takes [argb]'s colour and keeps its own opacity, so
+     * the drawing's shape survives and its colours do not. [argb]'s alpha is ignored (strength is
+     * the ghost's [Ghost.alpha]); fully transparent pixels stay transparent.
+     */
+    fun tint(
+        source: PixelBuffer,
+        argb: Int,
+    ): PixelBuffer {
+        val colour = argb and RGB_MASK
+        val from = source.pixels
+        val to = IntArray(from.size)
+        for (i in from.indices) {
+            val pixel = from[i]
+            if ((pixel ushr 24) != 0) to[i] = (pixel and ALPHA_MASK) or colour
+        }
+        return PixelBuffer(source.width, source.height, to)
+    }
+}
