+package com.artflow.studio.core.animation
+
+import com.artflow.studio.domain.model.animation.FramePin
+
+/**
+ * Which layers Animation Assist shows around a frame.
+ *
+ * A layer is pinned by its own [FramePin] or, when it has none, by the nearest pinned group around
+ * it, so pinning a group pins everything inside. Each pinned layer stays in the stack of the frame
+ * that holds it and appears on every other frame: Background layers below that frame's own layers,
+ * Foreground layers above them, frame by frame and in stack order.
+ *
+ * This is the selection rule only. The editor's layers do not carry a [FramePin] yet, so the
+ * compositor does not call it; a caller supplies a [Reader] for its own layer type.
+ */
+object PinnedLayers {
+    /** How to read what pinning depends on from a layer of any representation. */
+    class Reader<T>(
+        val id: (T) -> Long,
+        val parentGroupId: (T) -> Long?,
+        val pin: (T) -> FramePin,
+    )
+
+    /** The layers of the other frames that frame being shown has below and above its own. */
+    class Around<T>(
+        val below: List<T>,
+        val above: List<T>,
+    )
+
+    /** The pin that applies to each of [layers] (one frame's stack), after the groups around them. */
+    fun <T> effectivePins(
+        layers: List<T>,
+        reader: Reader<T>,
+    ): List<FramePin> {
+        if (layers.none { reader.pin(it) != FramePin.NONE }) return List(layers.size) { FramePin.NONE }
+        val byId = layers.associateBy(reader.id)
+        return layers.map { layer ->
+            var pin = FramePin.NONE
+            var current: T? = layer
+            var steps = 0
+            // The step bound stops a corrupt cycle of groups from looping forever.
+            while (current != null && pin == FramePin.NONE && steps++ <= layers.size) {
+                pin = reader.pin(current)
+                current = reader.parentGroupId(current)?.let(byId::get)
+            }
+            pin
+        }
+    }
+
+    /** What frame [index] of [frames] shows from the other frames; its own pinned layers stay in its own stack. */
+    fun <T> around(
+        index: Int,
+        frames: List<List<T>>,
+        reader: Reader<T>,
+    ): Around<T> {
+        val below = ArrayList<T>()
+        val above = ArrayList<T>()
+        frames.forEachIndexed { position, layers ->
+            if (position == index || layers.none { reader.pin(it) != FramePin.NONE }) return@forEachIndexed
+            effectivePins(layers, reader).forEachIndexed { at, pin ->
+                when (pin) {
+                    FramePin.BACKGROUND -> below += layers[at]
+                    FramePin.FOREGROUND -> above += layers[at]
+                    FramePin.NONE -> Unit
+                }
+            }
+        }
+        return Around(below, above)
+    }
+
+    /** [layers] without the pinned ones: what belongs to this frame alone (onion-skin ghosts show only that). */
+    fun <T> unpinned(
+        layers: List<T>,
+        reader: Reader<T>,
+    ): List<T> {
+        if (layers.none { reader.pin(it) != FramePin.NONE }) return layers
+        val pins = effectivePins(layers, reader)
+        return layers.filterIndexed { at, _ -> pins[at] == FramePin.NONE }
+    }
+}
