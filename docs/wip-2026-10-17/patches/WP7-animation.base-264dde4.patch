@@ -0,0 +1,101 @@
+package com.artflow.studio.core.animation
+
+import com.artflow.studio.core.pixels.PixelBuffer
+import com.artflow.studio.core.render.Compositor
+import com.artflow.studio.domain.model.animation.AnimationSettings
+import com.artflow.studio.domain.model.layer.Layer
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class OnionSkinTest {
+    private val red = 0xFFFF0000.toInt()
+    private val green = 0xFF00FF00.toInt()
+    private val style = OnionSkin.Style(frames = 2, opacity = 0.4f, previousColor = red, nextColor = green)
+
+    @Test
+    fun ghostsAreTheNeighboursInTheirOwnColoursFarthestFirst() {
+        val ghosts = OnionSkin.ghosts(activeIndex = 5, frameCount = 10, style = style)
+        assertEquals(listOf(3, 4, 7, 6), ghosts.map { it.frameIndex })
+        assertEquals(listOf(red, red, green, green), ghosts.map { it.color })
+    }
+
+    @Test
+    fun strengthFallsOffWithDistanceFromTheCurrentFrame() {
+        val ghosts = OnionSkin.ghosts(activeIndex = 5, frameCount = 10, style = style)
+        assertEquals(listOf(0.2f, 0.4f, 0.2f, 0.4f), ghosts.map { it.alpha })
+    }
+
+    @Test
+    fun noGhostsReachPastEitherEndOfTheTimeline() {
+        assertEquals(listOf(2, 1), OnionSkin.ghosts(activeIndex = 0, frameCount = 3, style = style).map { it.frameIndex })
+        assertEquals(listOf(0, 1), OnionSkin.ghosts(activeIndex = 2, frameCount = 3, style = style).map { it.frameIndex })
+        assertTrue(OnionSkin.ghosts(activeIndex = 0, frameCount = 1, style = style).isEmpty())
+    }
+
+    @Test
+    fun zeroFramesShowsNothingAndTheCountIsCapped() {
+        assertTrue(OnionSkin.ghosts(3, 10, style.copy(frames = 0)).isEmpty())
+        val capped = OnionSkin.ghosts(8, 20, style.copy(frames = 99))
+        assertEquals(2 * AnimationSettings.MAX_ONION_SKIN_FRAMES, capped.size)
+    }
+
+    @Test
+    fun opacityHasAFloorSoGhostsNeverVanishCompletely() {
+        val ghosts = OnionSkin.ghosts(1, 3, style.copy(frames = 1, opacity = 0f))
+        assertEquals(OnionSkin.MIN_OPACITY, ghosts.first().alpha, 0f)
+    }
+
+    @Test
+    fun styleComesFromTheArtworksSettings() {
+        val settings =
+            AnimationSettings(onionSkinFrames = 3, onionSkinOpacity = 0.6f, onionSkinPreviousColor = green, onionSkinNextColor = red)
+        assertEquals(OnionSkin.Style(3, 0.6f, green, red), OnionSkin.Style.of(settings))
+    }
+
+    @Test
+    fun tintKeepsTheShapeAndReplacesTheColour() {
+        val source = PixelBuffer(3, 1, intArrayOf(0xFF102030.toInt(), 0x80FFFFFF.toInt(), 0))
+        val tinted = OnionSkin.tint(source, 0xFFAA5500.toInt())
+        // Each pixel keeps its alpha; the colour is the tint's whatever the drawing's colour was.
+        assertArrayEquals(intArrayOf(0xFFAA5500.toInt(), 0x80AA5500.toInt(), 0), tinted.pixels)
+        // The source is left alone.
+        assertEquals(0xFF102030.toInt(), source.pixels[0])
+    }
+
+    @Test
+    fun tintIgnoresTheColoursOwnAlpha() {
+        val source = PixelBuffer(1, 1, intArrayOf(0xC0000000.toInt()))
+        assertEquals(0xC000FF00.toInt(), OnionSkin.tint(source, 0x1100FF00).pixels[0])
+    }
+
+    @Test
+    fun transparentPixelsStayTransparentWhateverTheirHiddenColour() {
+        val source = PixelBuffer(1, 1, intArrayOf(0x00FF00FF))
+        assertEquals(0, OnionSkin.tint(source, red).pixels[0])
+    }
+
+    @Test
+    fun aTintedGhostOverPaperIsTheColourAtTheGhostsStrength() {
+        // A ghost drawn the way the canvas shows it: the tinted frame at its strength over white paper.
+        val ghost = OnionSkin.tint(PixelBuffer.filled(2, 2, 0xFF000000.toInt()), red)
+        val compositor = Compositor()
+        val shown =
+            try {
+                compositor.composite(
+                    listOf(Compositor.LayerInput(Layer(id = 1, name = "Ghost", index = 0, opacity = 0.3f), ghost)),
+                    2,
+                    2,
+                    backgroundColor = 0xFFFFFFFF.toInt(),
+                )
+            } finally {
+                compositor.release()
+            }
+        val pixel = shown.pixels[0]
+        assertEquals(255, (pixel shr 16) and 0xFF)
+        // White paper keeps 70% of its green and blue: 255 * 0.7 = 178.5.
+        assertEquals(178.5, ((pixel shr 8) and 0xFF).toDouble(), 1.0)
+        assertEquals(178.5, (pixel and 0xFF).toDouble(), 1.0)
+    }
+}
