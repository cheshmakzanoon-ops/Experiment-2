+package com.artflow.studio.core.animation
+
+import com.artflow.studio.domain.model.animation.AnimationFrame
+import com.artflow.studio.domain.model.animation.AnimationSettings
+import kotlin.math.roundToInt
+
+/**
+ * A frame's hold counted in frames, the way Procreate's Hold Duration is: holding a frame for 3
+ * means it stays up for three frame times at the artwork's frame rate. The document stores the
+ * time in milliseconds, so a hold set some other way (the exact-time slider) rounds to the nearest
+ * whole number of frames here. No control uses it yet; the animation sheet still sets milliseconds.
+ */
+object HoldDuration {
+    /** The number of frames [durationMs] holds at [fps]; at least 1. */
+    fun frames(
+        durationMs: Int,
+        fps: Int,
+    ): Int = (durationMs.toFloat() / frameMs(fps)).roundToInt().coerceAtLeast(1)
+
+    /** The time a hold of [frames] frames lasts at [fps], within the limits a frame can be held for. */
+    fun duration(
+        frames: Int,
+        fps: Int,
+    ): Int =
+        (frames.coerceAtLeast(1).toLong() * frameMs(fps))
+            .coerceIn(AnimationFrame.MIN_DURATION_MS.toLong(), AnimationFrame.MAX_DURATION_MS.toLong())
+            .toInt()
+
+    /** [durationMs] made [delta] frames longer (or shorter), never below one frame. */
+    fun step(
+        durationMs: Int,
+        fps: Int,
+        delta: Int,
+    ): Int = duration(frames(durationMs, fps) + delta, fps)
+
+    private fun frameMs(fps: Int): Int = AnimationSettings(fps = fps).frameDurationMs
+}
