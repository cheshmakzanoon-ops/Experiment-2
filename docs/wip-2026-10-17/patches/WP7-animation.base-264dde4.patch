+package com.artflow.studio.domain.model.animation
+
+import kotlinx.serialization.json.Json
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** The loop mode is derived from the two stored flags, so artworks saved before it existed play as they did. */
+class AnimationSettingsFormatTest {
+    // The configuration ProjectStorage reads and writes .artflow documents with.
+    private val json =
+        Json {
+            ignoreUnknownKeys = true
+            encodeDefaults = true
+            isLenient = false
+        }
+
+    private fun decode(text: String) = json.decodeFromString(AnimationSettings.serializer(), text)
+
+    @Test
+    fun theLoopModeIsNotWrittenToTheDocument() {
+        val text = json.encodeToString(AnimationSettings.serializer(), AnimationSettings().withLoopMode(LoopMode.PING_PONG))
+        assertFalse("loopMode" in text)
+        assertTrue("\"loop\":true" in text)
+        assertTrue("\"pingPong\":true" in text)
+    }
+
+    @Test
+    fun anArtworkSavedWithTheTwoSwitchesKeepsItsPlayback() {
+        val saved = """{"fps":24,"loop":false,"pingPong":true,"onionSkinEnabled":false,"onionSkinFrames":2}"""
+        val settings = decode(saved)
+        assertEquals(24, settings.fps)
+        assertFalse(settings.loop)
+        assertTrue(settings.pingPong)
+        assertEquals(2, settings.onionSkinFrames)
+        assertEquals(LoopMode.PING_PONG, settings.loopMode)
+    }
+
+    @Test
+    fun everyModeSurvivesASaveAndLoad() {
+        LoopMode.entries.forEach { mode ->
+            val original = AnimationSettings(fps = 8).withLoopMode(mode)
+            val restored = decode(json.encodeToString(AnimationSettings.serializer(), original))
+            assertEquals(original, restored)
+            assertEquals(mode, restored.loopMode)
+        }
+    }
+
+    @Test
+    fun anArtworkWithNoAnimationSettingsGetsTheDefaults() {
+        assertEquals(AnimationSettings(), decode("{}"))
+        assertEquals(LoopMode.LOOP, decode("{}").loopMode)
+    }
+}
