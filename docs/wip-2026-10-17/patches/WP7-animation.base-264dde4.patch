+package com.artflow.studio.core.animation
+
+import com.artflow.studio.domain.model.animation.FramePin
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class PinnedLayersTest {
+    private data class Item(
+        val id: Long,
+        val pin: FramePin = FramePin.NONE,
+        val parent: Long? = null,
+    )
+
+    private val reader = PinnedLayers.Reader<Item>({ it.id }, { it.parent }, { it.pin })
+
+    private fun ids(items: List<Item>) = items.map { it.id }
+
+    @Test
+    fun noPinsMeansNothingAroundAnyFrame() {
+        val frames = listOf(listOf(Item(1), Item(2)), listOf(Item(3)))
+        val around = PinnedLayers.around(0, frames, reader)
+        assertTrue(around.below.isEmpty())
+        assertTrue(around.above.isEmpty())
+    }
+
+    @Test
+    fun aPinnedLayerShowsOnEveryOtherFrameButStaysInItsOwnStack() {
+        val frames =
+            listOf(
+                listOf(Item(1, FramePin.BACKGROUND), Item(2)),
+                listOf(Item(3)),
+                listOf(Item(4)),
+            )
+        assertTrue(PinnedLayers.around(0, frames, reader).below.isEmpty())
+        assertEquals(listOf(1L), ids(PinnedLayers.around(1, frames, reader).below))
+        assertEquals(listOf(1L), ids(PinnedLayers.around(2, frames, reader).below))
+    }
+
+    @Test
+    fun backgroundsGoBelowAndForegroundsAboveInFrameThenStackOrder() {
+        val frames =
+            listOf(
+                listOf(Item(1), Item(2, FramePin.FOREGROUND), Item(3, FramePin.BACKGROUND)),
+                listOf(Item(4)),
+                listOf(Item(5, FramePin.BACKGROUND), Item(6, FramePin.FOREGROUND)),
+            )
+        val around = PinnedLayers.around(1, frames, reader)
+        assertEquals(listOf(3L, 5L), ids(around.below))
+        assertEquals(listOf(2L, 6L), ids(around.above))
+    }
+
+    @Test
+    fun pinningAGroupPinsEverythingInsideAtAnyDepth() {
+        val frame =
+            listOf(
+                Item(10, FramePin.BACKGROUND),
+                Item(11, parent = 10),
+                Item(12, parent = 10),
+                Item(13, parent = 12),
+                Item(14),
+            )
+        assertEquals(
+            listOf(FramePin.BACKGROUND, FramePin.BACKGROUND, FramePin.BACKGROUND, FramePin.BACKGROUND, FramePin.NONE),
+            PinnedLayers.effectivePins(frame, reader),
+        )
+        assertEquals(listOf(10L, 11L, 12L, 13L), ids(PinnedLayers.around(1, listOf(frame, listOf(Item(20))), reader).below))
+    }
+
+    @Test
+    fun aMembersOwnPinWinsOverItsGroups() {
+        val frame = listOf(Item(10, FramePin.BACKGROUND), Item(11, FramePin.FOREGROUND, parent = 10))
+        assertEquals(listOf(FramePin.BACKGROUND, FramePin.FOREGROUND), PinnedLayers.effectivePins(frame, reader))
+    }
+
+    @Test
+    fun aPinnedMemberOfAnUnpinnedGroupIsPinnedAlone() {
+        val frame = listOf(Item(10), Item(11, FramePin.BACKGROUND, parent = 10), Item(12, parent = 10))
+        val around = PinnedLayers.around(1, listOf(frame, listOf(Item(20))), reader)
+        assertEquals(listOf(11L), ids(around.below))
+    }
+
+    @Test
+    fun aCycleOfGroupsCannotHangTheLookup() {
+        val frame = listOf(Item(1, parent = 2), Item(2, parent = 1), Item(3, FramePin.BACKGROUND, parent = 1))
+        assertEquals(listOf(FramePin.NONE, FramePin.NONE, FramePin.BACKGROUND), PinnedLayers.effectivePins(frame, reader))
+    }
+
+    @Test
+    fun unpinnedLeavesOnlyTheFramesOwnLayers() {
+        val frame = listOf(Item(1, FramePin.BACKGROUND), Item(2), Item(3, FramePin.FOREGROUND), Item(4, parent = 3))
+        assertEquals(listOf(2L), ids(PinnedLayers.unpinned(frame, reader)))
+    }
+
+    @Test
+    fun unpinnedReturnsTheSameListWhenNothingIsPinned() {
+        val frame = listOf(Item(1), Item(2))
+        assertSame(frame, PinnedLayers.unpinned(frame, reader))
+    }
+}
