+package com.artflow.studio.core.animation
+
+import com.artflow.studio.domain.model.animation.AnimationFrame
+import com.artflow.studio.domain.model.animation.AnimationSettings
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class PlaybackRangeTest {
+    private fun range(
+        start: Int,
+        end: Int = -1,
+    ) = AnimationSettings(playbackRangeStart = start, playbackRangeEnd = end)
+
+    private fun pair(settings: AnimationSettings) = settings.playbackRangeStart to settings.playbackRangeEnd
+
+    /** The frames playback covers on a timeline of [count] frames. */
+    private fun played(
+        count: Int,
+        settings: AnimationSettings,
+    ): IntRange {
+        val frames = List(count) { AnimationFrame(it + 1L, "Frame", emptyList()) }
+        return AnimationTimeline.playbackRange(AnimationTimeline.State(frames, settings = settings))
+    }
+
