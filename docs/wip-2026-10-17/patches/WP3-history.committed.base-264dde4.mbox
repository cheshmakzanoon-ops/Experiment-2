+package com.artflow.studio.core.pixels
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.random.Random
+
+/** Tile deltas between two versions of a layer rebuild the older one exactly. */
+class RasterDeltaTest {
+    private val red = 0xFFFF0000.toInt()
+
+    private fun noise(
+        width: Int,
+        height: Int,
+        random: Random,
+    ): PixelBuffer = PixelBuffer(width, height, IntArray(width * height) { random.nextInt() })
+
+    private fun painted(
+        source: PixelBuffer,
+        bounds: IntBounds,
+        colour: Int,
+    ): PixelBuffer =
+        source.copy().also { copy ->
+            for (y in bounds.top..bounds.bottom) for (x in bounds.left..bounds.right) copy.setUnchecked(x, y, colour)
+        }
+
+    /** What the newer raster looks like after [delta] is laid over it. */
+    private fun rebuilt(
+        delta: RasterDelta,
+        newer: PixelBuffer,
+    ): PixelBuffer = newer.copy().also { delta.overlayOnto(it) }
+
+    @Test
+    fun `the same buffer twice gives an empty delta that changes nothing`() {
+        val buffer = noise(130, 70, Random(1))
+        val delta = requireNotNull(RasterDelta.between(buffer, buffer))
+        assertTrue(delta.isEmpty)
+        assertEquals(0, delta.tileCount)
+        assertArrayEquals(buffer.pixels, rebuilt(delta, buffer).pixels)
+    }
+
+    @Test
+    fun `equal pixels in different buffers give an empty delta`() {
+        val buffer = noise(100, 100, Random(2))
+        assertTrue(requireNotNull(RasterDelta.between(buffer, buffer.copy())).isEmpty)
+    }
+
+    @Test
+    fun `rasters of different sizes have no delta`() {
+        assertNull(RasterDelta.between(PixelBuffer(64, 64), PixelBuffer(64, 65)))
+    }
+
+    @Test
+    fun `a dab stores only the tile it touched and rebuilds the older pixels`() {
+        val older = noise(256, 192, Random(3))
+        val newer = painted(older, IntBounds(70, 70, 80, 75), red)
+        val delta = requireNotNull(RasterDelta.between(older, newer))
+        assertEquals(1, delta.tileCount)
+        assertArrayEquals(older.pixels, rebuilt(delta, newer).pixels)
+    }
+
+    @Test
+    fun `changes across tile borders and in partial edge tiles rebuild exactly`() {
+        // 130 x 70 has a 2-pixel column and a 6-pixel row of partial tiles.
+        val older = noise(130, 70, Random(4))
+        val newer = painted(painted(older, IntBounds(60, 60, 129, 69), red), IntBounds(0, 0, 0, 0), 0)
+        val delta = requireNotNull(RasterDelta.between(older, newer))
+        assertEquals("Three columns (the last 2 px wide) by two rows (the last 6 px high)", 6, delta.tileCount)
+        assertArrayEquals(older.pixels, rebuilt(delta, newer).pixels)
+    }
+
+    @Test
+    fun `tiles that were transparent are cleared again without being stored`() {
+        val older = PixelBuffer(640, 640)
+        val newer = painted(older, IntBounds(10, 10, 600, 600), red)
+        val delta = requireNotNull(RasterDelta.between(older, newer))
+        assertTrue(delta.tileCount > RasterDelta.DEFLATE_TILES)
+        assertTrue("Cleared tiles cost no pixels: ${delta.bytes}", delta.bytes < 1024)
+        assertTrue(rebuilt(delta, newer).pixels.all { it == 0 })
+    }
+
+    @Test
+    fun `many changed tiles are stored as they are and still rebuild exactly`() {
+        val random = Random(5)
+        val older = noise(640, 640, random)
+        val newer = noise(640, 640, random)
+        val delta = requireNotNull(RasterDelta.between(older, newer))
+        assertEquals(100, delta.tileCount)
+        assertArrayEquals(older.pixels, rebuilt(delta, newer).pixels)
+    }
+
+    @Test
+    fun `a stroke on a large painted layer costs a small fraction of the layer`() {
+        val older = PixelBuffer.filled(2048, 2048, 0xFF336699.toInt())
+        val newer = painted(older, IntBounds(500, 500, 900, 540), red)
+        val delta = requireNotNull(RasterDelta.between(older, newer))
+        assertTrue("A 400 x 40 stroke must not keep the 16 MB layer: ${delta.bytes}", delta.bytes < 16 * 1024)
+        assertArrayEquals(older.pixels, rebuilt(delta, newer).pixels)
+    }
+
+    @Test
+    fun `random edits of random rasters always rebuild the older raster`() {
+        val random = Random(6)
+        repeat(60) { round ->
+            val width = 1 + random.nextInt(300)
+            val height = 1 + random.nextInt(300)
+            val older = if (round % 3 == 0) PixelBuffer(width, height) else noise(width, height, random)
+            var newer = older
+            repeat(1 + random.nextInt(6)) {
+                val left = random.nextInt(width)
+                val top = random.nextInt(height)
+                val right = (left + random.nextInt(1 + width / 2)).coerceAtMost(width - 1)
+                val bottom = (top + random.nextInt(1 + height / 2)).coerceAtMost(height - 1)
+                newer = painted(newer, IntBounds(left, top, right, bottom), random.nextInt())
+            }
+            val delta = requireNotNull(RasterDelta.between(older, newer))
+            assertArrayEquals("round $round (${width}x$height)", older.pixels, rebuilt(delta, newer).pixels)
+        }
+    }
+
+    @Test
+    fun `a delta refuses to apply to a raster of another size`() {
+        val older = noise(64, 64, Random(7))
+        val delta = requireNotNull(RasterDelta.between(older, painted(older, IntBounds(1, 1, 2, 2), red)))
+        assertThrows(IllegalArgumentException::class.java) { delta.overlayOnto(PixelBuffer(65, 64)) }
+    }
+}
