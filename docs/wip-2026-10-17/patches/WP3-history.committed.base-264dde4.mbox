+package com.artflow.studio.core.history
+
+import com.artflow.studio.core.pixels.PixelBuffer
+import com.artflow.studio.core.pixels.RasterDelta
+
+/**
+ * One pixel plane (a layer's pixels or its mask) as the undo history holds it: the full buffer, or,
+ * once [archive]d, the tiles that differ from another plane, closer to the present, that it is
+ * rebuilt from. Its content never changes, only how it is stored, so history steps share planes.
+ */
+class HistoryPlane(
+    buffer: PixelBuffer,
+) {
+    val width: Int = buffer.width
+    val height: Int = buffer.height
+
+    /** The pixels while the plane is not archived. Shared copy-on-write: never modify them. */
+    var full: PixelBuffer? = buffer
+        private set
+
+    private var delta: RasterDelta? = null
+
+    /** The plane this one is rebuilt from while archived. */
+    internal var newer: HistoryPlane? = null
+        private set
+
+    /** The last plane [archive] declined to store this one against; the answer would not change. */
+    private var declined: HistoryPlane? = null
+
+    /** Bytes of the delta this plane keeps while archived. */
+    internal val deltaBytes: Long get() = delta?.bytes ?: 0L
+
+    val isArchived: Boolean get() = full == null
+
+    /**
+     * Keeps only this plane's difference from [newer] and lets go of the buffer, when that saves at
+     * least half of it. False, and nothing changes, when the plane is already archived, the sizes
+     * differ, [newer] is itself rebuilt from this plane, or the difference is too large to be worth
+     * rebuilding from.
+     */
+    fun archive(newer: HistoryPlane): Boolean {
+        val own = full ?: return false
+        if (newer === declined || newer.width != width || newer.height != height) return false
+        // A plane rebuilt from this one (or this one itself) cannot be its base: the chain would loop.
+        if (newer.base() === this) return false
+        val delta = RasterDelta.between(own, newer.pixels()) ?: return false
+        if (delta.bytes > own.pixels.size.toLong() * Int.SIZE_BYTES / 2) {
+            declined = newer
+            return false
+        }
+        full = null
+        declined = null
+        this.delta = delta
+        this.newer = newer
+        return true
+    }
+
+    /**
+     * The plane's pixels: its own buffer, the buffer it shares content with, or a new buffer rebuilt
+     * by copying the nearest full plane once and laying the deltas from there back to this one over
+     * it. Never modify the result: it may be shared.
+     */
+    fun pixels(): PixelBuffer {
+        full?.let { return it }
+        val deltas = ArrayList<RasterDelta>()
+        var plane = this
+        var base = plane.full
+        while (base == null) {
+            deltas += checkNotNull(plane.delta)
+            plane = checkNotNull(plane.newer)
+            base = plane.full
+        }
+        if (deltas.all { it.isEmpty }) return base
+        val rebuilt = base.copy()
+        for (index in deltas.indices.reversed()) deltas[index].overlayOnto(rebuilt)
+        return rebuilt
+    }
+
+    /** [pixels], which this plane then keeps as its buffer, so planes archived against it rebuild in one step. */
+    fun resolve(): PixelBuffer {
+        val buffer = pixels()
+        if (full == null) {
+            full = buffer
+            delta = null
+            newer = null
+        }
+        return buffer
+    }
+
+    /** The full plane this one is rebuilt from (itself when it is not archived). */
+    private fun base(): HistoryPlane {
+        var plane = this
+        while (true) plane = plane.newer ?: return plane
+    }
+}
diff --git a/app/src/main/java/com/artflow/studio/core/history/UndoHistory.kt b/app/src/main/java/com/artflow/studio/core/history/UndoHistory.kt
new file mode 100644
index 0000000..df41e53
--- /dev/null
+++ b/app/src/main/java/com/artflow/studio/core/history/UndoHistory.kt
@@ -0,0 +1,215 @@
+package com.artflow.studio.core.history
+
+import com.artflow.studio.core.pixels.PixelBuffer
+import java.util.Collections
+import java.util.IdentityHashMap
+
+/** Identifies a pixel plane from one history step to the next: a layer's pixels, or its mask. */
+data class PlaneKey(
+    val layerId: Long,
+    val isMask: Boolean,
+)
+
+/**
+ * Undo and redo for a document whose pixel planes are copy-on-write [PixelBuffer]s: edits replace a
+ * buffer, never modify it.
+ *
+ * A step is the document before an edit: [Step.state] holds everything but the pixel planes, which
+ * the history keeps by [PlaneKey] as [HistoryPlane]s. Steps share a plane while its buffer stays the
+ * same, so a stroke costs only the buffer of the layer it painted. Below the newest [keepFull] steps
+ * of each stack, every plane is archived against the same plane one step closer to the present, so
+ * a deep history keeps the tiles each step changed rather than whole layers.
+ *
+ * At most [maxSteps] undo steps are kept, and the oldest go while the history holds more than
+ * [budgetBytes] beyond the document's own buffers. Not thread-safe: use it from one thread.
+ */
+class UndoHistory<S : Any>(
+    private val maxSteps: Int,
+    private val budgetBytes: () -> Long,
+    private val keepFull: Int = KEEP_FULL,
+) {
+    init {
+        require(maxSteps >= 1 && keepFull >= 1) { "History needs at least one step and one full step" }
+    }
+
+    /** A document state: everything but its pixel planes in [state], and the planes by key. */
+    class Step<S>(
+        val state: S,
+        val planes: Map<PlaneKey, PixelBuffer>,
+    )
+
+    private class Entry<S>(
+        val state: S,
+        val planes: Map<PlaneKey, HistoryPlane>,
+        /** The [mark] the step was first recorded with; it keeps it when undone and redone. */
+        val mark: Long,
+    )
+
+    private val undoStack = ArrayDeque<Entry<S>>()
+    private val redoStack = ArrayDeque<Entry<S>>()
+
+    /** The planes holding the document's buffers as of the last record, undo or redo. */
+    private var live: Map<PlaneKey, HistoryPlane> = emptyMap()
+
+    private var runKey: Any? = null
+    private var runMark = 0L
+    private var runAt = 0L
+
+    val undoDepth: Int get() = undoStack.size
+
+    val redoDepth: Int get() = redoStack.size
+
+    /** Changes whenever a step is recorded, undone or redone, and on [clear]; it never repeats. */
+    var mark: Long = 0L
+        private set
+
+    /**
+     * Records the document before an edit, [current], as the newest undo step and drops the redo
+     * steps, unless the edit continues a [run]: consecutive edits of one control, such as a slider
+     * being dragged, that pass the same key less than [RUN_IDLE_MS] apart while nothing else touches
+     * the history share the step the first of them recorded. Returns true when a step was recorded.
+     */
+    fun record(
+        run: Any? = null,
+        nowMs: Long = 0L,
+        current: () -> Step<S>,
+    ): Boolean {
+        val continues = continuesRun(run, nowMs)
+        if (!continues) {
+            val entry = entryOf(current(), mark + 1)
+            mark++
+            undoStack.addLast(entry)
+            live = entry.planes
+            redoStack.clear()
+            compact(undoStack)
+            trim()
+        }
+        runKey = run
+        runMark = mark
+        runAt = nowMs
+        return !continues
+    }
+
+    private fun continuesRun(
+        run: Any?,
+        nowMs: Long,
+    ): Boolean = run != null && run == runKey && mark == runMark && nowMs - runAt in 0L..RUN_IDLE_MS
+
+    /** Takes back the newest step: returns the state to restore and keeps [current] for redo; null when there is none. */
+    fun undo(current: () -> Step<S>): Step<S>? = move(undoStack, redoStack, current)
+
+    /** Redoes the newest undone step: returns the state to restore and keeps [current] for undo; null when there is none. */
+    fun redo(current: () -> Step<S>): Step<S>? = move(redoStack, undoStack, current)
+
+    /** How many of the undo steps, newest first, were recorded after [mark] was read. */
+    fun stepsSince(mark: Long): Int = undoStack.asReversed().takeWhile { it.mark > mark }.size
+
+    /** Forgets every step, for a new or reopened document. */
+    fun clear() {
+        undoStack.clear()
+        redoStack.clear()
+        live = emptyMap()
+        mark++
+    }
+
+    /** Bytes the history keeps beyond the document's own buffers: archived tiles and full buffers no longer in the document. */
+    fun retainedBytes(): Long {
+        val counter = ByteCounter(live.values.mapNotNull { it.full })
+        for (entry in undoStack) entry.planes.values.forEach(counter::add)
+        for (entry in redoStack) entry.planes.values.forEach(counter::add)
+        return counter.total
+    }
+
+    private fun move(
+        from: ArrayDeque<Entry<S>>,
+        to: ArrayDeque<Entry<S>>,
+        current: () -> Step<S>,
+    ): Step<S>? {
+        val popped = from.lastOrNull() ?: return null
+        // Rebuild and capture before touching the stacks, so running out of memory changes nothing.
+        val restored = Step(popped.state, popped.planes.mapValues { (_, plane) -> plane.resolve() })
+        val replaced = entryOf(current(), popped.mark)
+        from.removeLast()
+        mark++
+        to.addLast(replaced)
+        live = popped.planes
+        compact(to)
+        return restored
+    }
+
+    /** [step] as an entry, reusing the planes of the buffers the document still shares with the last step. */
+    private fun entryOf(
+        step: Step<S>,
+        mark: Long,
+    ): Entry<S> {
+        val planes = HashMap<PlaneKey, HistoryPlane>(step.planes.size * 2)
+        for ((key, buffer) in step.planes) {
+            planes[key] = live[key]?.takeIf { it.full === buffer } ?: HistoryPlane(buffer)
+        }
+        return Entry(step.state, planes, mark)
+    }
+
+    /** Archives the planes of every step below the newest [keepFull] against the step above it, oldest first. */
+    private fun compact(stack: ArrayDeque<Entry<S>>) {
+        for (index in 0 until stack.size - keepFull) {
+            val newer = stack[index + 1].planes
+            for ((key, plane) in stack[index].planes) {
+                val target = newer[key] ?: continue
+                if (!plane.isArchived && target !== plane) archive(plane, target)
+            }
+        }
+    }
+
+    /** Archiving only saves memory: when even that cannot be allocated, the plane stays whole and counts as such. */
+    private fun archive(
+        plane: HistoryPlane,
+        target: HistoryPlane,
+    ) {
+        try {
+            plane.archive(target)
+        } catch (ignored: OutOfMemoryError) {
+            // The budget trims the history at the next step.
+        }
+    }
+
+    private fun trim() {
+        while (undoStack.size > maxSteps) undoStack.removeFirst()
+        val budget = budgetBytes()
+        while (undoStack.size > 1 && retainedBytes() > budget) undoStack.removeFirst()
+    }
+
+    /** Sums planes and buffers once each, following archived planes to what they are rebuilt from. */
+    private class ByteCounter(
+        liveBuffers: List<PixelBuffer>,
+    ) {
+        private val planes: MutableSet<HistoryPlane> = Collections.newSetFromMap(IdentityHashMap())
+        private val buffers: MutableSet<PixelBuffer> = Collections.newSetFromMap(IdentityHashMap())
+        var total = 0L
+            private set
+
+        init {
+            buffers.addAll(liveBuffers)
+        }
+
+        fun add(plane: HistoryPlane) {
+            var next: HistoryPlane? = plane
+            while (next != null && planes.add(next)) {
+                val buffer = next.full
+                if (buffer == null) {
+                    total += next.deltaBytes
+                } else if (buffers.add(buffer)) {
+                    total += buffer.pixels.size.toLong() * Int.SIZE_BYTES
+                }
+                next = next.newer
+            }
+        }
+    }
+
+    companion object {
+        /** Newest steps per stack whose planes stay whole, so undoing them is instant. */
+        const val KEEP_FULL = 1
+
+        /** Edits of one control further apart than this start a new step. */
+        const val RUN_IDLE_MS = 1_500L
+    }
+}
diff --git a/app/src/test/java/com/artflow/studio/core/history/HistoryPlaneTest.kt b/app/src/test/java/com/artflow/studio/core/history/HistoryPlaneTest.kt
new file mode 100644
index 0000000..e8e1427
--- /dev/null
+++ b/app/src/test/java/com/artflow/studio/core/history/HistoryPlaneTest.kt
@@ -0,0 +1,116 @@
+package com.artflow.studio.core.history
+
+import com.artflow.studio.core.pixels.IntBounds
+import com.artflow.studio.core.pixels.PixelBuffer
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotSame
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.random.Random
+
+/** A history plane rebuilds the same pixels however it is stored. */
+class HistoryPlaneTest {
+    private val random = Random(11)
+
+    private fun noise(): PixelBuffer = PixelBuffer(400, 300, IntArray(400 * 300) { random.nextInt() })
+
+    /** A copy of [source] with a small square painted at ([x], [y]). */
+    private fun dab(
+        source: PixelBuffer,
+        x: Int,
+        y: Int,
+    ): PixelBuffer =
+        source.copy().also { copy ->
+            val area = IntBounds(x, y, x + 5, y + 5)
+            for (py in area.top..area.bottom) for (px in area.left..area.right) copy.setUnchecked(px, py, random.nextInt())
+        }
+
+    @Test
+    fun `a full plane hands out its own buffer`() {
+        val buffer = noise()
+        assertSame(buffer, HistoryPlane(buffer).pixels())
+    }
+
+    @Test
+    fun `an archived plane lets go of its buffer and rebuilds it exactly`() {
+        val older = noise()
+        val newer = dab(older, 30, 40)
+        val plane = HistoryPlane(older)
+        assertTrue(plane.archive(HistoryPlane(newer)))
+        assertTrue(plane.isArchived)
+        assertArrayEquals(older.pixels, plane.pixels().pixels)
+    }
+
+    @Test
+    fun `a chain of archived planes rebuilds every link from the newest buffer`() {
+        val versions = generateSequence(noise()) { dab(it, random.nextInt(390), random.nextInt(290)) }.take(6).toList()
+        val planes = versions.map { HistoryPlane(it) }
+        // Archive oldest first, each against the next newer one, as the history does.
+        for (index in 0 until planes.lastIndex) assertTrue(planes[index].archive(planes[index + 1]))
+        planes.dropLast(1).forEach { assertTrue(it.isArchived) }
+        versions.zip(planes).forEach { (version, plane) -> assertArrayEquals(version.pixels, plane.pixels().pixels) }
+    }
+
+    @Test
+    fun `planes with equal pixels share the newer buffer instead of copying it`() {
+        val buffer = noise()
+        val plane = HistoryPlane(buffer)
+        val newer = HistoryPlane(buffer.copy())
+        assertTrue(plane.archive(newer))
+        assertSame(newer.pixels(), plane.pixels())
+    }
+
+    @Test
+    fun `resolving keeps the rebuilt buffer so older planes rebuild in one step`() {
+        val oldest = noise()
+        val middle = dab(oldest, 10, 10)
+        val newest = dab(middle, 100, 100)
+        val first = HistoryPlane(oldest)
+        val second = HistoryPlane(middle)
+        val third = HistoryPlane(newest)
+        assertTrue(second.archive(third))
+        assertTrue(first.archive(second))
+        val resolved = second.resolve()
+        assertFalse(second.isArchived)
+        assertSame(resolved, second.pixels())
+        assertArrayEquals(middle.pixels, resolved.pixels)
+        assertArrayEquals(oldest.pixels, first.pixels().pixels)
+    }
+
+    @Test
+    fun `a plane is never archived against one rebuilt from it`() {
+        val older = noise()
+        val plane = HistoryPlane(older)
+        val dependent = HistoryPlane(dab(older, 5, 5))
+        assertTrue(dependent.archive(plane))
+        assertFalse("This would make the two planes rebuild from each other", plane.archive(dependent))
+        assertFalse(plane.archive(plane))
+        assertArrayEquals(older.pixels, plane.pixels().pixels)
+    }
+
+    @Test
+    fun `a plane stays whole when the sizes differ or the difference is most of it`() {
+        val older = noise()
+        val plane = HistoryPlane(older)
+        assertFalse(plane.archive(HistoryPlane(PixelBuffer(401, 300))))
+        assertFalse("Every tile differs", plane.archive(HistoryPlane(noise())))
+        assertFalse(plane.isArchived)
+        assertSame(older, plane.pixels())
+    }
+
+    @Test
+    fun `an archived plane rebuilt from an archived plane is still exact`() {
+        val oldest = noise()
+        val middle = dab(oldest, 50, 50)
+        val newest = dab(middle, 350, 20)
+        val second = HistoryPlane(middle)
+        assertTrue(second.archive(HistoryPlane(newest)))
+        val first = HistoryPlane(oldest)
+        assertTrue(first.archive(second))
+        val rebuilt = first.pixels()
+        assertNotSame(middle, rebuilt)
+        assertArrayEquals(oldest.pixels, rebuilt.pixels)
+    }
+}
diff --git a/app/src/test/java/com/artflow/studio/core/history/UndoHistoryTest.kt b/app/src/test/java/com/artflow/studio/core/history/UndoHistoryTest.kt
new file mode 100644
index 0000000..52bf386
--- /dev/null
+++ b/app/src/test/java/com/artflow/studio/core/history/UndoHistoryTest.kt
@@ -0,0 +1,386 @@
+package com.artflow.studio.core.history
+
+import com.artflow.studio.core.pixels.PixelBuffer
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.random.Random
+
+/**
+ * The compacted history against a plain one that deep-copies every state: whatever edits, undos
+ * and redos happen, both must hand back the same documents.
+ */
+class UndoHistoryTest {
+    /** A layer of the stand-in document. Buffers are replaced on every edit, never modified. */
+    private data class Layer(
+        val id: Long,
+        val opacity: Int,
+        val pixels: PixelBuffer,
+        val mask: PixelBuffer?,
+    )
+
+    private data class Doc(
+        val width: Int,
+        val height: Int,
+        val layers: List<Layer>,
+    )
+
+    /** Everything about a document except its pixels, as the history's state. */
+    private data class Meta(
+        val width: Int,
+        val height: Int,
+        val layers: List<Pair<Long, Int>>,
+    )
+
+    private fun step(doc: Doc): UndoHistory.Step<Meta> {
+        val planes = HashMap<PlaneKey, PixelBuffer>()
+        doc.layers.forEach { layer ->
+            planes[PlaneKey(layer.id, false)] = layer.pixels
+            layer.mask?.let { planes[PlaneKey(layer.id, true)] = it }
+        }
+        return UndoHistory.Step(Meta(doc.width, doc.height, doc.layers.map { it.id to it.opacity }), planes)
+    }
+
+    private fun docOf(step: UndoHistory.Step<Meta>): Doc =
+        Doc(
+            step.state.width,
+            step.state.height,
+            step.state.layers.map { (id, opacity) ->
+                Layer(id, opacity, requireNotNull(step.planes[PlaneKey(id, false)]), step.planes[PlaneKey(id, true)])
+            },
+        )
+
+    private fun deepCopy(doc: Doc): Doc = doc.copy(layers = doc.layers.map { it.copy(pixels = it.pixels.copy(), mask = it.mask?.copy()) })
+
+    private fun assertSameDoc(
+        message: String,
+        expected: Doc,
+        actual: Doc,
+    ) {
+        assertEquals(message, expected.width to expected.height, actual.width to actual.height)
+        assertEquals(message, expected.layers.map { it.id to it.opacity }, actual.layers.map { it.id to it.opacity })
+        expected.layers.zip(actual.layers).forEach { (want, got) ->
+            assertArrayEquals("$message: pixels of layer ${want.id}", want.pixels.pixels, got.pixels.pixels)
+            assertEquals("$message: mask presence of layer ${want.id}", want.mask == null, got.mask == null)
+            want.mask?.let { assertArrayEquals("$message: mask of layer ${want.id}", it.pixels, requireNotNull(got.mask).pixels) }
+        }
+    }
+
+    /** Random edits of a [Doc], each returning a new document that shares every untouched buffer. */
+    private class Editor(
+        private val random: Random,
+    ) {
+        private var nextId = 100L
+
+        fun blank(
+            width: Int,
+            height: Int,
+        ): Doc = Doc(width, height, listOf(Layer(nextId++, 255, PixelBuffer.filled(width, height, BACKDROP), null)))
+
+        fun edit(doc: Doc): Doc {
+            val roll = random.nextInt(100)
+            return when {
+                roll < 40 -> repaint(doc, small = true)
+                roll < 45 -> repaint(doc, small = false)
+                roll < 55 -> maskEdit(doc)
+                roll < 65 -> reorderOrOpacity(doc)
+                roll < 80 -> addOrRemove(doc)
+                roll < 85 -> duplicate(doc)
+                roll < 89 -> resize(doc)
+                else -> clearLayer(doc)
+            }
+        }
+
+        private fun pick(doc: Doc): Int = random.nextInt(doc.layers.size)
+
+        private fun paint(
+            source: PixelBuffer,
+            small: Boolean,
+        ): PixelBuffer {
+            val out = source.copy()
+            val w = if (small) 1 + random.nextInt(12) else 1 + random.nextInt(source.width)
+            val h = if (small) 1 + random.nextInt(12) else 1 + random.nextInt(source.height)
+            val left = random.nextInt(source.width)
+            val top = random.nextInt(source.height)
+            val colour = random.nextInt()
+            for (y in top until minOf(source.height, top + h)) {
+                for (x in left until minOf(source.width, left + w)) out.setUnchecked(x, y, colour)
+            }
+            return out
+        }
+
+        private fun replace(
+            doc: Doc,
+            index: Int,
+            layer: Layer,
+        ): Doc = doc.copy(layers = doc.layers.toMutableList().also { it[index] = layer })
+
+        private fun repaint(
+            doc: Doc,
+            small: Boolean,
+        ): Doc {
+            val index = pick(doc)
+            return replace(doc, index, doc.layers[index].let { it.copy(pixels = paint(it.pixels, small)) })
+        }
+
+        private fun maskEdit(doc: Doc): Doc {
+            val index = pick(doc)
+            val layer = doc.layers[index]
+            val mask =
+                when {
+                    layer.mask == null -> PixelBuffer.filled(doc.width, doc.height, -1)
+                    random.nextInt(4) == 0 -> null
+                    else -> paint(layer.mask, small = true)
+                }
+            return replace(doc, index, layer.copy(mask = mask))
+        }
+
+        private fun reorderOrOpacity(doc: Doc): Doc {
+            val index = pick(doc)
+            if (random.nextBoolean()) return replace(doc, index, doc.layers[index].copy(opacity = random.nextInt(256)))
+            val layers = doc.layers.toMutableList()
+            layers.add(random.nextInt(layers.size), layers.removeAt(index))
+            return doc.copy(layers = layers)
+        }
+
+        private fun addOrRemove(doc: Doc): Doc {
+            val layers = doc.layers.toMutableList()
+            if (layers.size >= MAX_LAYERS || (layers.size > 1 && random.nextBoolean())) {
+                layers.removeAt(pick(doc))
+            } else {
+                val pixels = paint(PixelBuffer(doc.width, doc.height), small = random.nextBoolean())
+                layers.add(random.nextInt(layers.size + 1), Layer(nextId++, 255, pixels, null))
+            }
+            return doc.copy(layers = layers)
+        }
+
+        /** The copy shares the original's buffers, as a duplicated layer does until either is painted. */
+        private fun duplicate(doc: Doc): Doc {
+            if (doc.layers.size >= MAX_LAYERS) return addOrRemove(doc)
+            val index = pick(doc)
+            val layers = doc.layers.toMutableList()
+            layers.add(index + 1, layers[index].copy(id = nextId++))
+            return doc.copy(layers = layers)
+        }
+
+        private fun resize(doc: Doc): Doc {
+            val width = (doc.width + random.nextInt(-40, 41)).coerceIn(30, 260)
+            val height = (doc.height + random.nextInt(-40, 41)).coerceIn(30, 260)
+
+            fun fit(source: PixelBuffer): PixelBuffer =
+                PixelBuffer(width, height).also { out ->
+                    for (y in 0 until minOf(height, source.height)) {
+                        System.arraycopy(source.pixels, y * source.width, out.pixels, y * width, minOf(width, source.width))
+                    }
+                }
+            return Doc(width, height, doc.layers.map { it.copy(pixels = fit(it.pixels), mask = it.mask?.let(::fit)) })
+        }
+
+        private fun clearLayer(doc: Doc): Doc {
+            val index = pick(doc)
+            return replace(doc, index, doc.layers[index].copy(pixels = PixelBuffer(doc.width, doc.height)))
+        }
+    }
+
+    /** Drives the history and the plain reference through the same random session and compares them throughout. */
+    private fun runSession(
+        seed: Int,
+        keepFull: Int,
+        maxSteps: Int,
+        operations: Int,
+    ) {
+        val random = Random(seed)
+        val editor = Editor(random)
+        val history = UndoHistory<Meta>(maxSteps, { Long.MAX_VALUE }, keepFull)
+        val undone = ArrayDeque<Doc>()
+        val redone = ArrayDeque<Doc>()
+        var doc = editor.blank(70 + random.nextInt(150), 70 + random.nextInt(150))
+        repeat(operations) { operation ->
+            val label = "seed $seed, keepFull $keepFull, maxSteps $maxSteps, operation $operation"
+            val roll = random.nextInt(100)
+            if (roll < 15) {
+                val restored = history.undo { step(doc) }
+                if (undone.isEmpty()) {
+                    assertNull(label, restored)
+                } else {
+                    redone.addLast(deepCopy(doc))
+                    doc = docOf(requireNotNull(restored))
+                    assertSameDoc("$label (undo)", undone.removeLast(), doc)
+                }
+            } else if (roll < 25) {
+                val restored = history.redo { step(doc) }
+                if (redone.isEmpty()) {
+                    assertNull(label, restored)
+                } else {
+                    undone.addLast(deepCopy(doc))
+                    doc = docOf(requireNotNull(restored))
+                    assertSameDoc("$label (redo)", redone.removeLast(), doc)
+                }
+            } else {
+                assertTrue(history.record { step(doc) })
+                undone.addLast(deepCopy(doc))
+                if (undone.size > maxSteps) undone.removeFirst()
+                redone.clear()
+                doc = editor.edit(doc)
+            }
+            assertEquals(label, undone.size, history.undoDepth)
+            assertEquals(label, redone.size, history.redoDepth)
+            assertTrue(label, history.retainedBytes() >= 0)
+        }
+        // Finally walk the whole history back and forth.
+        while (undone.isNotEmpty()) {
+            redone.addLast(deepCopy(doc))
+            doc = docOf(requireNotNull(history.undo { step(doc) }))
+            assertSameDoc("seed $seed: final undo", undone.removeLast(), doc)
+        }
+        assertNull(history.undo { step(doc) })
+        while (redone.isNotEmpty()) {
+            undone.addLast(deepCopy(doc))
+            doc = docOf(requireNotNull(history.redo { step(doc) }))
+            assertSameDoc("seed $seed: final redo", redone.removeLast(), doc)
+        }
+    }
+
+    @Test
+    fun `undo and redo return exactly the documents a plain history would`() {
+        for (seed in 1..8) {
+            for (keepFull in 1..3) runSession(seed, keepFull, maxSteps = 250, operations = 300)
+        }
+    }
+
+    @Test
+    fun `a short history drops its oldest steps and still restores the rest exactly`() {
+        for (seed in 20..25) runSession(seed, keepFull = 1, maxSteps = 6, operations = 250)
+    }
+
+    private fun dabbed(
+        source: PixelBuffer,
+        x: Int,
+        y: Int,
+        colour: Int,
+    ): PixelBuffer =
+        source.copy().also { copy ->
+            for (py in y until y + 8) for (px in x until x + 8) copy.setUnchecked(px, py, colour)
+        }
+
+    @Test
+    fun `a deep history keeps the changed tiles rather than whole layers`() {
+        val history = UndoHistory<Meta>(250, { Long.MAX_VALUE })
+        val random = Random(3)
+        var doc = Doc(1024, 1024, listOf(Layer(1, 255, PixelBuffer.filled(1024, 1024, BACKDROP), null)))
+        val versions = ArrayList<PixelBuffer>()
+        repeat(200) {
+            history.record { step(doc) }
+            versions += doc.layers[0].pixels
+            val pixels = dabbed(doc.layers[0].pixels, random.nextInt(1000), random.nextInt(1000), random.nextInt())
+            doc = doc.copy(layers = listOf(doc.layers[0].copy(pixels = pixels)))
+        }
+        val layerBytes = 1024L * 1024 * 4
+        assertEquals(200, history.undoDepth)
+        assertTrue("200 dabs must not keep 200 layers: ${history.retainedBytes()}", history.retainedBytes() < 2 * layerBytes)
+        for (version in versions.asReversed()) {
+            doc = docOf(requireNotNull(history.undo { step(doc) }))
+            assertArrayEquals(version.pixels, doc.layers[0].pixels.pixels)
+        }
+    }
+
+    @Test
+    fun `steps that change no pixels let go of the buffer a deeper step replaced`() {
+        val history = UndoHistory<Meta>(250, { Long.MAX_VALUE })
+        var doc = Doc(512, 512, listOf(Layer(1, 255, PixelBuffer.filled(512, 512, BACKDROP), null)))
+        history.record { step(doc) }
+        doc = doc.copy(layers = listOf(doc.layers[0].copy(pixels = dabbed(doc.layers[0].pixels, 10, 10, -1))))
+        repeat(5) { opacity ->
+            history.record { step(doc) }
+            doc = doc.copy(layers = listOf(doc.layers[0].copy(opacity = opacity)))
+        }
+        assertTrue("Only the dab's tile is kept: ${history.retainedBytes()}", history.retainedBytes() < 64 * 1024)
+    }
+
+    @Test
+    fun `a deleted layer comes back whole however deep its step went`() {
+        val history = UndoHistory<Meta>(250, { Long.MAX_VALUE })
+        val random = Random(5)
+        val art = PixelBuffer(300, 200, IntArray(300 * 200) { random.nextInt() })
+        var doc = Doc(300, 200, listOf(Layer(1, 255, PixelBuffer(300, 200), null), Layer(2, 255, art, null)))
+        history.record { step(doc) }
+        doc = doc.copy(layers = listOf(doc.layers[0]))
+        repeat(30) {
+            history.record { step(doc) }
+            doc = doc.copy(layers = listOf(doc.layers[0].copy(pixels = dabbed(doc.layers[0].pixels, it * 8, 50, -1))))
+        }
+        repeat(31) { doc = docOf(requireNotNull(history.undo { step(doc) })) }
+        assertEquals(listOf(1L, 2L), doc.layers.map { it.id })
+        assertArrayEquals(art.pixels, doc.layers[1].pixels.pixels)
+        val restored = doc.layers[0].pixels
+        assertTrue(restored.pixels.all { it == 0 })
+    }
+
+    @Test
+    fun `the memory budget drops the oldest steps but always keeps the newest`() {
+        val budget = 3L * 300 * 200 * 4
+        val history = UndoHistory<Meta>(250, { budget })
+        val random = Random(9)
+        var doc = Doc(300, 200, listOf(Layer(1, 255, PixelBuffer(300, 200), null)))
+        repeat(40) {
+            history.record { step(doc) }
+            // Noise everywhere: nothing compresses, so each step costs a whole layer.
+            doc = doc.copy(layers = listOf(doc.layers[0].copy(pixels = PixelBuffer(300, 200, IntArray(300 * 200) { random.nextInt() }))))
+            assertTrue(history.retainedBytes() <= budget || history.undoDepth == 1)
+        }
+        assertTrue(history.undoDepth in 1..4)
+        assertNotNull(history.undo { step(doc) })
+    }
+
+    @Test
+    fun `a slider drag is one step until something else happens or it pauses`() {
+        val history = UndoHistory<Meta>(250, { Long.MAX_VALUE })
+        val doc = Doc(64, 64, listOf(Layer(1, 255, PixelBuffer(64, 64), null)))
+        assertTrue(history.record("opacity 1", 0L) { step(doc) })
+        val mark = history.mark
+        assertFalse(history.record("opacity 1", 1_000L) { step(doc) })
+        assertFalse("The pause is measured from the last change", history.record("opacity 1", 2_400L) { step(doc) })
+        assertEquals("A continued drag is not a new step", mark, history.mark)
+        assertTrue("A pause ends the drag", history.record("opacity 1", 4_000L) { step(doc) })
+        assertTrue("Another control starts its own step", history.record("opacity 2", 4_100L) { step(doc) })
+        assertFalse(history.record("opacity 2", 4_200L) { step(doc) })
+        assertTrue(history.record { step(doc) })
+        assertTrue("A step in between ends the drag", history.record("opacity 2", 4_300L) { step(doc) })
+        assertNotNull(history.undo { step(doc) })
+        assertTrue("An undo ends the drag", history.record("opacity 2", 4_400L) { step(doc) })
+        assertEquals(5, history.undoDepth)
+    }
+
+    @Test
+    fun `steps since a mark count only what was recorded after it`() {
+        val history = UndoHistory<Meta>(250, { Long.MAX_VALUE })
+        val doc = Doc(64, 64, listOf(Layer(1, 255, PixelBuffer(64, 64), null)))
+        repeat(3) { history.record { step(doc) } }
+        val start = history.mark
+        assertEquals(0, history.stepsSince(start))
+        repeat(2) { history.record { step(doc) } }
+        assertEquals(2, history.stepsSince(start))
+        history.undo { step(doc) }
+        assertEquals(1, history.stepsSince(start))
+        repeat(2) { history.undo { step(doc) } }
+        assertEquals(0, history.stepsSince(start))
+        history.redo { step(doc) }
+        assertEquals("A step from before the mark that was redone does not count", 0, history.stepsSince(start))
+        history.redo { step(doc) }
+        assertEquals(1, history.stepsSince(start))
+        val before = history.mark
+        history.clear()
+        assertTrue(history.mark > before)
+        assertEquals(0, history.undoDepth)
+        assertEquals(0, history.stepsSince(start))
+    }
+
+    private companion object {
+        const val BACKDROP = 0xFF336699.toInt()
+        const val MAX_LAYERS = 5
+    }
