+package com.artflow.studio.core.pixels
+
+import java.io.ByteArrayOutputStream
+import java.util.zip.DataFormatException
+import java.util.zip.Deflater
+import java.util.zip.Inflater
+
+/**
+ * The [TILE]-pixel tiles of an older raster that differ from a newer raster of the same size: all an
+ * undo step needs to rebuild the older pixels from the newer ones.
+ *
+ * Tiles that were fully transparent cost nothing. The others keep the older pixels, deflated when
+ * there are few of them: a brush stroke changes a few dozen tiles, which then take a few kilobytes
+ * where the whole layer is 16 MB at 2048 × 2048. Many changed tiles are stored as they are, which
+ * keeps building a delta quick after an edit that changed most of a layer.
+ */
+class RasterDelta private constructor(
+    val width: Int,
+    val height: Int,
+    /** Row-major indices of the differing tiles that were fully transparent, ascending. */
+    private val cleared: IntArray,
+    /** Row-major indices of the other differing tiles, ascending. */
+    private val stored: IntArray,
+    /** The older pixels of [stored], tile by tile and row by row, deflated; empty when [raw] holds them. */
+    private val packed: ByteArray,
+    /** The older pixels of [stored] as they are; empty when [packed] holds them. */
+    private val raw: IntArray,
+) {
+    /** True when the two rasters were identical. */
+    val isEmpty: Boolean get() = cleared.isEmpty() && stored.isEmpty()
+
+    /** How many tiles differ. */
+    val tileCount: Int get() = cleared.size + stored.size
+
+    /** Memory this delta holds, in bytes. */
+    val bytes: Long
+        get() = OVERHEAD_BYTES + (cleared.size + stored.size + raw.size).toLong() * Int.SIZE_BYTES + packed.size
+
+    /** Writes the older raster's differing tiles over [buffer], which must hold the newer raster's pixels. */
+    fun overlayOnto(buffer: PixelBuffer) {
+        require(buffer.width == width && buffer.height == height) { "A raster delta only applies to a ${width}x$height raster" }
+        for (tile in cleared) {
+            forTile(tile) { left, top, tileWidth, tileHeight -> clearTile(buffer.pixels, left, top, tileWidth, tileHeight) }
+        }
+        if (stored.isEmpty()) return
+        if (packed.isEmpty()) overlayRaw(buffer.pixels) else overlayPacked(buffer.pixels)
+    }
+
+    private fun overlayRaw(pixels: IntArray) {
+        var offset = 0
+        for (tile in stored) {
+            forTile(tile) { left, top, tileWidth, tileHeight ->
+                for (y in top until top + tileHeight) {
+                    System.arraycopy(raw, offset, pixels, y * width + left, tileWidth)
+                    offset += tileWidth
+                }
+            }
+        }
+    }
+
+    private fun overlayPacked(pixels: IntArray) {
+        val bytes = ByteArray(TILE * TILE * Int.SIZE_BYTES)
+        val inflater = Inflater()
+        try {
+            inflater.setInput(packed)
+            for (tile in stored) {
+                forTile(tile) { left, top, tileWidth, tileHeight ->
+                    inflateFully(inflater, bytes, tileWidth * tileHeight * Int.SIZE_BYTES)
+                    unpack(bytes, pixels, width, left, top, tileWidth, tileHeight)
+                }
+            }
+        } catch (corrupt: DataFormatException) {
+            throw IllegalStateException("Undo data is damaged", corrupt)
+        } finally {
+            inflater.end()
+        }
+    }
+
+    private fun clearTile(
+        pixels: IntArray,
+        left: Int,
+        top: Int,
+        tileWidth: Int,
+        tileHeight: Int,
+    ) {
+        for (y in top until top + tileHeight) {
+            val start = y * width + left
+            pixels.fill(0, start, start + tileWidth)
+        }
+    }
+
+    private inline fun forTile(
+        tile: Int,
+        block: (left: Int, top: Int, tileWidth: Int, tileHeight: Int) -> Unit,
+    ) {
+        val columns = columns(width)
+        val left = (tile % columns) * TILE
+        val top = (tile / columns) * TILE
+        block(left, top, minOf(TILE, width - left), minOf(TILE, height - top))
+    }
+
+    companion object {
+        /** Tile edge in pixels. */
+        const val TILE = 64
+
+        /** Up to this many stored tiles (1 MB of pixels) are deflated; more are kept as they are. */
+        const val DEFLATE_TILES = 64
+
+        /** Arrays, dimensions and object headers, roughly. */
+        private const val OVERHEAD_BYTES = 96L
+
+        /**
+         * The tiles of [older] that differ from [newer], or null when their sizes differ. The same
+         * buffer twice gives an empty delta without reading a pixel.
+         */
+        fun between(
+            older: PixelBuffer,
+            newer: PixelBuffer,
+        ): RasterDelta? {
+            if (older.width != newer.width || older.height != newer.height) return null
+            val width = older.width
+            val height = older.height
+            if (older === newer || older.pixels === newer.pixels) {
+                return RasterDelta(width, height, IntArray(0), IntArray(0), ByteArray(0), IntArray(0))
+            }
+            val (transparent, opaque) = changedTiles(older.pixels, newer.pixels, width, height).partition { isTransparent(older, it) }
+            val cleared = transparent.toIntArray()
+            val stored = opaque.toIntArray()
+            return if (stored.size <= DEFLATE_TILES) {
+                RasterDelta(width, height, cleared, stored, pack(older, stored), IntArray(0))
+            } else {
+                RasterDelta(width, height, cleared, stored, ByteArray(0), copyTiles(older, stored))
+            }
+        }
+
+        private fun columns(width: Int): Int = (width + TILE - 1) / TILE
+
+        private fun tileBounds(
+            raster: PixelBuffer,
+            tile: Int,
+        ): IntBounds {
+            val columns = columns(raster.width)
+            val left = (tile % columns) * TILE
+            val top = (tile / columns) * TILE
+            return IntBounds(left, top, minOf(raster.width, left + TILE) - 1, minOf(raster.height, top + TILE) - 1)
+        }
+
+        private fun isTransparent(
+            raster: PixelBuffer,
+            tile: Int,
+        ): Boolean {
+            val bounds = tileBounds(raster, tile)
+            val pixels = raster.pixels
+            for (y in bounds.top..bounds.bottom) {
+                val row = y * raster.width
+                for (i in row + bounds.left..row + bounds.right) {
+                    if (pixels[i] != 0) return false
+                }
+            }
+            return true
+        }
+
+        /** Marks, band of [TILE] rows by band, the tiles where [older] and [newer] differ. */
+        private fun changedTiles(
+            older: IntArray,
+            newer: IntArray,
+            width: Int,
+            height: Int,
+        ): IntArray {
+            val columns = columns(width)
+            val rows = (height + TILE - 1) / TILE
+            val found = IntArray(columns * rows)
+            var count = 0
+            val marked = BooleanArray(columns)
+            for (band in 0 until rows) {
+                marked.fill(false)
+                val top = band * TILE
+                markBand(older, newer, width, top, minOf(height, top + TILE), marked)
+                for (column in 0 until columns) {
+                    if (marked[column]) found[count++] = band * columns + column
+                }
+            }
+            return found.copyOf(count)
+        }
+
+        /**
+         * Marks in [marked] the tiles of rows [top, bottom) where [older] and [newer] differ,
+         * comparing each row's part of a tile only until the tile is marked.
+         */
+        private fun markBand(
+            older: IntArray,
+            newer: IntArray,
+            width: Int,
+            top: Int,
+            bottom: Int,
+            marked: BooleanArray,
+        ) {
+            var marks = 0
+            var y = top
+            while (y < bottom && marks < marked.size) {
+                val row = y * width
+                for (column in marked.indices) {
+                    if (!marked[column] && differs(older, newer, row + column * TILE, row + minOf(width, (column + 1) * TILE))) {
+                        marked[column] = true
+                        marks++
+                    }
+                }
+                y++
+            }
+        }
+
+        /** Whether [older] and [newer] differ in [from, to); branch-free, so compilers can vectorise it. */
+        private fun differs(
+            older: IntArray,
+            newer: IntArray,
+            from: Int,
+            to: Int,
+        ): Boolean {
+            var difference = 0
+            for (i in from until to) difference = difference or (older[i] xor newer[i])
+            return difference != 0
+        }
+
+        /** The pixels of [tiles], tile by tile and row by row. */
+        private fun copyTiles(
+            raster: PixelBuffer,
+            tiles: IntArray,
+        ): IntArray {
+            val bounds = tiles.map { tileBounds(raster, it) }
+            val out = IntArray(bounds.sumOf { it.width * it.height })
+            var offset = 0
+            for (tile in bounds) {
+                for (y in tile.top..tile.bottom) {
+                    System.arraycopy(raster.pixels, y * raster.width + tile.left, out, offset, tile.width)
+                    offset += tile.width
+                }
+            }
+            return out
+        }
+
+        private fun pack(
+            older: PixelBuffer,
+            tiles: IntArray,
+        ): ByteArray {
+            if (tiles.isEmpty()) return ByteArray(0)
+            val bytes = ByteArray(TILE * TILE * Int.SIZE_BYTES)
+            val chunk = ByteArray(CHUNK_BYTES)
+            val out = ByteArrayOutputStream()
+            val deflater = Deflater(Deflater.BEST_SPEED)
+            try {
+                for (tile in tiles) {
+                    val bounds = tileBounds(older, tile)
+                    packTile(older.pixels, older.width, bounds, bytes)
+                    deflater.setInput(bytes, 0, bounds.width * bounds.height * Int.SIZE_BYTES)
+                    while (!deflater.needsInput()) out.write(chunk, 0, deflater.deflate(chunk))
+                }
+                deflater.finish()
+                while (!deflater.finished()) out.write(chunk, 0, deflater.deflate(chunk))
+            } finally {
+                deflater.end()
+            }
+            return out.toByteArray()
+        }
+
+        /** Big-endian ARGB bytes of one tile, row by row. */
+        private fun packTile(
+            pixels: IntArray,
+            width: Int,
+            bounds: IntBounds,
+            bytes: ByteArray,
+        ) {
+            var k = 0
+            for (y in bounds.top..bounds.bottom) {
+                val row = y * width
+                for (i in row + bounds.left..row + bounds.right) {
+                    val argb = pixels[i]
+                    bytes[k] = (argb ushr 24).toByte()
+                    bytes[k + 1] = (argb ushr 16).toByte()
+                    bytes[k + 2] = (argb ushr 8).toByte()
+                    bytes[k + 3] = argb.toByte()
+                    k += Int.SIZE_BYTES
+                }
+            }
+        }
+
+        private fun unpack(
+            bytes: ByteArray,
+            pixels: IntArray,
+            width: Int,
+            left: Int,
+            top: Int,
+            tileWidth: Int,
+            tileHeight: Int,
+        ) {
+            var k = 0
+            for (y in top until top + tileHeight) {
+                val row = y * width + left
+                for (i in row until row + tileWidth) {
+                    val alpha = bytes[k].toInt() and BYTE
+                    val red = bytes[k + 1].toInt() and BYTE
+                    val green = bytes[k + 2].toInt() and BYTE
+                    val blue = bytes[k + 3].toInt() and BYTE
+                    pixels[i] = (alpha shl 24) or (red shl 16) or (green shl 8) or blue
+                    k += Int.SIZE_BYTES
+                }
+            }
+        }
+
+        /** Inflates exactly [length] bytes; all input was set at once, so no progress means the data ended early. */
+        private fun inflateFully(
+            inflater: Inflater,
+            bytes: ByteArray,
+            length: Int,
+        ) {
+            var filled = 0
+            while (filled < length) {
+                val read = inflater.inflate(bytes, filled, length - filled)
+                check(read > 0) { "Undo data ended early" }
+                filled += read
+            }
+        }
+
+        private const val BYTE = 0xFF
+        private const val CHUNK_BYTES = 1 shl 16
+    }
+}
