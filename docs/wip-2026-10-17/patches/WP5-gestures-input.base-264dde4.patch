--- /dev/null
+++ b/app/src/main/java/com/artflow/studio/core/canvas/RotationSnap.kt
@@ -0,0 +1,87 @@
+package com.artflow.studio.core.canvas
+
+import kotlin.math.abs
+import kotlin.math.roundToInt
+
+/**
+ * Two-finger canvas rotation that clicks into place at every multiple of [step] degrees, as Procreate's does.
+ *
+ * The fingers keep turning the whole time; what the canvas shows is held at the multiple while the fingers stay
+ * within [capture] degrees of it, and is let go once they are more than [release] degrees away. Catching at a small
+ * angle and letting go at a larger one is the hysteresis: a hand that wobbles around the edge of the catch zone
+ * cannot make the canvas flicker in and out of place.
+ *
+ * Use one instance per gesture: [begin] with the angle the canvas starts at, then [rotate] with each change of the
+ * fingers' angle. Angles are degrees, increasing clockwise as on screen, and are not wrapped.
+ */
+class RotationSnap(
+    private val step: Float = DEFAULT_STEP,
+    private val capture: Float = DEFAULT_CAPTURE,
+    private val release: Float = DEFAULT_RELEASE,
+) {
+    /** The angle to show, whether it is held on a multiple, and whether a multiple was caught by this very change. */
+    data class Result(
+        val angle: Float,
+        val snapped: Boolean,
+        val caught: Boolean,
+    )
+
+    init {
+        require(step > 0f && capture > 0f && release >= capture && release * 2f < step) { "Snap zones must fit inside one step" }
+    }
+
+    /** Where the fingers would have the canvas, ignoring the snap. */
+    private var raw = 0f
+    private var held = Float.NaN
+
+    /**
+     * Starts a gesture at [angle]. A canvas sitting exactly on a multiple (as a snapped one does) stays held there
+     * without a click; one that is merely near a multiple is left alone until the fingers bring it in.
+     */
+    fun begin(angle: Float) {
+        raw = angle
+        val nearest = nearestMultiple(angle)
+        held = if (abs(angle - nearest) <= EXACT) nearest else Float.NaN
+    }
+
+    /** Turns the fingers by [delta] degrees and returns what the canvas should now show. */
+    fun rotate(delta: Float): Result {
+        raw += delta
+        if (!held.isNaN()) {
+            if (abs(raw - held) <= release) return Result(held, snapped = true, caught = false)
+            held = Float.NaN
+            return Result(raw, snapped = false, caught = false)
+        }
+        val nearest = nearestMultiple(raw)
+        if (abs(raw - nearest) > capture) return Result(raw, snapped = false, caught = false)
+        held = nearest
+        return Result(nearest, snapped = true, caught = true)
+    }
+
+    private fun nearestMultiple(angle: Float): Float = (angle / step).roundToInt() * step
+
+    companion object {
+        const val DEFAULT_STEP = 45f
+        const val DEFAULT_CAPTURE = 3.5f
+        const val DEFAULT_RELEASE = 7f
+
+        /** How close to a multiple counts as sitting exactly on it, allowing for float rounding. */
+        private const val EXACT = 0.05f
+
+        /** A change of angle between two readings of the fingers, wrapped so that crossing 180 degrees is a small turn. */
+        fun shortestTurn(delta: Float): Float {
+            if (!delta.isFinite()) return 0f
+            val wrapped = (delta + HALF_TURN) % FULL_TURN
+            return (if (wrapped < 0f) wrapped + FULL_TURN else wrapped) - HALF_TURN
+        }
+
+        /** [angle] brought into 0 until 360. */
+        fun normalized(angle: Float): Float {
+            val wrapped = angle % FULL_TURN
+            return if (wrapped < 0f) wrapped + FULL_TURN else wrapped
+        }
+
+        private const val HALF_TURN = 180f
+        private const val FULL_TURN = 360f
+    }
+}
diff --git a/app/src/main/java/com/artflow/studio/core/canvas/TouchGestures.kt b/app/src/main/java/com/artflow/studio/core/canvas/TouchGestures.kt
