+++ b/app/src/main/java/com/artflow/studio/core/canvas/PalmRejection.kt
@@ -0,0 +1,63 @@
+package com.artflow.studio.core.canvas
+
+/**
+ * Decides whether a touch is a resting hand. Two things give a palm away: it is far bigger than a fingertip, and it
+ * arrives while someone is drawing with a stylus. Contact size alone would reject a thumb pressed flat, and
+ * the stylus alone would reject the finger of someone who also owns a pen, so both must hold. The pen-lift window in
+ * [PointerGestureRouter] catches the palm that lands just after the pen leaves; this catches the one that was
+ * there all along.
+ *
+ * A device that reports no contact size (zero) is never judged by it.
+ */
+class PalmRejection(
+    private val stylusMemoryMillis: Long = STYLUS_MEMORY_MILLIS,
+    private val palmMillimetres: Float = PALM_MILLIMETRES,
+) {
+    private var stylusAt = NEVER
+
+    /** The stylus touched or hovered over the screen at [timeMillis] (the clock of `MotionEvent.getEventTime`). */
+    fun stylusSeen(timeMillis: Long) {
+        stylusAt = timeMillis
+    }
+
+    /** True while a stylus has been in use lately: it was seen within the last few minutes. */
+    fun stylusInUse(timeMillis: Long): Boolean = stylusAt != NEVER && timeMillis - stylusAt in 0..stylusMemoryMillis
+
+    /**
+     * Whether a contact of [kind] whose long side measures [contactMillimetres] is a resting hand. [enabled] is the
+     * "reject large touches" setting; a contact the device itself calls a palm is one whatever that says.
+     */
+    fun isPalm(
+        kind: PointerKind,
+        contactMillimetres: Float,
+        timeMillis: Long,
+        enabled: Boolean,
+    ): Boolean =
+        when {
+            kind == PointerKind.PALM -> true
+            !enabled || kind.isPrecise -> false
+            else -> contactMillimetres >= palmMillimetres && stylusInUse(timeMillis)
+        }
+
+    companion object {
+        /** A stylus counts as in use for this long after it was last seen. */
+        const val STYLUS_MEMORY_MILLIS = 5 * 60_000L
+
+        /** Bigger than any fingertip or thumb pad (about 8 to 20 mm along the long side) and well under a palm (40 mm and up). */
+        const val PALM_MILLIMETRES = 24f
+        private const val NEVER = Long.MIN_VALUE
+        private const val MILLIMETRES_PER_INCH = 25.4f
+
+        /**
+         * The length of [pixels] on a screen of [dotsPerInch], or 0 when either is unusable. `MotionEvent.getTouchMajor`
+         * is in pixels on a touchscreen.
+         */
+        fun millimetres(
+            pixels: Float,
+            dotsPerInch: Float,
+        ): Float {
+            if (!pixels.isFinite() || pixels <= 0f || !dotsPerInch.isFinite() || dotsPerInch <= 0f) return 0f
+            return pixels / dotsPerInch * MILLIMETRES_PER_INCH
+        }
+    }
+}
