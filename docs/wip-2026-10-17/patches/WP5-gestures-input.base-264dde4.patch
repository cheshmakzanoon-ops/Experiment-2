diff --git a/app/src/main/java/com/artflow/studio/core/canvas/PointerIntents.kt b/app/src/main/java/com/artflow/studio/core/canvas/PointerIntents.kt
new file mode 100644
index 0000000..0e9ab3f
--- /dev/null
+++ b/app/src/main/java/com/artflow/studio/core/canvas/PointerIntents.kt
@@ -0,0 +1,153 @@
+package com.artflow.studio.core.canvas
+
+/** What a pointer that has just touched the canvas is for. */
+enum class PointerIntent {
+    /** Use the tool as usual. */
+    DRAW,
+
+    /** Use the eraser, whatever tool is selected. */
+    ERASE,
+
+    /** Sample colour while the pointer is held and dragged. */
+    SAMPLE,
+
+    /** Move the canvas with the pointer. */
+    PAN,
+
+    /** Undo once. */
+    UNDO,
+    QUICK_MENU,
+
+    /** Switch between the eraser and the paint tool. */
+    TOGGLE_ERASER,
+
+    /** The touch is deliberately ignored. */
+    NOTHING,
+    ;
+
+    /** Acts once when the button is pressed instead of for as long as it is held. */
+    val isClick: Boolean get() = this == UNDO || this == QUICK_MENU || this == TOGGLE_ERASER
+}
+
+/** The two buttons a stylus can report. */
+enum class StylusButton { PRIMARY, SECONDARY }
+
+/**
+ * Reads tool types and button states into intents. Button numbers are the documented `MotionEvent.BUTTON_*` values, so
+ * this file stays free of Android imports.
+ *
+ * Android reports the barrel button of most pens as `BUTTON_STYLUS_PRIMARY`, and some devices and ChromeOS pens as the
+ * mouse buttons `BUTTON_SECONDARY` and `BUTTON_TERTIARY` instead; either way the first button is the stylus's primary
+ * one and the second its secondary one. I cannot check which devices send what, so both spellings are accepted.
+ */
+object PointerIntents {
+    const val BUTTON_PRIMARY = 0x01
+    const val BUTTON_SECONDARY = 0x02
+    const val BUTTON_TERTIARY = 0x04
+    const val BUTTON_STYLUS_PRIMARY = 0x20
+    const val BUTTON_STYLUS_SECONDARY = 0x40
+
+    /** The stylus button held in [buttons], the primary one when both are down, or null when none is. */
+    fun heldStylusButton(buttons: Int): StylusButton? =
+        when {
+            buttons and (BUTTON_STYLUS_PRIMARY or BUTTON_SECONDARY) != 0 -> StylusButton.PRIMARY
+            buttons and (BUTTON_STYLUS_SECONDARY or BUTTON_TERTIARY) != 0 -> StylusButton.SECONDARY
+            else -> null
+        }
+
+    /**
+     * The intent of a pointer that has just touched down. [fresh] says which stylus buttons this very touch was the
+     * first to see pressed; a click-style action whose press was already used while the pen hovered does not repeat,
+     * and the pen paints instead.
+     */
+    fun atContact(
+        kind: PointerKind,
+        buttons: Int,
+        settings: GestureSettings,
+        fresh: Set<StylusButton> = emptySet(),
+    ): PointerIntent =
+        when (kind) {
+            PointerKind.MOUSE -> mouse(buttons, settings.rightClick)
+            PointerKind.ERASER -> of(settings.stylus.eraserEnd)
+            PointerKind.STYLUS -> stylus(buttons, settings.stylus, fresh)
+            PointerKind.FINGER, PointerKind.PALM -> PointerIntent.DRAW
+        }
+
+    /** The click-style action a stylus button press starts while the pen hovers, or null when none is set. */
+    fun inTheAir(
+        pressed: Set<StylusButton>,
+        mapping: StylusMapping,
+    ): PointerIntent? =
+        pressed
+            .sorted()
+            .map { button -> of(if (button == StylusButton.PRIMARY) mapping.primary else mapping.secondary) }
+            .firstOrNull { it.isClick }
+
+    private fun stylus(
+        buttons: Int,
+        mapping: StylusMapping,
+        fresh: Set<StylusButton>,
+    ): PointerIntent {
+        val held = heldStylusButton(buttons) ?: return PointerIntent.DRAW
+        val intent = of(if (held == StylusButton.PRIMARY) mapping.primary else mapping.secondary)
+        return if (intent.isClick && held !in fresh) PointerIntent.DRAW else intent
+    }
+
+    private fun mouse(
+        buttons: Int,
+        rightClick: MouseAction,
+    ): PointerIntent =
+        when {
+            buttons == 0 || buttons and BUTTON_PRIMARY != 0 -> PointerIntent.DRAW
+            buttons and BUTTON_SECONDARY != 0 -> of(rightClick)
+            buttons and BUTTON_TERTIARY != 0 -> PointerIntent.PAN
+            else -> PointerIntent.NOTHING
+        }
+
+    private fun of(action: StylusAction): PointerIntent =
+        when (action) {
+            StylusAction.NONE -> PointerIntent.DRAW
+            StylusAction.EYEDROPPER -> PointerIntent.SAMPLE
+            StylusAction.ERASE -> PointerIntent.ERASE
+            StylusAction.TOGGLE_ERASER -> PointerIntent.TOGGLE_ERASER
+            StylusAction.UNDO -> PointerIntent.UNDO
+            StylusAction.QUICK_MENU -> PointerIntent.QUICK_MENU
+            StylusAction.PAN -> PointerIntent.PAN
+        }
+
+    private fun of(action: MouseAction): PointerIntent =
+        when (action) {
+            MouseAction.QUICK_MENU -> PointerIntent.QUICK_MENU
+            MouseAction.EYEDROPPER -> PointerIntent.SAMPLE
+            MouseAction.NONE -> PointerIntent.NOTHING
+        }
+}
+
+/**
+ * Tells a stylus button press apart from a button that is merely still held. Feed it the button state of every
+ * stylus event, hovering or touching; a press is reported once, whichever event first showed it.
+ */
+class StylusClicks {
+    private var primaryHeld = false
+    private var secondaryHeld = false
+
+    /** The buttons that [buttons] shows pressed and the previous reading did not. */
+    fun observe(buttons: Int): Set<StylusButton> {
+        val primary = buttons and (PointerIntents.BUTTON_STYLUS_PRIMARY or PointerIntents.BUTTON_SECONDARY) != 0
+        val secondary = buttons and (PointerIntents.BUTTON_STYLUS_SECONDARY or PointerIntents.BUTTON_TERTIARY) != 0
+        val fresh =
+            buildSet {
+                if (primary && !primaryHeld) add(StylusButton.PRIMARY)
+                if (secondary && !secondaryHeld) add(StylusButton.SECONDARY)
+            }
+        primaryHeld = primary
+        secondaryHeld = secondary
+        return fresh
+    }
+
+    /** Forgets what was held: the pen left the screen, so a release may have gone unseen. */
+    fun reset() {
+        primaryHeld = false
+        secondaryHeld = false
+    }
+}
diff --git a/app/src/main/java/com/artflow/studio/core/canvas/PointerKind.kt b/app/src/main/java/com/artflow/studio/core/canvas/PointerKind.kt
new file mode 100644
index 0000000..3f4be9e
--- /dev/null
+++ b/app/src/main/java/com/artflow/studio/core/canvas/PointerKind.kt
@@ -0,0 +1,41 @@
+package com.artflow.studio.core.canvas
+
+/**
+ * What produced a pointer, taken from Android's tool type. The numbers are the documented values of
+ * `MotionEvent.TOOL_TYPE_*`, so this file stays free of Android imports and can be tested on the JVM.
+ */
+enum class PointerKind {
+    FINGER,
+    STYLUS,
+
+    /** The eraser end of a stylus. */
+    ERASER,
+    MOUSE,
+
+    /** A contact the device itself has recognised as a resting hand (Android 14 and later). */
+    PALM,
+    ;
+
+    /** A pen, its eraser end or a mouse: pointers that aim exactly and are never a resting hand. */
+    val isPrecise: Boolean get() = this == STYLUS || this == ERASER || this == MOUSE
+
+    /** The pen, or the pen turned over. */
+    val isStylus: Boolean get() = this == STYLUS || this == ERASER
+
+    companion object {
+        private const val TOOL_STYLUS = 2
+        private const val TOOL_MOUSE = 3
+        private const val TOOL_ERASER = 4
+        private const val TOOL_PALM = 5
+
+        /** The kind for a `MotionEvent` tool type; a finger, and the "unknown" some touchscreens report, are fingers. */
+        fun ofToolType(toolType: Int): PointerKind =
+            when (toolType) {
+                TOOL_STYLUS -> STYLUS
+                TOOL_MOUSE -> MOUSE
+                TOOL_ERASER -> ERASER
+                TOOL_PALM -> PALM
+                else -> FINGER
+            }
+    }
+}
