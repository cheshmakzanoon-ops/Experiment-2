+++ b/app/src/main/java/com/artflow/studio/core/canvas/TouchGestures.kt
@@ -0,0 +1,145 @@
+package com.artflow.studio.core.canvas
+
+/** A gesture that Gesture controls knows by name; the practice pad calls it out as it is recognised. */
+enum class TouchGesture(
+    /** A finger shortcut: switched off by "Disable touch actions" while a stylus is in use. */
+    val isShortcut: Boolean = false,
+) {
+    DRAW_PEN,
+    DRAW_FINGER,
+    DRAW_MOUSE,
+    TAP_TWO(isShortcut = true),
+    TAP_THREE(isShortcut = true),
+    TAP_FOUR(isShortcut = true),
+    HOLD_TWO(isShortcut = true),
+    HOLD_THREE(isShortcut = true),
+    SWIPE_THREE(isShortcut = true),
+    SCRUB_THREE(isShortcut = true),
+    TOUCH_AND_HOLD(isShortcut = true),
+    PEN_HOLD,
+    PINCH,
+    ROTATE,
+    DRAG_TWO,
+    QUICK_PINCH,
+    STYLUS_BUTTON,
+    STYLUS_BUTTON_2,
+    ERASER_END,
+    RIGHT_CLICK,
+    MIDDLE_CLICK,
+}
+
+/** What a recognised gesture makes the editor do. */
+enum class GestureResult {
+    DRAW,
+    UNDO,
+    REDO,
+    RAPID_UNDO,
+    RAPID_REDO,
+    FULL_SCREEN,
+    COPY_PASTE,
+    CLEAR_LAYER,
+    FIT_TO_SCREEN,
+    EYEDROPPER,
+    QUICK_MENU,
+    SELECT_LAYER,
+    QUICK_SHAPE,
+    ZOOM_VIEW,
+    ROTATE_VIEW,
+    PAN_VIEW,
+    ERASE,
+    TOGGLE_ERASER,
+}
+
+/**
+ * Which gesture a router outcome is, and what it does under the current settings. The editor's canvas and the
+ * practice pad both ask here, so the pad shows exactly what the canvas would do.
+ */
+object TouchGestures {
+    /** The gesture a finished touch was: a tap of two, three or four fingers, or a quick pinch, else null. */
+    fun finished(
+        historyPointers: Int,
+        quickPinch: Boolean,
+    ): TouchGesture? =
+        when {
+            historyPointers == 2 -> TouchGesture.TAP_TWO
+            historyPointers == 3 -> TouchGesture.TAP_THREE
+            historyPointers == 4 -> TouchGesture.TAP_FOUR
+            quickPinch -> TouchGesture.QUICK_PINCH
+            else -> null
+        }
+
+    /** The gesture that resting two or three fingers become once the rapid-undo delay has passed. */
+    fun held(fingers: Int): TouchGesture? =
+        when (fingers) {
+            2 -> TouchGesture.HOLD_TWO
+            3 -> TouchGesture.HOLD_THREE
+            else -> null
+        }
+
+    /** The gesture the router reports for three fingers moving together, or null for any other action. */
+    fun threeFinger(action: PointerGestureRouter.Action): TouchGesture? =
+        when (action) {
+            PointerGestureRouter.Action.THREE_FINGER_SWIPE_DOWN -> TouchGesture.SWIPE_THREE
+            PointerGestureRouter.Action.THREE_FINGER_SCRUB -> TouchGesture.SCRUB_THREE
+            else -> null
+        }
+
+    /**
+     * What [gesture] does, or null when it does nothing: its switch is off, nothing is assigned to it, or
+     * [touchActionsOff] (Disable touch actions, with a stylus in use) silences finger shortcuts.
+     */
+    fun result(
+        gesture: TouchGesture,
+        settings: GestureSettings,
+        touchActionsOff: Boolean = false,
+    ): GestureResult? {
+        if (gesture.isShortcut && touchActionsOff) return null
+        return when (gesture) {
+            TouchGesture.DRAW_PEN, TouchGesture.DRAW_FINGER, TouchGesture.DRAW_MOUSE -> GestureResult.DRAW
+            TouchGesture.TAP_TWO -> GestureResult.UNDO
+            TouchGesture.TAP_THREE -> GestureResult.REDO
+            TouchGesture.TAP_FOUR -> GestureResult.FULL_SCREEN.takeIf { settings.fourFingerFullScreen }
+            TouchGesture.HOLD_TWO -> GestureResult.RAPID_UNDO
+            TouchGesture.HOLD_THREE -> GestureResult.RAPID_REDO
+            TouchGesture.SWIPE_THREE -> GestureResult.COPY_PASTE.takeIf { settings.swipeCopyPaste }
+            TouchGesture.SCRUB_THREE -> GestureResult.CLEAR_LAYER.takeIf { settings.scrubToClear }
+            TouchGesture.TOUCH_AND_HOLD -> holdResult(settings.holdAction)
+            TouchGesture.PEN_HOLD -> GestureResult.QUICK_SHAPE.takeIf { settings.quickShape }
+            TouchGesture.PINCH -> GestureResult.ZOOM_VIEW
+            TouchGesture.ROTATE -> GestureResult.ROTATE_VIEW
+            TouchGesture.DRAG_TWO -> GestureResult.PAN_VIEW
+            TouchGesture.QUICK_PINCH -> GestureResult.FIT_TO_SCREEN
+            TouchGesture.STYLUS_BUTTON -> stylusResult(settings.stylus.primary)
+            TouchGesture.STYLUS_BUTTON_2 -> stylusResult(settings.stylus.secondary)
+            TouchGesture.ERASER_END -> stylusResult(settings.stylus.eraserEnd)
+            TouchGesture.RIGHT_CLICK -> mouseResult(settings.rightClick)
+            TouchGesture.MIDDLE_CLICK -> GestureResult.PAN_VIEW
+        }
+    }
+
+    private fun holdResult(action: HoldAction): GestureResult? =
+        when (action) {
+            HoldAction.EYEDROPPER -> GestureResult.EYEDROPPER
+            HoldAction.QUICK_MENU -> GestureResult.QUICK_MENU
+            HoldAction.SELECT_LAYER -> GestureResult.SELECT_LAYER
+            HoldAction.NONE -> null
+        }
+
+    private fun stylusResult(action: StylusAction): GestureResult? =
+        when (action) {
+            StylusAction.NONE -> null
+            StylusAction.EYEDROPPER -> GestureResult.EYEDROPPER
+            StylusAction.ERASE -> GestureResult.ERASE
+            StylusAction.TOGGLE_ERASER -> GestureResult.TOGGLE_ERASER
+            StylusAction.UNDO -> GestureResult.UNDO
+            StylusAction.QUICK_MENU -> GestureResult.QUICK_MENU
+            StylusAction.PAN -> GestureResult.PAN_VIEW
+        }
+
+    private fun mouseResult(action: MouseAction): GestureResult? =
+        when (action) {
+            MouseAction.QUICK_MENU -> GestureResult.QUICK_MENU
+            MouseAction.EYEDROPPER -> GestureResult.EYEDROPPER
+            MouseAction.NONE -> null
+        }
+}
diff --git a/app/src/main/java/com/artflow/studio/core/canvas/ViewMath.kt b/app/src/main/java/com/artflow/studio/core/canvas/ViewMath.kt
