+package com.artflow.studio.core.canvas
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ViewMathTest {
+    @Test
+    fun zoomPercentIsScreenPixelsPerCanvasPixel() {
+        assertEquals(100, ViewMath.zoomPercent(1f))
+        assertEquals(60, ViewMath.zoomPercent(1200f / 2000f))
+        assertEquals(250, ViewMath.zoomPercent(2.5f))
+        assertEquals(0, ViewMath.zoomPercent(0.004f))
+        for (unusable in listOf(0f, -1f, Float.NaN, Float.POSITIVE_INFINITY)) assertEquals(0, ViewMath.zoomPercent(unusable))
+    }
+
+    @Test
+    fun zoomingAboutTheMiddleOfTheViewScalesTheOffset() {
+        val (x, y) = ViewMath.zoomAbout(0f, 0f, 1f, 2f, 10f, -20f)
+        assertEquals(20f, x, 0.0001f)
+        assertEquals(-40f, y, 0.0001f)
+    }
+
+    @Test
+    fun theCanvasPointUnderThePointerStaysPut() {
+        // A canvas point 100 px right of the canvas centre sits under a pointer 100 px right of the view centre.
+        val (x, _) = ViewMath.zoomAbout(100f, 0f, 1f, 2f, 0f, 0f)
+        assertEquals(-100f, x, 0.0001f)
+        // The point is still 100 canvas px from the centre, now drawn 200 px from it: -100 + 200 = 100, under the pointer.
+        assertEquals(100f, x + 2f * 100f, 0.0001f)
+    }
+
+    @Test
+    fun zoomingOutAndBackReturnsTheOffset() {
+        val (ox, oy) = ViewMath.zoomAbout(137f, -52f, 0.8f, 1.7f, 33f, 91f)
+        val (bx, by) = ViewMath.zoomAbout(137f, -52f, 1.7f, 0.8f, ox, oy)
+        assertEquals(33f, bx, 0.001f)
+        assertEquals(91f, by, 0.001f)
+    }
+
+    @Test
+    fun anUnusableScaleLeavesTheOffsetAlone() {
+        assertEquals(5f to 6f, ViewMath.zoomAbout(10f, 10f, 0f, 2f, 5f, 6f))
+        assertEquals(5f to 6f, ViewMath.zoomAbout(10f, 10f, 1f, Float.NaN, 5f, 6f))
+    }
+
+    @Test
+    fun theWheelPansAndCtrlZooms() {
+        val pan = ViewMath.wheel(vertical = 1f, horizontal = 0f, ctrl = false, shift = false, pixelsPerVerticalUnit = 48f, pixelsPerHorizontalUnit = 40f)
+        assertFalse(pan.isZoom)
+        assertEquals(48f, pan.panY, 0f)
+        assertEquals(0f, pan.panX, 0f)
+
+        val sideways = ViewMath.wheel(0f, 1f, ctrl = false, shift = false, pixelsPerVerticalUnit = 48f, pixelsPerHorizontalUnit = 40f)
+        assertEquals("Scrolling right moves the artwork left", -40f, sideways.panX, 0f)
+
+        val zoomIn = ViewMath.wheel(1f, 0f, ctrl = true, shift = false, pixelsPerVerticalUnit = 48f, pixelsPerHorizontalUnit = 40f)
+        assertTrue(zoomIn.isZoom)
+        assertTrue("Wheel up zooms in", zoomIn.zoomFactor > 1.1f && zoomIn.zoomFactor < 1.15f)
+        assertEquals(0f, zoomIn.panY, 0f)
+
+        val zoomOut = ViewMath.wheel(-1f, 0f, ctrl = true, shift = false, pixelsPerVerticalUnit = 48f, pixelsPerHorizontalUnit = 40f)
+        assertEquals("A notch back undoes a notch", 1f, zoomIn.zoomFactor * zoomOut.zoomFactor, 0.0001f)
+    }
+
+    @Test
+    fun shiftTurnsAVerticalWheelIntoAHorizontalPan() {
+        val move = ViewMath.wheel(2f, 0f, ctrl = false, shift = true, pixelsPerVerticalUnit = 48f, pixelsPerHorizontalUnit = 40f)
+        assertEquals(80f, move.panX, 0f)
+        assertEquals(0f, move.panY, 0f)
+    }
+
+    @Test
+    fun aBurstFromATrackpadIsKeptInRangeAndGarbageIsIgnored() {
+        val burst = ViewMath.wheel(500f, 0f, ctrl = true, shift = false, pixelsPerVerticalUnit = 48f, pixelsPerHorizontalUnit = 40f)
+        assertTrue(burst.zoomFactor < 3f)
+        val garbage = ViewMath.wheel(Float.NaN, Float.POSITIVE_INFINITY, ctrl = false, shift = false, 48f, 40f)
+        assertEquals(0f, garbage.panX, 0f)
+        assertEquals(0f, garbage.panY, 0f)
+        assertFalse(garbage.isZoom)
+    }
+
+    @Test
+    fun aTrackpadPinchIsAZoomFactorOrNothing() {
+        assertEquals(1.1f, ViewMath.pinchFactor(1.1f), 0f)
+        for (unusable in listOf(0f, -2f, Float.NaN, Float.POSITIVE_INFINITY)) assertEquals(1f, ViewMath.pinchFactor(unusable), 0f)
+    }
+}
