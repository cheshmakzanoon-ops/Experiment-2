+++ b/app/src/test/java/com/artflow/studio/core/canvas/RotationSnapTest.kt
@@ -0,0 +1,115 @@
+package com.artflow.studio.core.canvas
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class RotationSnapTest {
+    private val snap = RotationSnap()
+
+    @Test
+    fun theCanvasClicksIntoPlaceWhenTheFingersComeWithinTheCatchAngle() {
+        snap.begin(30f)
+        val far = snap.rotate(11f) // 41: four degrees short of 45
+        assertEquals(41f, far.angle, 0f)
+        assertFalse(far.snapped)
+        val near = snap.rotate(1f) // 42: three degrees short
+        assertEquals(45f, near.angle, 0f)
+        assertTrue(near.snapped)
+        assertTrue("The click is reported once, at the moment of catching", near.caught)
+    }
+
+    @Test
+    fun itHoldsThroughTheReleaseAngleAndThenLetsGo() {
+        snap.begin(30f)
+        snap.rotate(14f) // 44: caught
+        assertEquals(45f, snap.rotate(3f).angle, 0f) // 47
+        val held = snap.rotate(4.9f) // 51.9: still within seven degrees
+        assertEquals(45f, held.angle, 0f)
+        assertFalse("It was caught already; holding is not a new click", held.caught)
+        val free = snap.rotate(0.6f) // 52.5: beyond seven degrees
+        assertEquals(52.5f, free.angle, 0.0001f)
+        assertFalse(free.snapped)
+    }
+
+    @Test
+    fun hysteresisKeepsAWobblingHandFromFlickering() {
+        snap.begin(30f)
+        snap.rotate(14f)
+        // The fingers wobble across the edge of the catch zone (48.5 degrees): the canvas must not move.
+        val angles = listOf(4f, -0.2f, 0.4f, -0.4f, 0.3f, -0.3f).map { snap.rotate(it).angle }
+        assertTrue(angles.all { it == 45f })
+    }
+
+    @Test
+    fun afterLettingGoItTakesTheSmallCatchAngleNotTheLargeReleaseAngleToClickInAgain() {
+        snap.begin(30f)
+        snap.rotate(14f) // 44: caught on 45
+        assertFalse(snap.rotate(9f).snapped) // 53: eight degrees off, let go
+        assertFalse(snap.rotate(-2f).snapped) // 51: six degrees off
+        assertFalse("Within the release angle but outside the catch angle", snap.rotate(-2f).snapped) // 49: four degrees off
+        val again = snap.rotate(-1f) // 48: three degrees off
+        assertTrue(again.snapped)
+        assertTrue(again.caught)
+        assertEquals(45f, again.angle, 0f)
+    }
+
+    @Test
+    fun aCanvasThatStartsOnAMultipleStaysThereWithoutAClick() {
+        snap.begin(90f)
+        val result = snap.rotate(2f)
+        assertEquals(90f, result.angle, 0f)
+        assertTrue(result.snapped)
+        assertFalse(result.caught)
+    }
+
+    @Test
+    fun aCanvasThatStartsNearAMultipleIsNotPulledToItAtOnce() {
+        snap.begin(93.4f)
+        val result = snap.rotate(0.1f)
+        assertEquals(93.5f, result.angle, 0.0001f)
+        assertFalse(result.snapped)
+    }
+
+    @Test
+    fun aFastTurnThatJumpsOverTheCatchZoneDoesNotSnap() {
+        snap.begin(30f)
+        val result = snap.rotate(25f) // 55: from 30 straight past 45
+        assertEquals(55f, result.angle, 0f)
+        assertFalse(result.snapped)
+    }
+
+    @Test
+    fun everyMultipleOf45CatchesInBothDirectionsAndAcrossZero() {
+        snap.begin(-40f)
+        val negative = snap.rotate(-3f) // -43
+        assertEquals(-45f, negative.angle, 0f)
+        assertTrue(negative.caught)
+
+        val across = RotationSnap()
+        across.begin(350f)
+        val results = listOf(5f, 3f, 3f).map { across.rotate(it) } // 355, 358, 361
+        assertEquals(355f, results[0].angle, 0f)
+        assertEquals(360f, results[1].angle, 0f)
+        assertTrue(results[1].caught)
+        assertEquals(360f, results[2].angle, 0f)
+        assertEquals(0f, RotationSnap.normalized(360f), 0f)
+    }
+
+    @Test
+    fun anAngleBetweenTwoReadingsTakesTheShortWayRound() {
+        assertEquals(-170f, RotationSnap.shortestTurn(190f), 0f)
+        assertEquals(170f, RotationSnap.shortestTurn(-190f), 0f)
+        assertEquals(10f, RotationSnap.shortestTurn(10f), 0f)
+        assertEquals(-20f, RotationSnap.shortestTurn(340f), 0f)
+        assertEquals(0f, RotationSnap.shortestTurn(Float.NaN), 0f)
+        assertEquals(350f, RotationSnap.normalized(-10f), 0f)
+        assertEquals(10f, RotationSnap.normalized(730f), 0f)
+    }
+
+    @Test(expected = IllegalArgumentException::class)
+    fun zonesThatCannotFitInsideOneStepAreRefused() {
+        RotationSnap(step = 10f, capture = 3f, release = 6f)
+    }
+}
