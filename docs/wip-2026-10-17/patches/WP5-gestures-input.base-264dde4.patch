@@ -0,0 +1,59 @@
+package com.artflow.studio.core.canvas
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class GestureSettingsTest {
+    @Test
+    fun theDefaultsAreWhatTheEditorDidBeforeTheyWereOptions() {
+        val defaults = GestureSettings()
+        assertTrue(defaults.scrubToClear && defaults.swipeCopyPaste && defaults.fourFingerFullScreen)
+        assertEquals("Touch and hold sampled colour after half a second", HoldAction.EYEDROPPER, defaults.holdAction)
+        assertEquals(500, defaults.holdDelayMs)
+        assertEquals("QuickShape waited 650 ms", 650, defaults.quickShapeDelayMs)
+        assertEquals("Rapid undo waited 650 ms", 650, defaults.rapidUndoDelayMs)
+        assertEquals(StylusAction.EYEDROPPER, defaults.stylus.primary)
+        assertEquals(StylusAction.NONE, defaults.stylus.secondary)
+        assertEquals(StylusAction.ERASE, defaults.stylus.eraserEnd)
+        assertTrue(!defaults.disableTouchActions)
+    }
+
+    @Test
+    fun delaysAreKeptInsideTheirRange() {
+        val wild = GestureSettings(holdDelayMs = 5, quickShapeDelayMs = 99_999, rapidUndoDelayMs = -3).normalized()
+        assertEquals(GestureSettings.MIN_DELAY_MS, wild.holdDelayMs)
+        assertEquals(GestureSettings.MAX_DELAY_MS, wild.quickShapeDelayMs)
+        assertEquals(GestureSettings.MIN_DELAY_MS, wild.rapidUndoDelayMs)
+        val fine = GestureSettings(holdDelayMs = 700)
+        assertEquals(fine, fine.normalized())
+    }
+
+    @Test
+    fun theQuickMenuListsEveryWayToOpenIt() {
+        assertEquals(listOf(QuickMenuTrigger.HANDLE, QuickMenuTrigger.RIGHT_CLICK), GestureSettings().quickMenuTriggers())
+        val everywhere =
+            GestureSettings(
+                holdAction = HoldAction.QUICK_MENU,
+                stylus = StylusMapping(StylusAction.QUICK_MENU, StylusAction.QUICK_MENU, StylusAction.QUICK_MENU),
+                rightClick = MouseAction.QUICK_MENU,
+            )
+        assertEquals(QuickMenuTrigger.entries, everywhere.quickMenuTriggers())
+        val handleOnly = GestureSettings(rightClick = MouseAction.NONE)
+        assertEquals(listOf(QuickMenuTrigger.HANDLE), handleOnly.quickMenuTriggers())
+    }
+
+    @Test
+    fun toolTypesBecomePointerKinds() {
+        assertEquals(PointerKind.FINGER, PointerKind.ofToolType(1))
+        assertEquals(PointerKind.STYLUS, PointerKind.ofToolType(2))
+        assertEquals(PointerKind.MOUSE, PointerKind.ofToolType(3))
+        assertEquals(PointerKind.ERASER, PointerKind.ofToolType(4))
+        assertEquals(PointerKind.PALM, PointerKind.ofToolType(5))
+        assertEquals("Unknown tool types behave as fingers did before", PointerKind.FINGER, PointerKind.ofToolType(0))
+        assertEquals(PointerKind.FINGER, PointerKind.ofToolType(99))
+        assertTrue(PointerKind.MOUSE.isPrecise && PointerKind.STYLUS.isPrecise && PointerKind.ERASER.isPrecise)
+        assertTrue(!PointerKind.FINGER.isPrecise && !PointerKind.PALM.isPrecise)
+        assertTrue(PointerKind.ERASER.isStylus && !PointerKind.MOUSE.isStylus)
+    }
+}
