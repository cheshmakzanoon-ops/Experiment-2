--- /dev/null
+++ b/app/src/main/java/com/artflow/studio/core/canvas/ViewMath.kt
@@ -0,0 +1,74 @@
+package com.artflow.studio.core.canvas
+
+import kotlin.math.exp
+import kotlin.math.roundToInt
+
+/** How far a pointer moves the view, in screen pixels, and by what factor it zooms. */
+data class WheelMove(
+    val zoomFactor: Float = 1f,
+    val panX: Float = 0f,
+    val panY: Float = 0f,
+) {
+    val isZoom: Boolean get() = zoomFactor != 1f
+}
+
+/** The arithmetic behind the view transform, kept apart from the view so it can be tested. */
+object ViewMath {
+    /**
+     * The zoom shown to the artist. The view scale is screen pixels per canvas pixel, so 100% puts one canvas pixel on
+     * one screen pixel (what Procreate calls actual size) and a 2000 px wide canvas on a 1200 px wide screen is 60%.
+     * It is measured against device pixels, not against the document's dpi.
+     */
+    fun zoomPercent(scale: Float): Int = if (scale.isFinite() && scale > 0f) (scale * PERCENT).roundToInt() else 0
+
+    /**
+     * The view offset that keeps the canvas point under ([pointerX], [pointerY]) where it is while the scale goes from
+     * [scale] to [newScale]. The pointer is relative to the middle of the view, and the offset is the one the view
+     * already uses (the canvas centre's distance from the view's centre). Rotation does not change the answer.
+     */
+    fun zoomAbout(
+        pointerX: Float,
+        pointerY: Float,
+        scale: Float,
+        newScale: Float,
+        offsetX: Float,
+        offsetY: Float,
+    ): Pair<Float, Float> {
+        if (!(scale > 0f) || !newScale.isFinite()) return offsetX to offsetY
+        val ratio = newScale / scale
+        return (pointerX - ratio * (pointerX - offsetX)) to (pointerY - ratio * (pointerY - offsetY))
+    }
+
+    /**
+     * What a scroll wheel or trackpad scroll does. Scrolling alone pans (vertical wheel up moves the artwork down, as
+     * in any scrolling list); Shift turns a vertical wheel into a horizontal pan; Ctrl zooms about the pointer, wheel
+     * up zooming in. [units] are `AXIS_VSCROLL` and `AXIS_HSCROLL` values, one per notch, and the pixel factors are
+     * how far Android scrolls a list for one unit.
+     */
+    fun wheel(
+        vertical: Float,
+        horizontal: Float,
+        ctrl: Boolean,
+        shift: Boolean,
+        pixelsPerVerticalUnit: Float,
+        pixelsPerHorizontalUnit: Float,
+    ): WheelMove {
+        val v = clean(vertical)
+        val h = clean(horizontal)
+        if (ctrl) return WheelMove(zoomFactor = exp((v + h) * ZOOM_PER_UNIT))
+        if (shift && h == 0f) return WheelMove(panX = v * pixelsPerHorizontalUnit)
+        return WheelMove(panX = -h * pixelsPerHorizontalUnit, panY = v * pixelsPerVerticalUnit)
+    }
+
+    /** The factor a trackpad pinch of [scaleChange] (1.1 = the fingers spread 10% further apart) zooms by; 1 when unusable. */
+    fun pinchFactor(scaleChange: Float): Float = if (scaleChange.isFinite() && scaleChange > 0f) scaleChange else 1f
+
+    /** A wheel reading, with a burst from a trackpad kept in range and anything unusable ignored. */
+    private fun clean(units: Float): Float = if (units.isFinite()) units.coerceIn(-MAX_UNITS, MAX_UNITS) else 0f
+
+    private const val PERCENT = 100f
+
+    /** One notch zooms about 12%, and a trackpad's small steps add up smoothly. */
+    private const val ZOOM_PER_UNIT = 0.115f
+    private const val MAX_UNITS = 8f
+}
