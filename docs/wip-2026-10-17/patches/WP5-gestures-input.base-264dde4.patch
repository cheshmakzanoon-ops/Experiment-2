+package com.artflow.studio.core.canvas
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class PalmRejectionTest {
+    private val palm = PalmRejection()
+
+    private fun isPalm(
+        kind: PointerKind,
+        millimetres: Float,
+        time: Long,
+        enabled: Boolean = true,
+    ) = palm.isPalm(kind, millimetres, time, enabled)
+
+    @Test
+    fun aBigTouchIsOnlyAPalmOnceAStylusHasBeenSeen() {
+        assertFalse("Nobody has used a pen: a big finger is a finger", isPalm(PointerKind.FINGER, 40f, 1_000))
+        palm.stylusSeen(2_000)
+        assertTrue(isPalm(PointerKind.FINGER, 40f, 3_000))
+        assertTrue("The edge of the zone counts", isPalm(PointerKind.FINGER, PalmRejection.PALM_MILLIMETRES, 3_000))
+    }
+
+    @Test
+    fun fingertipsAndThumbPadsAreNeverPalms() {
+        palm.stylusSeen(0)
+        for (millimetres in listOf(6f, 10f, 14f, 20f, 23.9f)) assertFalse(isPalm(PointerKind.FINGER, millimetres, 1_000))
+    }
+
+    @Test
+    fun aDeviceThatReportsNoContactSizeIsNotJudgedBySize() {
+        palm.stylusSeen(0)
+        assertFalse(isPalm(PointerKind.FINGER, 0f, 1_000))
+        assertFalse(isPalm(PointerKind.FINGER, Float.NaN, 1_000))
+    }
+
+    @Test
+    fun theStylusIsRememberedForFiveMinutesAndNoLonger() {
+        palm.stylusSeen(10_000)
+        assertTrue(palm.stylusInUse(10_000))
+        assertTrue(palm.stylusInUse(10_000 + PalmRejection.STYLUS_MEMORY_MILLIS))
+        assertFalse(palm.stylusInUse(10_001 + PalmRejection.STYLUS_MEMORY_MILLIS))
+        assertFalse("A clock that steps back is not 'in use'", palm.stylusInUse(9_000))
+        assertFalse(PalmRejection().stylusInUse(0))
+        assertFalse(isPalm(PointerKind.FINGER, 40f, 20_000 + PalmRejection.STYLUS_MEMORY_MILLIS))
+    }
+
+    @Test
+    fun theSettingTurnsSizeRejectionOffButNotTheDevicesOwnPalmReport() {
+        palm.stylusSeen(0)
+        assertFalse(isPalm(PointerKind.FINGER, 40f, 1_000, enabled = false))
+        assertTrue(isPalm(PointerKind.PALM, 0f, 1_000, enabled = false))
+        assertTrue(isPalm(PointerKind.PALM, 0f, 1_000))
+    }
+
+    @Test
+    fun aPenAndAMouseAreNeverResting() {
+        palm.stylusSeen(0)
+        for (kind in listOf(PointerKind.STYLUS, PointerKind.ERASER, PointerKind.MOUSE)) assertFalse(isPalm(kind, 80f, 1_000))
+    }
+
+    @Test
+    fun contactSizeIsConvertedFromPixelsUsingTheScreenDensity() {
+        assertEquals(10f, PalmRejection.millimetres(100f, 254f), 0.0001f)
+        assertEquals(25.4f, PalmRejection.millimetres(160f, 160f), 0.0001f)
+        for ((pixels, dpi) in listOf(0f to 160f, -5f to 160f, 100f to 0f, Float.NaN to 160f, 100f to Float.POSITIVE_INFINITY)) {
+            assertEquals(0f, PalmRejection.millimetres(pixels, dpi), 0f)
+        }
+    }
+}
diff --git a/app/src/test/java/com/artflow/studio/core/canvas/PointerGestureRouterTest.kt b/app/src/test/java/com/artflow/studio/core/canvas/PointerGestureRouterTest.kt
index fb831c5..7ec8b7b 100644
--- a/app/src/test/java/com/artflow/studio/core/canvas/PointerGestureRouterTest.kt
+++ b/app/src/test/java/com/artflow/studio/core/canvas/PointerGestureRouterTest.kt
@@ -310,4 +310,97 @@ class PointerGestureRouterTest {
     fun aFingerStartsAToolWhenNoPenHasLifted() {
         assertEquals(Action.START_TOOL, send(Event.DOWN, finger).action)
     }
+
+    private val mouse = Pointer(1, 40f, 40f, mouse = true)
+    private val palm = Pointer(30, 200f, 200f, palm = true)
+
+    @Test
+    fun aMouseDrawsAndOpensNoPalmWindowBehindIt() {
+        assertEquals(Action.START_TOOL, send(Event.DOWN, mouse).action)
+        assertEquals(Action.MOVE_TOOL, send(Event.MOVE, mouse.copy(x = 80f)).action)
+        assertEquals(Action.END_TOOL, send(Event.UP, mouse.copy(x = 80f)).action)
+        assertEquals("A touch straight after a click is a finger, not a palm", Action.START_TOOL, send(Event.DOWN, finger).action)
+    }
+
+    @Test
+    fun aMouseIsNeverTakenForAPalmAfterAPen() {
+        send(Event.DOWN, pen)
+        send(Event.UP, pen)
+        assertEquals(Action.START_TOOL, send(Event.DOWN, mouse).action)
+    }
+
+    @Test
+    fun aPalmThatLandsFirstStartsNothingAndLeavesNoTrace() {
+        assertEquals(Action.IGNORE, send(Event.DOWN, palm).action)
+        assertEquals(Action.IGNORE, send(Event.MOVE, palm.copy(x = 210f)).action)
+        assertEquals(Action.IGNORE, send(Event.UP, palm).action)
+        assertEquals(Action.START_TOOL, send(Event.DOWN, finger).action)
+    }
+
+    @Test
+    fun aPenTakesOverFromAPalmAndTheIndexStillPointsIntoTheEvent() {
+        send(Event.DOWN, palm)
+        val start = send(Event.POINTER_DOWN, palm, pen, changed = 1)
+        assertEquals(Action.START_TOOL, start.action)
+        assertEquals(1, start.index)
+        val move = send(Event.MOVE, palm, pen.copy(x = 90f))
+        assertEquals(Action.MOVE_TOOL, move.action)
+        assertEquals(1, move.index)
+    }
+
+    @Test
+    fun aPalmLandingOnATwoFingerTapDoesNotMakeItARedo() {
+        send(Event.DOWN, finger)
+        send(Event.POINTER_DOWN, finger, other, changed = 1)
+        assertEquals(Action.IGNORE, send(Event.POINTER_DOWN, finger, other, palm, changed = 2).action)
+        assertEquals(Action.IGNORE, send(Event.POINTER_UP, finger, other, palm, changed = 2).action)
+        send(Event.POINTER_UP, finger, other, changed = 1)
+        val up = send(Event.UP, finger)
+        assertEquals(Action.FINISH_NAVIGATION, up.action)
+        assertEquals(2, up.historyPointers)
+    }
+
+    @Test
+    fun aPalmBesideAFingerStrokeDoesNotTurnItIntoNavigation() {
+        assertEquals(Action.START_TOOL, send(Event.DOWN, finger).action)
+        assertEquals(Action.IGNORE, send(Event.POINTER_DOWN, finger, palm, changed = 1).action)
+        assertEquals(Action.MOVE_TOOL, send(Event.MOVE, finger.copy(x = 50f), palm).action)
+        assertEquals(Action.END_TOOL, send(Event.UP, finger.copy(x = 50f)).action)
+    }
+
+    @Test
+    fun aContactThatGrowsIntoAPalmCancelsItsStroke() {
+        assertEquals(Action.START_TOOL, send(Event.DOWN, finger).action)
+        assertEquals(Action.MOVE_TOOL, send(Event.MOVE, finger.copy(x = 30f)).action)
+        assertEquals(Action.CANCEL, send(Event.MOVE, finger.copy(x = 40f, palm = true)).action)
+        assertEquals(Action.IGNORE, send(Event.MOVE, finger.copy(x = 50f)).action)
+        assertEquals(Action.IGNORE, send(Event.UP, finger).action)
+    }
+
+    @Test
+    fun aReusedPointerIdIsNotStillAPalm() {
+        send(Event.DOWN, finger)
+        val hand = palm.copy(id = other.id)
+        send(Event.POINTER_DOWN, finger, hand, changed = 1)
+        send(Event.POINTER_UP, finger, hand, changed = 1)
+        assertEquals(Action.REBASE_NAVIGATION, send(Event.POINTER_DOWN, finger, other, changed = 1).action)
+    }
+
+    @Test
+    fun aPalmThatLiftsLastEndsTheNavigationWithoutATap() {
+        send(Event.DOWN, finger)
+        send(Event.POINTER_DOWN, finger, other, changed = 1)
+        send(Event.POINTER_DOWN, finger, other, palm, changed = 2)
+        send(Event.POINTER_UP, finger, other, palm, changed = 0)
+        send(Event.POINTER_UP, other, palm, changed = 0)
+        val up = send(Event.UP, palm)
+        assertEquals(Action.FINISH_NAVIGATION, up.action)
+        assertEquals(0, up.historyPointers)
+    }
+
+    @Test
+    fun aPalmIsIgnoredBySizeEvenWhenItIsTheOnlyContact() {
+        assertEquals(Action.IGNORE, send(Event.DOWN, palm).action)
+        assertEquals(0, router.heldFingers())
+    }
 }
