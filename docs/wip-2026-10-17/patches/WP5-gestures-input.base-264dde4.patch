@@ -0,0 +1,120 @@
+package com.artflow.studio.core.canvas
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class PointerIntentsTest {
+    private val defaults = GestureSettings()
+
+    private fun at(
+        kind: PointerKind,
+        buttons: Int = 0,
+        settings: GestureSettings = defaults,
+        fresh: Set<StylusButton> = emptySet(),
+    ) = PointerIntents.atContact(kind, buttons, settings, fresh)
+
+    @Test
+    fun fingersAlwaysDraw() {
+        assertEquals(PointerIntent.DRAW, at(PointerKind.FINGER, PointerIntents.BUTTON_STYLUS_PRIMARY))
+        assertEquals(PointerIntent.DRAW, at(PointerKind.PALM))
+    }
+
+    @Test
+    fun theDefaultsKeepTodaysStylusBehaviour() {
+        assertEquals("The tip paints", PointerIntent.DRAW, at(PointerKind.STYLUS))
+        assertEquals("The side button samples colour", PointerIntent.SAMPLE, at(PointerKind.STYLUS, PointerIntents.BUTTON_STYLUS_PRIMARY))
+        assertEquals("The eraser end erases", PointerIntent.ERASE, at(PointerKind.ERASER))
+        assertEquals("The second button is unassigned", PointerIntent.DRAW, at(PointerKind.STYLUS, PointerIntents.BUTTON_STYLUS_SECONDARY))
+    }
+
+    @Test
+    fun devicesThatSpellTheBarrelButtonAsMouseButtonsAreUnderstood() {
+        assertEquals(PointerIntent.SAMPLE, at(PointerKind.STYLUS, PointerIntents.BUTTON_SECONDARY))
+        val mapped = defaults.copy(stylus = StylusMapping(secondary = StylusAction.PAN))
+        assertEquals(PointerIntent.PAN, at(PointerKind.STYLUS, PointerIntents.BUTTON_TERTIARY, mapped))
+        assertEquals(PointerIntent.PAN, at(PointerKind.STYLUS, PointerIntents.BUTTON_STYLUS_SECONDARY, mapped))
+        // Both held: the primary button wins.
+        assertEquals(PointerIntent.SAMPLE, at(PointerKind.STYLUS, PointerIntents.BUTTON_STYLUS_PRIMARY or PointerIntents.BUTTON_STYLUS_SECONDARY, mapped))
+    }
+
+    @Test
+    fun everyActionBecomesItsIntent() {
+        val expected =
+            mapOf(
+                StylusAction.NONE to PointerIntent.DRAW,
+                StylusAction.EYEDROPPER to PointerIntent.SAMPLE,
+                StylusAction.ERASE to PointerIntent.ERASE,
+                StylusAction.TOGGLE_ERASER to PointerIntent.TOGGLE_ERASER,
+                StylusAction.UNDO to PointerIntent.UNDO,
+                StylusAction.QUICK_MENU to PointerIntent.QUICK_MENU,
+                StylusAction.PAN to PointerIntent.PAN,
+            )
+        assertEquals(StylusAction.entries.toSet(), expected.keys)
+        val fresh = setOf(StylusButton.PRIMARY)
+        for ((action, intent) in expected) {
+            val settings = defaults.copy(stylus = StylusMapping(primary = action, eraserEnd = action))
+            assertEquals(intent, at(PointerKind.STYLUS, PointerIntents.BUTTON_STYLUS_PRIMARY, settings, fresh))
+            assertEquals(intent, at(PointerKind.ERASER, 0, settings))
+        }
+    }
+
+    @Test
+    fun aClickActionFiresOnceEvenWhenThePressHappenedWhileHovering() {
+        val settings = defaults.copy(stylus = StylusMapping(primary = StylusAction.UNDO))
+        val held = PointerIntents.BUTTON_STYLUS_PRIMARY
+        assertEquals(PointerIntent.UNDO, at(PointerKind.STYLUS, held, settings, setOf(StylusButton.PRIMARY)))
+        assertEquals("The press was already used in the air", PointerIntent.DRAW, at(PointerKind.STYLUS, held, settings, emptySet()))
+        assertTrue(PointerIntent.UNDO.isClick && PointerIntent.QUICK_MENU.isClick && PointerIntent.TOGGLE_ERASER.isClick)
+        assertTrue(!PointerIntent.SAMPLE.isClick && !PointerIntent.PAN.isClick && !PointerIntent.ERASE.isClick)
+    }
+
+    @Test
+    fun aButtonPressedInTheAirOnlyStartsClickActions() {
+        val mapping = StylusMapping(primary = StylusAction.UNDO, secondary = StylusAction.QUICK_MENU)
+        assertEquals(PointerIntent.UNDO, PointerIntents.inTheAir(setOf(StylusButton.PRIMARY), mapping))
+        assertEquals(PointerIntent.QUICK_MENU, PointerIntents.inTheAir(setOf(StylusButton.SECONDARY), mapping))
+        assertEquals(PointerIntent.UNDO, PointerIntents.inTheAir(setOf(StylusButton.SECONDARY, StylusButton.PRIMARY), mapping))
+        assertNull("Sampling needs the pen on the canvas", PointerIntents.inTheAir(setOf(StylusButton.PRIMARY), StylusMapping()))
+        assertNull(PointerIntents.inTheAir(emptySet(), mapping))
+    }
+
+    @Test
+    fun mouseButtonsPaintMenuAndPan() {
+        assertEquals(PointerIntent.DRAW, at(PointerKind.MOUSE, 0))
+        assertEquals(PointerIntent.DRAW, at(PointerKind.MOUSE, PointerIntents.BUTTON_PRIMARY))
+        assertEquals(PointerIntent.QUICK_MENU, at(PointerKind.MOUSE, PointerIntents.BUTTON_SECONDARY))
+        assertEquals(PointerIntent.PAN, at(PointerKind.MOUSE, PointerIntents.BUTTON_TERTIARY))
+        assertEquals("Left plus right is still a stroke", PointerIntent.DRAW, at(PointerKind.MOUSE, 3))
+        assertEquals("Side buttons are not used", PointerIntent.NOTHING, at(PointerKind.MOUSE, 8))
+    }
+
+    @Test
+    fun theRightClickFollowsItsSetting() {
+        val sample = defaults.copy(rightClick = MouseAction.EYEDROPPER)
+        assertEquals(PointerIntent.SAMPLE, at(PointerKind.MOUSE, PointerIntents.BUTTON_SECONDARY, sample))
+        val off = defaults.copy(rightClick = MouseAction.NONE)
+        assertEquals(PointerIntent.NOTHING, at(PointerKind.MOUSE, PointerIntents.BUTTON_SECONDARY, off))
+    }
+
+    @Test
+    fun clicksAreCountedOncePerPress() {
+        val clicks = StylusClicks()
+        val primary = PointerIntents.BUTTON_STYLUS_PRIMARY
+        assertEquals(emptySet<StylusButton>(), clicks.observe(0))
+        assertEquals(setOf(StylusButton.PRIMARY), clicks.observe(primary))
+        assertEquals("Still held", emptySet<StylusButton>(), clicks.observe(primary))
+        assertEquals(emptySet<StylusButton>(), clicks.observe(0))
+        assertEquals("A second press", setOf(StylusButton.PRIMARY), clicks.observe(primary))
+        assertEquals(setOf(StylusButton.SECONDARY), clicks.observe(primary or PointerIntents.BUTTON_STYLUS_SECONDARY))
+    }
+
+    @Test
+    fun forgettingWhatWasHeldLetsTheNextPressCount() {
+        val clicks = StylusClicks()
+        clicks.observe(PointerIntents.BUTTON_STYLUS_PRIMARY)
+        clicks.reset()
+        assertEquals(setOf(StylusButton.PRIMARY), clicks.observe(PointerIntents.BUTTON_STYLUS_PRIMARY))
+    }
+}
