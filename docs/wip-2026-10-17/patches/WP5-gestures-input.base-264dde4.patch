@@ -0,0 +1,113 @@
+package com.artflow.studio.core.canvas
+
+import com.artflow.studio.core.canvas.PointerGestureRouter.Action
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class TouchGesturesTest {
+    private val defaults = GestureSettings()
+
+    private fun result(
+        gesture: TouchGesture,
+        settings: GestureSettings = defaults,
+        touchActionsOff: Boolean = false,
+    ) = TouchGestures.result(gesture, settings, touchActionsOff)
+
+    @Test
+    fun aFinishedTouchIsATapOfItsFingerCountOrAQuickPinch() {
+        assertEquals(TouchGesture.TAP_TWO, TouchGestures.finished(2, quickPinch = false))
+        assertEquals(TouchGesture.TAP_THREE, TouchGestures.finished(3, quickPinch = false))
+        assertEquals(TouchGesture.TAP_FOUR, TouchGestures.finished(4, quickPinch = false))
+        assertEquals(TouchGesture.QUICK_PINCH, TouchGestures.finished(0, quickPinch = true))
+        assertEquals("A tap wins over a pinch", TouchGesture.TAP_TWO, TouchGestures.finished(2, quickPinch = true))
+        assertNull(TouchGestures.finished(0, quickPinch = false))
+        assertNull(TouchGestures.finished(1, quickPinch = false))
+    }
+
+    @Test
+    fun restingFingersAreAHoldOnlyForTwoAndThree() {
+        assertEquals(TouchGesture.HOLD_TWO, TouchGestures.held(2))
+        assertEquals(TouchGesture.HOLD_THREE, TouchGestures.held(3))
+        for (fingers in listOf(0, 1, 4)) assertNull(TouchGestures.held(fingers))
+    }
+
+    @Test
+    fun threeFingerRoutesNameTheirGesture() {
+        assertEquals(TouchGesture.SWIPE_THREE, TouchGestures.threeFinger(Action.THREE_FINGER_SWIPE_DOWN))
+        assertEquals(TouchGesture.SCRUB_THREE, TouchGestures.threeFinger(Action.THREE_FINGER_SCRUB))
+        assertNull(TouchGestures.threeFinger(Action.NAVIGATE))
+    }
+
+    @Test
+    fun theDefaultsDoWhatTheEditorAlwaysDid() {
+        assertEquals(GestureResult.UNDO, result(TouchGesture.TAP_TWO))
+        assertEquals(GestureResult.REDO, result(TouchGesture.TAP_THREE))
+        assertEquals(GestureResult.FULL_SCREEN, result(TouchGesture.TAP_FOUR))
+        assertEquals(GestureResult.RAPID_UNDO, result(TouchGesture.HOLD_TWO))
+        assertEquals(GestureResult.RAPID_REDO, result(TouchGesture.HOLD_THREE))
+        assertEquals(GestureResult.COPY_PASTE, result(TouchGesture.SWIPE_THREE))
+        assertEquals(GestureResult.CLEAR_LAYER, result(TouchGesture.SCRUB_THREE))
+        assertEquals(GestureResult.EYEDROPPER, result(TouchGesture.TOUCH_AND_HOLD))
+        assertEquals(GestureResult.QUICK_SHAPE, result(TouchGesture.PEN_HOLD))
+        assertEquals(GestureResult.FIT_TO_SCREEN, result(TouchGesture.QUICK_PINCH))
+        assertEquals(GestureResult.EYEDROPPER, result(TouchGesture.STYLUS_BUTTON))
+        assertEquals(GestureResult.ERASE, result(TouchGesture.ERASER_END))
+        assertNull("The second pen button is unassigned", result(TouchGesture.STYLUS_BUTTON_2))
+    }
+
+    @Test
+    fun everyGestureHasAnAnswerSoThePadCanNameWhatItDoes() {
+        // Nothing may throw for any gesture; the only nulls are the ones that are switched off or unassigned.
+        val silent = TouchGesture.entries.filter { result(it) == null }
+        assertEquals(listOf(TouchGesture.STYLUS_BUTTON_2), silent)
+    }
+
+    @Test
+    fun theSwitchesTurnTheirGesturesOff() {
+        val off = defaults.copy(scrubToClear = false, swipeCopyPaste = false, fourFingerFullScreen = false, quickShape = false)
+        assertNull(result(TouchGesture.SCRUB_THREE, off))
+        assertNull(result(TouchGesture.SWIPE_THREE, off))
+        assertNull(result(TouchGesture.TAP_FOUR, off))
+        assertNull(result(TouchGesture.PEN_HOLD, off))
+        assertEquals("Undo has no switch", GestureResult.UNDO, result(TouchGesture.TAP_TWO, off))
+    }
+
+    @Test
+    fun touchAndHoldDoesWhatItIsAssignedTo() {
+        val expected =
+            mapOf(
+                HoldAction.EYEDROPPER to GestureResult.EYEDROPPER,
+                HoldAction.QUICK_MENU to GestureResult.QUICK_MENU,
+                HoldAction.SELECT_LAYER to GestureResult.SELECT_LAYER,
+                HoldAction.NONE to null,
+            )
+        assertEquals(HoldAction.entries.toSet(), expected.keys)
+        for ((action, outcome) in expected) assertEquals(outcome, result(TouchGesture.TOUCH_AND_HOLD, defaults.copy(holdAction = action)))
+    }
+
+    @Test
+    fun disableTouchActionsSilencesFingerShortcutsButNotNavigationOrDrawing() {
+        for (gesture in TouchGesture.entries) {
+            val outcome = result(gesture, touchActionsOff = true)
+            if (gesture.isShortcut) assertNull("$gesture is a finger shortcut", outcome) else assertEquals(result(gesture), outcome)
+        }
+        assertTrue(TouchGesture.TAP_TWO.isShortcut && TouchGesture.TOUCH_AND_HOLD.isShortcut)
+        assertTrue(!TouchGesture.PINCH.isShortcut && !TouchGesture.DRAW_FINGER.isShortcut && !TouchGesture.QUICK_PINCH.isShortcut)
+    }
+
+    @Test
+    fun stylusAndMouseAssignmentsAreShownAsTheirResults() {
+        val settings =
+            defaults.copy(
+                stylus = StylusMapping(StylusAction.UNDO, StylusAction.PAN, StylusAction.NONE),
+                rightClick = MouseAction.EYEDROPPER,
+            )
+        assertEquals(GestureResult.UNDO, result(TouchGesture.STYLUS_BUTTON, settings))
+        assertEquals(GestureResult.PAN_VIEW, result(TouchGesture.STYLUS_BUTTON_2, settings))
+        assertNull(result(TouchGesture.ERASER_END, settings))
+        assertEquals(GestureResult.EYEDROPPER, result(TouchGesture.RIGHT_CLICK, settings))
+        assertEquals(GestureResult.PAN_VIEW, result(TouchGesture.MIDDLE_CLICK, settings))
+    }
+}
