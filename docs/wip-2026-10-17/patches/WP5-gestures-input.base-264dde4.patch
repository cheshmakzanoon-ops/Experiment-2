+++ b/app/src/main/java/com/artflow/studio/core/canvas/GestureSettings.kt
@@ -0,0 +1,118 @@
+package com.artflow.studio.core.canvas
+
+/** What a finger that stays still on the canvas does (Procreate assigns its touch-and-hold to one feature at a time). */
+enum class HoldAction {
+    EYEDROPPER,
+    QUICK_MENU,
+    SELECT_LAYER,
+    NONE,
+}
+
+/** What a stylus button, or the eraser end of the stylus, does. */
+enum class StylusAction {
+    /** A button does nothing and the pen paints as usual; for the eraser end this means it paints like the pen tip. */
+    NONE,
+
+    /** Hold the button and touch or drag to sample colour. */
+    EYEDROPPER,
+
+    /** Hold the button, or turn the pen over, and what it touches is erased. */
+    ERASE,
+
+    /** A click of the button switches between the eraser and the paint tool. */
+    TOGGLE_ERASER,
+
+    /** A click of the button undoes. */
+    UNDO,
+
+    /** A click of the button opens the QuickMenu. */
+    QUICK_MENU,
+
+    /** Hold the button and drag to move the canvas. */
+    PAN,
+}
+
+/** The three stylus inputs that can be given an action. */
+data class StylusMapping(
+    val primary: StylusAction = StylusAction.EYEDROPPER,
+    val secondary: StylusAction = StylusAction.NONE,
+    val eraserEnd: StylusAction = StylusAction.ERASE,
+)
+
+/** What the secondary (right) button of a mouse or trackpad does. */
+enum class MouseAction {
+    QUICK_MENU,
+    EYEDROPPER,
+    NONE,
+}
+
+/** Everything that can open the QuickMenu. */
+enum class QuickMenuTrigger {
+    HANDLE,
+    TOUCH_AND_HOLD,
+    STYLUS_BUTTON,
+    STYLUS_BUTTON_2,
+    ERASER_END,
+    RIGHT_CLICK,
+}
+
+/**
+ * Prefs > Gesture controls, as one value the sheet edits and the settings store keeps. The defaults are what the
+ * editor did before these options existed, except where a field's comment says otherwise.
+ */
+data class GestureSettings(
+    /** Rubbing three fingers side to side clears the layer. */
+    val scrubToClear: Boolean = true,
+    /** Dragging three fingers down opens Copy & Paste. */
+    val swipeCopyPaste: Boolean = true,
+    /** Tapping four fingers hides or shows the interface. */
+    val fourFingerFullScreen: Boolean = true,
+    /** While a stylus is in use, finger taps, holds and swipes do nothing; fingers still pinch, rotate and pan. */
+    val disableTouchActions: Boolean = false,
+    val holdAction: HoldAction = HoldAction.EYEDROPPER,
+    val holdDelayMs: Int = DEFAULT_HOLD_DELAY_MS,
+    /** Holding the pen still at the end of a stroke snaps it to a line, ellipse or polygon. */
+    val quickShape: Boolean = true,
+    val quickShapeDelayMs: Int = DEFAULT_QUICK_SHAPE_DELAY_MS,
+    /** Touching a second finger while the pen holds a snapped shape makes it exact: 15 degree lines, circles, squares. */
+    val quickShapeConstrain: Boolean = true,
+    /** How long two or three still fingers must rest before undo or redo starts repeating. */
+    val rapidUndoDelayMs: Int = DEFAULT_RAPID_UNDO_DELAY_MS,
+    /** Two-finger rotation clicks into place at multiples of 45 degrees. New: it was free rotation before. */
+    val rotationSnap: Boolean = true,
+    val stylus: StylusMapping = StylusMapping(),
+    /** New: a right-click used to paint like the left button. */
+    val rightClick: MouseAction = MouseAction.QUICK_MENU,
+    /** New: once a stylus has been seen, a palm-sized touch is ignored. */
+    val palmSizeRejection: Boolean = true,
+) {
+    /** The same settings with every delay inside its allowed range, as stored values may be anything. */
+    fun normalized(): GestureSettings =
+        copy(
+            holdDelayMs = holdDelayMs.coerceIn(MIN_DELAY_MS, MAX_DELAY_MS),
+            quickShapeDelayMs = quickShapeDelayMs.coerceIn(MIN_DELAY_MS, MAX_DELAY_MS),
+            rapidUndoDelayMs = rapidUndoDelayMs.coerceIn(MIN_DELAY_MS, MAX_DELAY_MS),
+        )
+
+    /** Every way the QuickMenu currently opens; the handle beside the sliders always does. */
+    fun quickMenuTriggers(): List<QuickMenuTrigger> =
+        buildList {
+            add(QuickMenuTrigger.HANDLE)
+            if (holdAction == HoldAction.QUICK_MENU) add(QuickMenuTrigger.TOUCH_AND_HOLD)
+            if (stylus.primary == StylusAction.QUICK_MENU) add(QuickMenuTrigger.STYLUS_BUTTON)
+            if (stylus.secondary == StylusAction.QUICK_MENU) add(QuickMenuTrigger.STYLUS_BUTTON_2)
+            if (stylus.eraserEnd == StylusAction.QUICK_MENU) add(QuickMenuTrigger.ERASER_END)
+            if (rightClick == MouseAction.QUICK_MENU) add(QuickMenuTrigger.RIGHT_CLICK)
+        }
+
+    companion object {
+        const val MIN_DELAY_MS = 200
+        const val MAX_DELAY_MS = 1500
+
+        /** The delay sliders move in steps of this many milliseconds. */
+        const val DELAY_STEP_MS = 50
+        const val DEFAULT_HOLD_DELAY_MS = 500
+        const val DEFAULT_QUICK_SHAPE_DELAY_MS = 650
+        const val DEFAULT_RAPID_UNDO_DELAY_MS = 650
+    }
+}
