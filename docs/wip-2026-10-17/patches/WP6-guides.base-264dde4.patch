@@ -0,0 +1,188 @@
+package com.artflow.studio.core.symmetry
+
+import com.artflow.studio.core.symmetry.SymmetryEngine.SymmetryType
+import com.artflow.studio.domain.model.brush.BrushParams
+import com.artflow.studio.domain.model.brush.Stroke
+import com.artflow.studio.domain.model.brush.StrokePoint
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertSame
+import org.junit.Test
+import kotlin.math.hypot
+
+/**
+ * Whole strokes through the symmetry engine.
+ *
+ * [SymmetryEngine.mirrorStroke] is what the repository previews and commits, so every copy of a
+ * stroke has to be the image of the stroke under the same reflection or rotation that
+ * [SymmetryEngine.instances] applies to a single point, about the axes the guide actually shows.
+ */
+class SymmetryStrokeTest {
+    private val width = 200
+    private val height = 100
+
+    private val sample =
+        stroke(40f to 20f, 50f to 25f, 65f to 40f, 90f to 30f)
+
+    private fun stroke(vararg points: Pair<Float, Float>): Stroke =
+        Stroke(
+            id = 10L,
+            points =
+                points.mapIndexed { index, (x, y) ->
+                    StrokePoint(x = x, y = y, pressure = 0.25f + index * 0.1f, timestamp = index * 10L)
+                },
+            brushParams = BrushParams(),
+            layerId = 1L,
+            color = 0xFF112233.toInt(),
+            timestamp = 0L,
+        )
+
+    private fun assertPoint(
+        expectedX: Float,
+        expectedY: Float,
+        actual: StrokePoint,
+    ) {
+        assertEquals(expectedX, actual.x, 0.01f)
+        assertEquals(expectedY, actual.y, 0.01f)
+    }
+
+    @Test
+    fun `a vertical mirror reflects every point, not just the first`() {
+        val copies = SymmetryEngine.mirrorStroke(sample, width, height, SymmetryEngine.Settings(type = SymmetryType.VERTICAL))
+
+        assertEquals(2, copies.size)
+        assertSame(sample, copies[0])
+        // The axis is x = 100, so x becomes 200 - x and y stays.
+        sample.points.zip(copies[1].points).forEach { (original, mirrored) ->
+            assertPoint(200f - original.x, original.y, mirrored)
+        }
+    }
+
+    @Test
+    fun `a horizontal mirror reflects every point across the horizontal axis`() {
+        val copies = SymmetryEngine.mirrorStroke(sample, width, height, SymmetryEngine.Settings(type = SymmetryType.HORIZONTAL))
+
+        assertEquals(2, copies.size)
+        sample.points.zip(copies[1].points).forEach { (original, mirrored) ->
+            assertPoint(original.x, 100f - original.y, mirrored)
+        }
+    }
+
+    @Test
+    fun `a mirror about a moved axis reflects about that axis`() {
+        val settings = SymmetryEngine.Settings(type = SymmetryType.VERTICAL, centreX = 0.25f)
+
+        val copies = SymmetryEngine.mirrorStroke(sample, width, height, settings)
+
+        // The axis is x = 50.
+        sample.points.zip(copies[1].points).forEach { (original, mirrored) ->
+            assertPoint(100f - original.x, original.y, mirrored)
+        }
+    }
+
+    @Test
+    fun `quadrant symmetry draws all four reflections of the stroke`() {
+        val copies = SymmetryEngine.mirrorStroke(sample, width, height, SymmetryEngine.Settings(type = SymmetryType.QUADRANT))
+
+        assertEquals(4, copies.size)
+        val expected = listOf(0, 1, 2, 3).map { index -> copies[index].points.map { it.x to it.y } }
+        val original = sample.points
+        assertEquals(original.map { it.x to it.y }, expected[0])
+        val reflections =
+            setOf(
+                original.map { (200f - it.x) to it.y },
+                original.map { it.x to (100f - it.y) },
+                original.map { (200f - it.x) to (100f - it.y) },
+            )
+        assertEquals(reflections, expected.drop(1).toSet())
+    }
+
+    @Test
+    fun `radial symmetry turns the stroke about the axis centre`() {
+        val settings =
+            SymmetryEngine.Settings(
+                type = SymmetryType.RADIAL,
+                radialCount = 4,
+                centreX = 0.25f,
+                centreY = 0.75f,
+            )
+
+        val copies = SymmetryEngine.mirrorStroke(sample, width, height, settings)
+
+        assertEquals(4, copies.size)
+        // The axis centre is (50, 75); copy n is the stroke turned n quarter turns about it.
+        copies.forEachIndexed { turns, copy ->
+            sample.points.zip(copy.points).forEach { (original, turned) ->
+                val dx = original.x - 50f
+                val dy = original.y - 75f
+                val (turnedX, turnedY) =
+                    when (turns) {
+                        0 -> dx to dy
+                        1 -> -dy to dx
+                        2 -> -dx to -dy
+                        else -> dy to -dx
+                    }
+                assertPoint(50f + turnedX, 75f + turnedY, turned)
+            }
+        }
+    }
+
+    @Test
+    fun `every copy of a stroke is the image of its points under instances`() {
+        val settings =
+            listOf(
+                SymmetryEngine.Settings(type = SymmetryType.VERTICAL),
+                SymmetryEngine.Settings(type = SymmetryType.HORIZONTAL, centreY = 0.3f),
+                SymmetryEngine.Settings(type = SymmetryType.VERTICAL, secondaryAxis = true, centreX = 0.6f, centreY = 0.4f),
+                SymmetryEngine.Settings(type = SymmetryType.QUADRANT, centreX = 0.35f, centreY = 0.65f),
+                SymmetryEngine.Settings(type = SymmetryType.RADIAL, radialCount = 5),
+                SymmetryEngine.Settings(type = SymmetryType.RADIAL, radialCount = 7, centreX = 0.7f, centreY = 0.2f),
+            )
+        settings.forEach { setting ->
+            val copies = SymmetryEngine.mirrorStroke(sample, width, height, setting)
+            assertEquals(setting.type.name, setting.instanceCount(), copies.size)
+            sample.points.forEachIndexed { index, point ->
+                val expected = SymmetryEngine.instances(point.x, point.y, width, height, setting)
+                copies.forEachIndexed { copy, drawn ->
+                    assertPoint(expected[copy].x, expected[copy].y, drawn.points[index])
+                }
+            }
+        }
+    }
+
+    @Test
+    fun `copies keep the pressure and timing of the stroke and its segment lengths`() {
+        val copies = SymmetryEngine.mirrorStroke(sample, width, height, SymmetryEngine.Settings(type = SymmetryType.QUADRANT))
+
+        copies.forEach { copy ->
+            assertEquals(sample.points.map { it.pressure }, copy.points.map { it.pressure })
+            assertEquals(sample.points.map { it.timestamp }, copy.points.map { it.timestamp })
+            sample.points.zipWithNext().zip(copy.points.zipWithNext()).forEach { (before, after) ->
+                val original = hypot(before.second.x - before.first.x, before.second.y - before.first.y)
+                val copied = hypot(after.second.x - after.first.x, after.second.y - after.first.y)
+                assertEquals(original, copied, 0.01f)
+            }
+        }
+    }
+
+    @Test
+    fun `radial guide lines start at the axis centre and reach the farthest corner`() {
+        val settings =
+            SymmetryEngine.Settings(
+                type = SymmetryType.RADIAL,
+                radialCount = 6,
+                centreX = 0.25f,
+                centreY = 0.75f,
+            )
+
+        val lines = SymmetryEngine.guideLines(width, height, settings)
+
+        assertEquals(6, lines.size)
+        // From (50, 75) the farthest corner is (200, 0).
+        val reach = hypot(150f, 75f)
+        lines.forEach { line ->
+            assertEquals(50f, line.startX, 0.01f)
+            assertEquals(75f, line.startY, 0.01f)
+            assertEquals(reach, hypot(line.endX - line.startX, line.endY - line.startY), 0.01f)
+        }
+    }
+}
