+++ b/app/src/main/java/com/artflow/studio/core/render/GrainField.kt
@@ -0,0 +1,131 @@
+package com.artflow.studio.core.render
+
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.sqrt
+
+/**
+ * A square float map that procedural grains are built in. Drawing wraps around its edges, so
+ * marks crossing an edge continue on the opposite side and the finished tile repeats without a seam.
+ */
+internal class GrainField(
+    val size: Int,
+) {
+    val values = FloatArray(size * size)
+
+    init {
+        require(size > 0 && size and (size - 1) == 0) { "A wrapping field is a power of two" }
+    }
+
+    /** Sets every texel from [value] at its centre (x, y in texels). */
+    inline fun fill(value: (x: Float, y: Float) -> Float) {
+        for (y in 0 until size) {
+            val row = y * size
+            for (x in 0 until size) values[row + x] = value(x + 0.5f, y + 0.5f)
+        }
+    }
+
+    /** Replaces every texel with [transform] of itself. */
+    inline fun map(transform: (Float) -> Float) {
+        for (i in values.indices) values[i] = transform(values[i])
+    }
+
+    /** Index of texel ([x], [y]), wrapped onto the tile. */
+    fun index(
+        x: Int,
+        y: Int,
+    ): Int = (y and size - 1) * size + (x and size - 1)
+
+    /**
+     * Paints an anti-aliased segment whose width runs from [startWidth] to [endWidth], keeping the
+     * stronger of [strength] and what each texel already holds.
+     */
+    fun segment(
+        x0: Float,
+        y0: Float,
+        x1: Float,
+        y1: Float,
+        startWidth: Float,
+        endWidth: Float,
+        strength: Float,
+    ) {
+        val reach = max(startWidth, endWidth) / 2f + 1f
+        val left = TileNoise.floorToInt(min(x0, x1) - reach)
+        val right = TileNoise.floorToInt(max(x0, x1) + reach)
+        val top = TileNoise.floorToInt(min(y0, y1) - reach)
+        val bottom = TileNoise.floorToInt(max(y0, y1) + reach)
+        val dx = x1 - x0
+        val dy = y1 - y0
+        val lengthSquared = max(dx * dx + dy * dy, 1e-6f)
+        for (y in top..bottom) {
+            for (x in left..right) {
+                val px = x + 0.5f - x0
+                val py = y + 0.5f - y0
+                val t = ((px * dx + py * dy) / lengthSquared).coerceIn(0f, 1f)
+                val ex = px - dx * t
+                val ey = py - dy * t
+                val half = (startWidth + (endWidth - startWidth) * t) / 2f
+                val coverage = (half - sqrt(ex * ex + ey * ey) + 0.5f).coerceIn(0f, 1f) * min(1f, half * 2f)
+                if (coverage > 0f) put(index(x, y), coverage * strength)
+            }
+        }
+    }
+
+    /** Paints an anti-aliased disc, like [segment]. */
+    fun disc(
+        cx: Float,
+        cy: Float,
+        radius: Float,
+        strength: Float,
+    ) = segment(cx, cy, cx, cy, radius * 2f, radius * 2f, strength)
+
+    private fun put(
+        index: Int,
+        amount: Float,
+    ) {
+        values[index] = max(values[index], amount)
+    }
+
+    /**
+     * Stretches the values so that [lowShare] of the texels end at or below 0 and [highShare] at
+     * or below 1, clamping the rest: every recipe then spans the full range whatever its sums.
+     */
+    fun normalize(
+        lowShare: Float = 0.005f,
+        highShare: Float = 0.995f,
+    ) {
+        val low = percentile(lowShare)
+        val high = percentile(highShare)
+        val range = (high - low).takeIf { it > 1e-6f } ?: 1f
+        map { ((it - low) / range).coerceIn(0f, 1f) }
+    }
+
+    /** The value below which [share] of the texels lie (a 4096-bin histogram estimate). */
+    private fun percentile(share: Float): Float {
+        var low = Float.MAX_VALUE
+        var high = -Float.MAX_VALUE
+        for (value in values) {
+            low = min(low, value)
+            high = max(high, value)
+        }
+        if (high <= low) return low
+        val bins = IntArray(HISTOGRAM_BINS)
+        val scale = (HISTOGRAM_BINS - 1) / (high - low)
+        for (value in values) bins[((value - low) * scale).toInt()]++
+        val wanted = share * values.size
+        var seen = 0
+        for (bin in bins.indices) {
+            seen += bins[bin]
+            if (seen >= wanted) return low + bin / scale
+        }
+        return high
+    }
+
+    /** Quantizes to an 8-bit tile; values are clamped to 0..1. */
+    fun toTile(): CustomGrains.Tile =
+        CustomGrains.Tile(size, ByteArray(values.size) { (values[it].coerceIn(0f, 1f) * 255f + 0.5f).toInt().toByte() })
+
+    private companion object {
+        const val HISTOGRAM_BINS = 4096
+    }
+}
