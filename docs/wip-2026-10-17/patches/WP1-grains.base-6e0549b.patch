+package com.artflow.studio.core.render
+
+import kotlin.math.sqrt
+
+/**
+ * Seamlessly tiling noise for the procedural grains and brush tips. Coordinates are in lattice
+ * cells and every function repeats after its period, so a map that spans whole periods wraps
+ * without a seam. Only integer hashing, IEEE float arithmetic, square roots and StrictMath enter,
+ * so the same call returns the same bits on every device and thread.
+ */
+internal object TileNoise {
+    private const val DIRECTIONS = 16
+    private const val SQRT2 = 1.4142135f
+    private const val INV_24_BITS = 1f / 16_777_216f
+    private const val JITTER_MIN = 0.08f
+    private const val JITTER_SPAN = 0.84f
+    private val GX = FloatArray(DIRECTIONS) { StrictMath.cos(it * 2.0 * Math.PI / DIRECTIONS).toFloat() }
+    private val GY = FloatArray(DIRECTIONS) { StrictMath.sin(it * 2.0 * Math.PI / DIRECTIONS).toFloat() }
+
+    /** A well-mixed 32-bit hash of a lattice point (Wellons' lowbias32 over a spread of the coordinates). */
+    fun hash(
+        x: Int,
+        y: Int,
+        seed: Int,
+    ): Int = mix(x * -0x61c88647 + y * 0x27d4eb2f + mix(seed))
+
+    /** Uniform in 0 until 1. */
+    fun unit(
+        x: Int,
+        y: Int,
+        seed: Int,
+    ): Float = unit(hash(x, y, seed))
+
+    fun unit(hash: Int): Float = (hash ushr 8) * INV_24_BITS
+
+    /** A second independent value from the same hash. */
+    fun next(hash: Int): Int = mix(hash xor 0x5bd1e995)
+
+    private fun mix(value: Int): Int {
+        var h = value
+        h = (h xor (h ushr 16)) * 0x7feb352d
+        h = (h xor (h ushr 15)) * 0x846ca68bL.toInt()
+        return h xor (h ushr 16)
+    }
+
+    /** Integer floor without the double round trip of kotlin.math.floor. */
+    fun floorToInt(value: Float): Int {
+        val truncated = value.toInt()
+        return if (value < truncated) truncated - 1 else truncated
+    }
+
+    private fun fade(t: Float): Float = t * t * t * (t * (t * 6f - 15f) + 10f)
+
+    /** [value] wrapped into 0 until [period]; most lattice points already are, which skips the division. */
+    private fun wrap(
+        value: Int,
+        period: Int,
+    ): Int = if (value in 0 until period) value else Math.floorMod(value, period)
+
+    private fun corner(
+        hash: Int,
+        dx: Float,
+        dy: Float,
+    ): Float {
+        val direction = hash and (DIRECTIONS - 1)
+        return GX[direction] * dx + GY[direction] * dy
+    }
+
+    /** Gradient (Perlin) noise in about -1..1, repeating every [periodX] × [periodY] cells. */
+    fun gradient(
+        x: Float,
+        y: Float,
+        periodX: Int,
+        periodY: Int,
+        seed: Int,
+    ): Float {
+        val ix = floorToInt(x)
+        val iy = floorToInt(y)
+        val fx = x - ix
+        val fy = y - iy
+        val x0 = wrap(ix, periodX)
+        val y0 = wrap(iy, periodY)
+        val x1 = if (x0 + 1 == periodX) 0 else x0 + 1
+        val y1 = if (y0 + 1 == periodY) 0 else y0 + 1
+        val a = corner(hash(x0, y0, seed), fx, fy)
+        val b = corner(hash(x1, y0, seed), fx - 1f, fy)
+        val c = corner(hash(x0, y1, seed), fx, fy - 1f)
+        val d = corner(hash(x1, y1, seed), fx - 1f, fy - 1f)
+        val u = fade(fx)
+        val top = a + (b - a) * u
+        val bottom = c + (d - c) * u
+        return (top + (bottom - top) * fade(fy)) * SQRT2
+    }
+
+    /**
+     * Fractal sum of [octaves] gradient octaves in about -1..1; each octave doubles both periods
+     * (so it still tiles) and keeps [gain] of the previous amplitude.
+     */
+    fun fbm(
+        x: Float,
+        y: Float,
+        periodX: Int,
+        periodY: Int,
+        octaves: Int,
+        gain: Float,
+        seed: Int,
+    ): Float {
+        var sum = 0f
+        var amplitude = 1f
+        var total = 0f
+        var scale = 1
+        for (octave in 0 until octaves) {
+            sum += amplitude * gradient(x * scale, y * scale, periodX * scale, periodY * scale, seed + octave * 101)
+            total += amplitude
+            amplitude *= gain
+            scale *= 2
+        }
+        return sum / total
+    }
+
+    /**
+     * Worley (cellular) noise over a [cells] × [cells] lattice of jittered feature points:
+     * writes the nearest distance, the second nearest and a 0..1 identity of the nearest cell
+     * into [out], all in cell units.
+     */
+    fun cellular(
+        x: Float,
+        y: Float,
+        cells: Int,
+        seed: Int,
+        out: FloatArray,
+    ) {
+        val cx = floorToInt(x)
+        val cy = floorToInt(y)
+        out[0] = Float.MAX_VALUE
+        out[1] = Float.MAX_VALUE
+        var identity = 0
+        for (row in cy - 1..cy + 1) {
+            val wrappedRow = wrap(row, cells)
+            for (column in cx - 1..cx + 1) {
+                val h = hash(wrap(column, cells), wrappedRow, seed)
+                val dx = column + JITTER_MIN + JITTER_SPAN * unit(h) - x
+                val dy = row + JITTER_MIN + JITTER_SPAN * unit(next(h)) - y
+                if (nearer(dx * dx + dy * dy, out)) identity = h
+            }
+        }
+        out[0] = sqrt(out[0])
+        out[1] = sqrt(out[1])
+        out[2] = unit(next(next(identity)))
+    }
+
+    /** Keeps the two smallest squared distances in [out]; true when [distance] is the new nearest. */
+    private fun nearer(
+        distance: Float,
+        out: FloatArray,
+    ): Boolean {
+        if (distance < out[0]) {
+            out[1] = out[0]
+            out[0] = distance
+            return true
+        }
+        if (distance < out[1]) out[1] = distance
+        return false
+    }
+
+    /** Hermite smoothstep of [x] between [edge0] and [edge1]. */
+    fun smoothstep(
+        edge0: Float,
+        edge1: Float,
+        x: Float,
+    ): Float {
+        val t = ((x - edge0) / (edge1 - edge0)).coerceIn(0f, 1f)
+        return t * t * (3f - 2f * t)
+    }
+}
