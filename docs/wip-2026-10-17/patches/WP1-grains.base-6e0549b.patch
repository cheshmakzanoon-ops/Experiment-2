+    @Test fun importedGrainIsSampledSmoothlyWhenScaledUp() {
+        // A smooth periodic ramp: 0 up to 255 and back across 30 texels.
+        val size = 30
+        val values = ByteArray(size * size) { ((if (it % size <= 15) it % size else 30 - it % size) * 17).toByte() }
+        val tile = CustomGrains.Tile(size, values)
+        var previous = tile.wrapped(0f, 0.5f)
+        var u = 0f
+        while (u < 3f * size) {
+            u += 1f / 64f
+            val sample = tile.wrapped(u, 0.5f)
+            assertTrue("step at $u", abs(sample - previous) <= 1f / 255f)
+            previous = sample
+        }
+        // Through a brush at 4x: neighbouring pixels differ by a quarter of a texel step at most.
+        val id = CustomGrains.idFor(tile)
+        CustomGrains.register(id, tile)
+        val texture = BrushTexture.from(BrushParams(textureId = id, blendTexture = true, textureScale = 4f))!!
+        for (x in 0 until 200) assertTrue(abs(texture.coverage(x, 3) - texture.coverage(x + 1, 3)) <= 17f / 255f / 4f + 1e-4f)
+    }
