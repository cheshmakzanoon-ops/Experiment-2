+package com.artflow.studio.core.render
+
+import com.artflow.studio.core.render.TileNoise.cellular
+import com.artflow.studio.core.render.TileNoise.fbm
+import com.artflow.studio.core.render.TileNoise.gradient
+import com.artflow.studio.core.render.TileNoise.smoothstep
+import kotlin.math.abs
+import kotlin.math.max
+import kotlin.math.round
+import kotlin.math.sqrt
+
+/**
+ * The procedural grains behind [BrushTexture.Kind]: seamlessly tiling 512 × 512 maps built from
+ * tileable gradient and cellular noise, threads and dots, each generated once on first use and
+ * shared by every brush. Values are paint coverage: 1 takes paint fully, 0 holds it back.
+ *
+ * Natural media come from thresholded fractal noise with soft shoulders (paper, charcoal, pastel)
+ * rather than from lattice cells, so no grid or block shows at any scale.
+ */
+internal object GrainSynth {
+    const val SIZE = 512
+    private const val K = 1f / SIZE
+
+    private val tiles = BrushTexture.Kind.entries.map { kind -> lazy { generate(kind).toTile() } }
+
+    fun tile(kind: BrushTexture.Kind): CustomGrains.Tile = tiles[kind.ordinal].value
+
+    /** The finished map before quantization, for tests and tuning. */
+    fun generate(kind: BrushTexture.Kind): GrainField =
+        when (kind) {
+            BrushTexture.Kind.PAPER -> paper()
+            BrushTexture.Kind.CANVAS -> weave(CANVAS)
+            BrushTexture.Kind.CHARCOAL -> charcoal()
+            BrushTexture.Kind.FINE -> fine()
+            BrushTexture.Kind.BLOTCH -> blotch()
+            BrushTexture.Kind.BRISTLE -> bristle()
+            BrushTexture.Kind.HALFTONE -> halftone()
+            BrushTexture.Kind.HATCH -> hatch()
+            BrushTexture.Kind.SPECKLE -> speckle()
+            BrushTexture.Kind.PENCIL -> pencil()
+            BrushTexture.Kind.PASTEL -> pastel()
+            BrushTexture.Kind.SANDPAPER -> sandpaper()
+            BrushTexture.Kind.CONCRETE -> concrete()
+            BrushTexture.Kind.LINEN -> weave(LINEN)
+            BrushTexture.Kind.BURLAP -> burlap()
+            BrushTexture.Kind.CRACKLE -> crackle()
+            BrushTexture.Kind.WOOD -> wood()
+        }
+
+    /** Gradient noise with [period] cells across the tile, at texel (x, y). */
+    private fun noise(
+        x: Float,
+        y: Float,
+        period: Int,
+        seed: Int,
+    ): Float = gradient(x * K * period, y * K * period, period, period, seed)
+
+    /** Fractal noise whose coarsest octave has [period] cells across the tile, at texel (x, y). */
+    private fun fractal(
+        x: Float,
+        y: Float,
+        period: Int,
+        octaves: Int,
+        gain: Float,
+        seed: Int,
+    ): Float = fbm(x * K * period, y * K * period, period, period, octaves, gain, seed)
+
+    /** Cold-press paper: an irregular tooth of soft bumps, a broad mottle and a fine surface grain. */
+    private fun paper(): GrainField =
+        GrainField(SIZE).apply {
+            fill { x, y -> 0.6f * fractal(x, y, 48, 3, 0.55f, 1) + 0.25f * fractal(x, y, 6, 3, 0.5f, 2) + 0.15f * noise(x, y, 170, 3) }
+            normalize()
+            map { 0.25f + 0.75f * smoothstep(0.2f, 0.8f, it) }
+        }
+
+    /** Drawing paper: a finer, flatter tooth than [paper] with faint horizontal fibres. */
+    private fun pencil(): GrainField =
+        GrainField(SIZE).apply {
+            fill { x, y ->
+                val tooth = fbm(x * K * 110, y * K * 110, 110, 110, 2, 0.45f, 21)
+                val fibres = gradient(x * K * 32, y * K * 200, 32, 200, 22)
+                0.6f * tooth + 0.2f * fibres + 0.2f * fractal(x, y, 8, 3, 0.5f, 23)
+            }
+            normalize()
+            map { 0.3f + 0.7f * smoothstep(0.2f, 0.8f, it) }
+        }
+
+    /** Charcoal paper: a coarse, slightly horizontal tooth that the stick only catches on its peaks. */
+    private fun charcoal(): GrainField =
+        GrainField(SIZE).apply {
+            fill { x, y ->
+                val ridges = fbm(x * K * 48, y * K * 96, 48, 96, 4, 0.6f, 31)
+                0.8f * ridges + 0.2f * noise(x, y, 220, 32) + 0.25f * fractal(x, y, 6, 2, 0.5f, 33)
+            }
+            normalize()
+            map { smoothstep(0.38f, 0.62f, it) }
+        }
+
+    /** Fine, even grain with little contrast, for smooth papers and gentle texture. */
+    private fun fine(): GrainField =
+        GrainField(SIZE).apply {
+            fill { x, y -> 0.6f * fbm(x * K * 170, y * K * 170, 170, 170, 2, 0.5f, 41) + 0.4f * fractal(x, y, 40, 2, 0.5f, 42) }
+            normalize()
+            map { 0.55f + 0.45f * it }
+        }
+
+    /** Watercolour: soft blooms of pigment, with darker granules settling into the paper. */
+    private fun blotch(): GrainField =
+        GrainField(SIZE).apply {
+            fill { x, y ->
+                val wx = fractal(x, y, 4, 2, 0.5f, 61) * 0.25f
+                val wy = fractal(x, y, 4, 2, 0.5f, 62) * 0.25f
+                val clouds = smoothstep(-0.6f, 0.6f, fbm(x * K * 4 + wx, y * K * 4 + wy, 4, 4, 4, 0.45f, 63))
+                val granules = smoothstep(0.2f, 0.9f, fbm(x * K * 170, y * K * 170, 170, 170, 2, 0.5f, 64))
+                0.62f + 0.38f * clouds + 0.14f * granules * (1.1f - clouds)
+            }
+            normalize(0.002f, 0.998f)
+            map { 0.3f + 0.7f * it }
+        }
+
+    /** Bristle streaks: long, uneven lines along u that thin out and break. */
+    private fun bristle(): GrainField =
+        GrainField(SIZE).apply {
+            fill { x, y -> 0.7f * fbm(x * K * 3, y * K * 220, 3, 220, 3, 0.6f, 81) + 0.3f * gradient(x * K * 8, y * K * 40, 8, 40, 82) }
+            normalize()
+            map { 0.12f + 0.88f * smoothstep(0.3f, 0.75f, it) }
+        }
+
+    /** A printed dot screen: anti-aliased dots on an eight-texel square grid. */
+    private fun halftone(): GrainField =
+        GrainField(SIZE).apply {
+            fill { x, y ->
+                val dx = x % HALFTONE_CELL - HALFTONE_CELL / 2f
+                val dy = y % HALFTONE_CELL - HALFTONE_CELL / 2f
+                0.08f + 0.92f * (HALFTONE_RADIUS - sqrt(dx * dx + dy * dy) + 0.5f).coerceIn(0f, 1f)
+            }
+        }
+
+    /**
+     * Engraved hatching: diagonal lines every eight texels along x + y, finer crossing lines every
+     * sixteen along x − y, both anti-aliased, with a slight hand-drawn wobble in weight and place.
+     */
+    private fun hatch(): GrainField =
+        GrainField(SIZE).apply {
+            fill { x, y ->
+                val wobble = noise(x, y, 16, 91) * 0.6f
+                val main = line(x + y + wobble, 8f, 2.1f + 0.5f * noise(x, y, 12, 92))
+                val cross = line(x - y + wobble, 16f, 1.2f + 0.4f * noise(x, y, 10, 93))
+                0.15f + 0.85f * max(main, 0.85f * cross)
+            }
+        }
+
+    /** Anti-aliased coverage of lines every [period] along [along] (measured on a diagonal), [width] texels wide. */
+    private fun line(
+        along: Float,
+        period: Float,
+        width: Float,
+    ): Float {
+        val phase = along / period
+        val offset = abs(phase - round(phase)) * period / SQRT2
+        return (width / 2f - offset + 0.5f).coerceIn(0f, 1f)
+    }
+
+    /** A spray of dots of many sizes, thinning and thickening in soft patches. */
+    private fun speckle(): GrainField =
+        GrainField(SIZE).apply {
+            repeat(SPECKLE_DOTS) { index ->
+                val h = TileNoise.hash(index, 1, 101)
+                val x = TileNoise.unit(h) * size
+                val y = TileNoise.unit(TileNoise.next(h)) * size
+                val pick = TileNoise.next(TileNoise.next(h))
+                if (TileNoise.unit(pick) < 0.6f + 0.4f * noise(x, y, 6, 102)) {
+                    val radius = 0.55f + 1.7f * cube(TileNoise.unit(TileNoise.next(pick)))
+                    disc(x, y, radius, 0.7f + 0.3f * TileNoise.unit(TileNoise.next(TileNoise.next(pick))))
+                }
+            }
+            map { 0.05f + 0.95f * it.coerceIn(0f, 1f) }
+        }
+
+    private fun cube(value: Float): Float = value * value * value
+
+    /** Pastel on toned paper: dense colour broken by small white pits where the paper's tooth stays bare. */
+    private fun pastel(): GrainField =
+        GrainField(SIZE).apply {
+            fill { x, y -> fractal(x, y, 40, 3, 0.5f, 111) + 0.35f * noise(x, y, 130, 112) + 0.25f * fractal(x, y, 5, 2, 0.5f, 113) }
+            normalize()
+            map { 0.06f + 0.94f * smoothstep(0.22f, 0.42f, it) }
+        }
+
+    /** Sandpaper: dense, sharp grit of mixed sizes. */
+    private fun sandpaper(): GrainField {
+        val cell = FloatArray(3)
+        return GrainField(SIZE).apply {
+            fill { x, y ->
+                cellular(x * K * 140, y * K * 140, 140, 121, cell)
+                val grit = 1f - smoothstep(0.05f, 0.5f, cell[0])
+                0.45f * noise(x, y, 220, 122) + 0.25f * noise(x, y, 110, 123) + 0.5f * grit * (0.4f + 0.6f * cell[2])
+            }
+            normalize()
+            map { 0.08f + 0.92f * smoothstep(0.45f, 0.62f, it) }
+        }
+    }
+
+    /** Concrete: a cold mottle with fine grit, pitted by air holes of many sizes. */
+    private fun concrete(): GrainField {
+        val cell = FloatArray(3)
+        return GrainField(SIZE).apply {
+            fill { x, y ->
+                val surface = 0.62f + 0.22f * fractal(x, y, 6, 5, 0.55f, 131) + 0.16f * noise(x, y, 220, 132)
+                cellular(x * K * 48 + noise(x, y, 64, 133) * 0.3f, y * K * 48 + noise(x, y, 64, 134) * 0.3f, 48, 135, cell)
+                val radius = max(0f, cell[2] - 0.55f) * 0.8f
+                val pit = if (radius <= 0f) 0f else 1f - smoothstep(radius * 0.6f, radius, cell[0])
+                surface * (1f - 0.85f * pit)
+            }
+            normalize(0.002f, 0.995f)
+            map { 0.2f + 0.8f * it }
+        }
+    }
+
+    /** Dried, cracked paint: plates of uneven tone split by wandering cracks. */
+    private fun crackle(): GrainField {
+        val cell = FloatArray(3)
+        return GrainField(SIZE).apply {
+            fill { x, y ->
+                val wx = fractal(x, y, 8, 3, 0.5f, 141) * 0.35f + fractal(x, y, 40, 2, 0.5f, 142) * 0.06f
+                val wy = fractal(x, y, 8, 3, 0.5f, 143) * 0.35f + fractal(x, y, 40, 2, 0.5f, 144) * 0.06f
+                cellular(x * K * 18 + wx, y * K * 18 + wy, 18, 145, cell)
+                val width = 0.025f + 0.0125f * (1f + noise(x, y, 24, 146))
+                val crack = 1f - smoothstep(width * 0.4f, width, cell[1] - cell[0])
+                (0.8f + 0.2f * cell[2] + 0.1f * noise(x, y, 48, 147)) * (1f - crack)
+            }
+            normalize(0.002f, 0.998f)
+        }
+    }
+
+    /** Wood: long rings that wander with the grain, crossed by fine fibres. */
+    private fun wood(): GrainField =
+        GrainField(SIZE).apply {
+            fill { x, y ->
+                val ring = y * K * 40 + fbm(x * K * 2, y * K * 3, 2, 3, 3, 0.5f, 151) * 3.5f
+                val phase = ring - TileNoise.floorToInt(ring)
+                val band = smoothstep(0f, 0.65f, phase) * (1f - smoothstep(0.8f, 1f, phase))
+                0.65f * band + 0.35f * (0.5f + 0.5f * gradient(x * K * 6, y * K * 256, 6, 256, 152))
+            }
+            normalize()
+            map { 0.25f + 0.75f * it }
+        }
+
+    /**
+     * Plain-weave settings: [threads] per tile side (even, so over and under alternate across the
+     * seam), thread [width] as a share of the pitch, its per-thread [widthJitter], how much threads
+     * swell into [slubs], and how far a thread dips where it passes under another ([lift]).
+     */
+    private class Weave(
+        val threads: Int,
+        val width: Float,
+        val widthJitter: Float,
+        val slubs: Float,
+        val lift: Float,
+        val seed: Int,
+    )
+
+    private val CANVAS = Weave(threads = 80, width = 0.9f, widthJitter = 0.14f, slubs = 0.3f, lift = 0.6f, seed = 21)
+    private val LINEN = Weave(threads = 128, width = 0.95f, widthJitter = 0.2f, slubs = 0.5f, lift = 0.4f, seed = 71)
+    private val BURLAP = Weave(threads = 32, width = 0.68f, widthJitter = 0.2f, slubs = 0.45f, lift = 0.6f, seed = 92)
+
+    /**
+     * A plain weave: warp and weft threads with rounded profiles pass alternately over and under
+     * each other; every thread wanders a little, varies in thickness and swells into slubs.
+     */
+    private fun weave(settings: Weave): GrainField {
+        val warp = Threads(settings, vertical = true)
+        val weft = Threads(settings, vertical = false)
+        return GrainField(SIZE).apply {
+            fill { x, y -> max(warp.height(x, y), weft.height(y, x)) }
+            normalize(0.01f, 0.99f)
+            map { 0.15f + 0.85f * smoothstep(0.05f, 0.85f, it) }
+        }
+    }
+
+    /** One direction of a weave, with each thread's wander and width tabulated along its length. */
+    private class Threads(
+        private val settings: Weave,
+        private val vertical: Boolean,
+    ) {
+        private val pitch = SIZE.toFloat() / settings.threads
+        private val seed = settings.seed + if (vertical) 0 else 1000
+        private val wander = FloatArray(settings.threads * SIZE)
+
+        // Phase of the yarn's twist per texel: a whole number of twists along the tile, so it wraps.
+        private val twists = 2f * round(SIZE / (pitch * 0.9f)) / SIZE
+        private val width = FloatArray(settings.threads * SIZE)
+
+        init {
+            for (index in 0 until settings.threads) {
+                val jitter = (TileNoise.unit(index, 0, seed + 2) - 0.5f) * 2f * settings.widthJitter
+                for (along in 0 until SIZE) {
+                    val position = along + 0.5f
+                    wander[index * SIZE + along] = gradient(position * K * 5, index + 0.5f, 5, settings.threads, seed) * pitch * 0.22f
+                    val slub = max(0f, gradient(position * K * 12, index + 0.5f, 12, settings.threads, seed + 1)) * settings.slubs
+                    width[index * SIZE + along] = pitch * settings.width * (1f + jitter + slub)
+                }
+            }
+        }
+
+        /** Height at [across] of the nearest thread, at texel centre [along] of its length. */
+        fun height(
+            across: Float,
+            along: Float,
+        ): Float {
+            val nearest = TileNoise.floorToInt(across / pitch)
+            val at = along.toInt()
+            var best = 0f
+            for (candidate in nearest - 1..nearest + 1) {
+                val index = Math.floorMod(candidate, settings.threads)
+                val centre = (candidate + 0.5f) * pitch + wander[index * SIZE + at]
+                val distance = abs(across - centre) * 2f / width[index * SIZE + at]
+                if (distance < 1f) best = max(best, surface(across, across - centre, along, index) * sqrt(1f - distance * distance))
+            }
+            return best
+        }
+
+        /**
+         * How high thread [index] stands at [along]: lifted where it passes over the other direction,
+         * with the diagonal twist and fibres of a yarn ([offset] is the distance from its centre line).
+         */
+        private fun surface(
+            across: Float,
+            offset: Float,
+            along: Float,
+            index: Int,
+        ): Float {
+            val over = wave(along / pitch - 0.5f - index) * if (vertical) 1f else -1f
+            val twist = 0.5f + 0.5f * wave((along + offset * 1.2f) * twists)
+            val fibre = 0.8f + 0.12f * twist + 0.12f * gradient(along * K * 96, across * K * 384, 96, 384, seed + 3)
+            return (1f - settings.lift + settings.lift * (0.5f + 0.5f * over)) * fibre
+        }
+    }
+
+    /** A smooth wave like cos(π × [phase]): 1 at even, −1 at odd phases, from arithmetic only so it is identical everywhere. */
+    private fun wave(phase: Float): Float {
+        val cycle = phase / 2f - TileNoise.floorToInt(phase / 2f)
+        val t = if (cycle <= 0.5f) cycle * 2f else 2f - cycle * 2f
+        return 1f - 2f * t * t * t * (t * (t * 6f - 15f) + 10f)
+    }
+
+    /** Burlap: a coarse, open weave of hairy threads with loose fibres across the gaps. */
+    private fun burlap(): GrainField {
+        val field = weave(BURLAP)
+        repeat(BURLAP_FIBRES) { index ->
+            val h = TileNoise.hash(index, 2, 162)
+            val x = TileNoise.unit(h) * SIZE
+            val y = TileNoise.unit(TileNoise.next(h)) * SIZE
+            val angle = TileNoise.unit(TileNoise.next(TileNoise.next(h))) * Math.PI
+            val length = 4f + 12f * TileNoise.unit(TileNoise.next(TileNoise.next(TileNoise.next(h))))
+            val dx = StrictMath.cos(angle).toFloat() * length / 2f
+            val dy = StrictMath.sin(angle).toFloat() * length / 2f
+            field.segment(x - dx, y - dy, x + dx, y + dy, 0.6f, 0.6f, 0.45f)
+        }
+        return field
+    }
+
+    private const val SQRT2 = 1.4142135f
+    private const val HALFTONE_CELL = 8f
+    private const val HALFTONE_RADIUS = 2.93f
+    private const val SPECKLE_DOTS = 64_000
+    private const val BURLAP_FIBRES = 700
+}
