+package com.artflow.studio.core.render
+
+import com.artflow.studio.domain.model.brush.BrushLibraryCodec
+import com.artflow.studio.domain.model.brush.BrushParams
+import com.artflow.studio.domain.model.brush.SavedBrush
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.util.concurrent.Callable
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import kotlin.math.abs
+import kotlin.math.sqrt
+
+class GrainSynthTest {
+    private val legacyIds = listOf("paper", "canvas", "charcoal", "fine", "blotch", "bristle", "halftone", "hatch", "speckle")
+
+    @Test
+    fun savedGrainIdsStillResolveAndNewOnesAreStableLowercaseIds() {
+        val ids = BrushTexture.Kind.entries.map { it.id }
+        assertTrue("every id a saved brush may hold still resolves", ids.containsAll(legacyIds))
+        assertEquals(ids.size, ids.toSet().size)
+        ids.forEach { id ->
+            assertTrue(id, id.matches(Regex("[a-z]+")))
+            assertNotNull(id, BrushTexture.from(BrushParams(textureId = id, blendTexture = true)))
+        }
+    }
+
+    @Test
+    fun savedBrushesKeepEveryGrainByReference() {
+        BrushTexture.Kind.entries.forEach { kind ->
+            val brush = SavedBrush("grain", "Grain", BrushParams(textureId = kind.id, blendTexture = true))
+            assertEquals(kind.id, listOf(brush), BrushLibraryCodec.decode(BrushLibraryCodec.encode(listOf(brush))))
+        }
+    }
+
+    @Test
+    fun everyMapIsDeterministicAcrossThreads() {
+        val pool = Executors.newFixedThreadPool(3)
+        try {
+            BrushTexture.Kind.entries.forEach { kind ->
+                val runs = List(3) { pool.submit(Callable { GrainSynth.generate(kind).values }) }.map { it.get(60, TimeUnit.SECONDS) }
+                runs.drop(1).forEach { assertArrayEquals(kind.id, runs[0], it, 0f) }
+                assertArrayEquals(kind.id, runs[0].quantized(), GrainSynth.tile(kind).values)
+            }
+        } finally {
+            pool.shutdown()
+        }
+    }
+
+    private fun FloatArray.quantized(): ByteArray = ByteArray(size) { (this[it].coerceIn(0f, 1f) * 255f + 0.5f).toInt().toByte() }
+
+    @Test
+    fun valuesAreCoverageAndNoMapIsFlatOrSaturated() {
+        BrushTexture.Kind.entries.forEach { kind ->
+            val values = GrainSynth.generate(kind).values
+            assertTrue(kind.id, values.all { it in 0f..1f })
+            val mean = values.average()
+            val deviation = sqrt(values.sumOf { (it - mean) * (it - mean) } / values.size)
+            assertTrue("${kind.id} mean $mean", mean in 0.2..0.9)
+            assertTrue("${kind.id} deviation $deviation", deviation > 0.05)
+        }
+    }
+
+    @Test
+    fun everyTileWrapsWithoutASeam() {
+        BrushTexture.Kind.entries.forEach { kind ->
+            val tile = GrainSynth.tile(kind)
+            val size = tile.size
+
+            fun at(
+                x: Int,
+                y: Int,
+            ) = tile.values[y * size + x].toInt() and 0xFF
+            // Steps across the wrap edges are no bigger than steps between neighbours inside the tile,
+            // in general and along the middle lines, which meet a regular weave or screen in the same phase.
+            var inside = 0.0
+            var seam = 0.0
+            var middle = 0.0
+            val half = size / 2
+            for (i in 0 until size) {
+                for (j in 0 until size - 1) inside += abs(at(j, i) - at(j + 1, i)) + abs(at(i, j) - at(i, j + 1))
+                seam += abs(at(size - 1, i) - at(0, i)) + abs(at(i, size - 1) - at(i, 0))
+                middle += abs(at(half - 1, i) - at(half, i)) + abs(at(i, half - 1) - at(i, half))
+            }
+            val insideMean = inside / (2.0 * size * (size - 1))
+            val seamMean = seam / (2.0 * size)
+            val middleMean = middle / (2.0 * size)
+            val allowed = maxOf(insideMean, middleMean) * 1.3 + 1.0
+            assertTrue("${kind.id}: seam $seamMean, inside $insideMean, middle $middleMean", seamMean <= allowed)
+        }
+    }
+
+    @Test
+    fun scaledGrainsChangeSmoothlyBetweenPixels() {
+        // Nearest sampling drew each texel as a flat block; bilinear sampling never jumps far between neighbours.
+        BrushTexture.Kind.entries.filter { it != BrushTexture.Kind.HALFTONE }.forEach { kind ->
+            val texture = requireNotNull(BrushTexture.from(BrushParams(textureId = kind.id, blendTexture = true, textureScale = 4f)))
+            var largest = 0f
+            for (y in 0 until 64) {
+                for (x in 0 until 64) largest = maxOf(largest, abs(texture.coverage(x, y) - texture.coverage(x + 1, y)))
+            }
+            assertTrue("${kind.id} jumps $largest between neighbours at 4x", largest < 0.5f)
+        }
+    }
+
+    @Test
+    fun theSameCanvasPixelAlwaysReadsTheSameGrain() {
+        val params = BrushParams(textureId = "charcoal", blendTexture = true, textureScale = 1.7f, textureRotation = 33f)
+        val first = requireNotNull(BrushTexture.from(params))
+        val second = requireNotNull(BrushTexture.from(params))
+        for (i in 0 until 2000) {
+            val x = i * 37 % 1999 - 600
+            val y = i * 53 % 1777 - 400
+            assertEquals(first.coverage(x, y), second.coverage(x, y), 0f)
+        }
+    }
+
+    @Test
+    fun noiseRepeatsExactlyAfterItsPeriod() {
+        for (i in 0 until 200) {
+            val x = i * 0.37f
+            val y = i * 0.11f
+            assertEquals(TileNoise.gradient(x, y, 7, 5, 3), TileNoise.gradient(x + 7f, y + 5f, 7, 5, 3), 1e-4f)
+        }
+    }
