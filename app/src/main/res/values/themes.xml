<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.ArtFlow" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="android:colorPrimary">@color/artflow_primary</item>
        <item name="android:colorPrimaryDark">@color/artflow_primary_dark</item>
        <item name="android:colorAccent">@color/artflow_primary</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/artflow_background</item>
        <item name="android:windowBackground">@color/artflow_background</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/artflow_background</item>
        <item name="android:navigationBarColor">@color/artflow_surface</item>
        
        <!-- Window flags for full-screen drawing experience -->
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        
        <!-- Disable hardware acceleration for specific scenarios if needed -->
        <item name="android:hardwareAccelerated">true</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.ArtFlow.Splash" parent="Theme.ArtFlow">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <!-- Dialog theme -->
    <style name="Theme.ArtFlow.Dialog" parent="android:Theme.Material.Light.Dialog">
        <item name="android:colorPrimary">@color/artflow_primary</item>
        <item name="android:colorAccent">@color/artflow_primary</item>
        <item name="android:background">@color/artflow_surface</item>
    </style>
</resources>
