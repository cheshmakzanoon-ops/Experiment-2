<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Base application theme.

      The app is dark-first: Compose draws the real UI from `ArtFlowTheme`, but the window itself
      (behind the first frame, in system dialogs and in the status/navigation bars) uses these
      platform attributes. Keep this in step with `domain/model/settings/AppSettings` so the window
      never flashes a light surface before Compose composes.
    -->
    <style name="Theme.ArtFlow" parent="android:Theme.Material.NoActionBar">
        <!-- Primary brand color -->
        <item name="android:colorPrimary">@color/artflow_primary</item>
        <item name="android:colorPrimaryDark">@color/artflow_primary_dark</item>
        <item name="android:colorAccent">@color/artflow_primary</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/artflow_background</item>
        <item name="android:windowBackground">@color/artflow_background</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/artflow_background</item>
        <item name="android:navigationBarColor">@color/artflow_surface</item>
        <!-- Light icon treatment would be invisible on the near-black bars above. -->
        <item name="android:windowLightStatusBar">false</item>

        <!-- Window flags for full-screen drawing experience -->
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>

        <item name="android:hardwareAccelerated">true</item>
    </style>

    <!--
      Cold-start window: a dark background with the mark centred on it. The activity starts on this
      theme and switches to `Theme.ArtFlow` in `onCreate`, which is the dependency-free equivalent of
      the AndroidX splash screen library.
    -->
    <style name="Theme.ArtFlow.Starting" parent="Theme.ArtFlow">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <!-- Dialog theme (Material dialogs are dark to match the editor chrome). -->
    <style name="Theme.ArtFlow.Dialog" parent="android:Theme.Material.Dialog">
        <item name="android:colorPrimary">@color/artflow_primary</item>
        <item name="android:colorAccent">@color/artflow_primary</item>
        <item name="android:background">@color/artflow_surface</item>
    </style>
</resources>
