<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below (`android:fullBackupContent`).

  Listing includes restricts auto backup to these paths. Project pixels (`filesDir/projects`) must
  be included alongside the Room database, otherwise a restored install has project rows but no
  artwork. The previous excludes pointed at files this app never creates.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="database" path="artflow_database" />
    <include domain="file" path="projects" />
</full-backup-content>
