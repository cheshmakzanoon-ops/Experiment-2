<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (cloud backup and device transfer).

  Project pixels live in `filesDir/projects/<id>` and the project index lives in the Room database,
  so both must be listed: backing up only the database would restore projects whose canvases are
  missing. The former `./artwork` and `./cache` paths never existed in this layout.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="artflow_database" />
        <include domain="file" path="projects" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="artflow_database" />
        <include domain="file" path="projects" />
    </device-transfer>
</data-extraction-rules>
