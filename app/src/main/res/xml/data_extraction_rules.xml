<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include app-specific data -->
        <include domain="sharedpref" path="." />
        <!-- Must match ArtFlowDatabase.DATABASE_NAME ("artflow_database"). -->
        <include domain="database" path="artflow_database" />
        <include domain="file" path="./artwork" />

        <!-- Exclude temporary and cache files -->
        <exclude domain="file" path="./cache" />
        <exclude domain="file" path="./temp" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="artflow_database" />
        <include domain="file" path="./artwork" />
        <exclude domain="file" path="./cache" />
        <exclude domain="file" path="./temp" />
    </device-transfer>
</data-extraction-rules>
