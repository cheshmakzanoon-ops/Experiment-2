<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Storage permissions.

      Export publishing goes through MediaStore, so API 29+ needs no storage permission at all and
      API 26-28 needs WRITE_EXTERNAL_STORAGE. Media *read* permissions are not requested because the
      app never queries the user's media library.
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <!--
      The canvas renders through OpenGLCanvasRenderer on a GLSurfaceView, which requires at least
      OpenGL ES 2.0; the GL renderer targets GLES20. Advertising this keeps the app out of devices
      whose GPU driver cannot supply a 2.0 context.
    -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <!--
      Stylus and input features. Touch support is assumed (Play filters devices without a
      touchscreen for every app), so only multi-touch — which the pinch-zoom canvas genuinely
      needs — is declared. Marking plain `touchscreen` required would hide the app from some
      Chromebook-class devices that run Android apps fine.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen.multitouch"
        android:required="true" />

    <!--
      A mouse, trackpad or keyboard-only computer (ChromeOS, DeX, a desktop window) can run the editor. Touch
      becomes optional on top of the multi-touch requirement above, so those devices are not filtered out.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
      Edge-to-edge. Apps targeting API 35+ draw under the system bars, and from API 36
      `android:windowOptOutEdgeToEdgeEnforcement` is deprecated and ignored, so the UI handles the
      insets instead: the Material3 top app bars consume the top/horizontal insets themselves,
      `Scaffold` content is padded by its slots, and the editor's bottom bar pads itself with the
      safe-drawing insets. The near-black window background (`@color/artflow_background`, or the
      Compose theme in light mode) therefore reads correctly behind the bars.
    -->
    <application
        android:name=".ArtFlowApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ArtFlow"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="36">

        <activity
            android:name=".presentation.ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ArtFlow.Starting"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize"
            android:resizeableActivity="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Files other apps open or share with ArtFlow. Pictures arrive by Edit with or Share; ArtFlow's own and
              Procreate's file types arrive by Open with, matched by name because file managers hand most of them over
              as application/octet-stream. A path pattern's wildcard does not backtrack, so each extension is listed for
              names with up to three extra dots.
            -->
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="image/vnd.adobe.photoshop" />
                <data android:mimeType="model/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.procreate" />
                <data android:pathPattern=".*\\..*\\.procreate" />
                <data android:pathPattern=".*\\..*\\..*\\.procreate" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.procreate" />
                <data android:pathPattern=".*\\.psd" />
                <data android:pathPattern=".*\\..*\\.psd" />
                <data android:pathPattern=".*\\..*\\..*\\.psd" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.psd" />
                <data android:pathPattern=".*\\.artflow" />
                <data android:pathPattern=".*\\..*\\.artflow" />
                <data android:pathPattern=".*\\..*\\..*\\.artflow" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.artflow" />
                <data android:pathPattern=".*\\.brush" />
                <data android:pathPattern=".*\\..*\\.brush" />
                <data android:pathPattern=".*\\..*\\..*\\.brush" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.brush" />
                <data android:pathPattern=".*\\.brushset" />
                <data android:pathPattern=".*\\..*\\.brushset" />
                <data android:pathPattern=".*\\..*\\..*\\.brushset" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.brushset" />
                <data android:pathPattern=".*\\.swatches" />
                <data android:pathPattern=".*\\..*\\.swatches" />
                <data android:pathPattern=".*\\..*\\..*\\.swatches" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.swatches" />
                <data android:pathPattern=".*\\.abr" />
                <data android:pathPattern=".*\\..*\\.abr" />
                <data android:pathPattern=".*\\..*\\..*\\.abr" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.abr" />
                <data android:pathPattern=".*\\.artbrush" />
                <data android:pathPattern=".*\\..*\\.artbrush" />
                <data android:pathPattern=".*\\..*\\..*\\.artbrush" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.artbrush" />
                <data android:pathPattern=".*\\.glb" />
                <data android:pathPattern=".*\\..*\\.glb" />
                <data android:pathPattern=".*\\..*\\..*\\.glb" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.glb" />
                <data android:pathPattern=".*\\.gltf" />
                <data android:pathPattern=".*\\..*\\.gltf" />
                <data android:pathPattern=".*\\..*\\..*\\.gltf" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.gltf" />
                <data android:pathPattern=".*\\.usdz" />
                <data android:pathPattern=".*\\..*\\.usdz" />
                <data android:pathPattern=".*\\..*\\..*\\.usdz" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.usdz" />
            </intent-filter>
        </activity>

        <!-- File provider for sharing artwork -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
