<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Storage permissions.

      Export publishing goes through MediaStore, so API 29+ needs no storage permission at all and
      API 26-28 needs WRITE_EXTERNAL_STORAGE. Media *read* permissions are not requested because the
      app never queries the user's media library.
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <!--
      The canvas renders through OpenGLCanvasRenderer on a GLSurfaceView, which requires at least
      OpenGL ES 2.0; the GL renderer targets GLES20. Advertising this keeps the app out of devices
      whose GPU driver cannot supply a 2.0 context.
    -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <!--
      Stylus and input features. Touch support is assumed (Play filters devices without a
      touchscreen for every app), so only multi-touch — which the pinch-zoom canvas genuinely
      needs — is declared. Marking plain `touchscreen` required would hide the app from some
      Chromebook-class devices that run Android apps fine.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen.multitouch"
        android:required="true" />

    <!--
      Apps targeting API 35+ are forced edge-to-edge: the window draws under the status and
      navigation bars regardless of the theme's statusBarColor/navigationBarColor. The Compose
      chrome (Scaffold) already insets itself, but the platform window theme still paints opaque
      bars and the GL canvas view is not inset-aware, so opt out for now.
    -->
    <application
        android:name=".ArtFlowApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ArtFlow"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:enableOnBackInvokedCallback="true"
        android:windowOptOutEdgeToEdgeEnforcement="true"
        tools:targetApi="36">

        <activity
            android:name=".presentation.ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ArtFlow.Starting"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- File provider for sharing artwork -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
