```
# Android
*.apk
*.aar
*.dex
*.so

# Gradle
.gradle/
build/
!gradle-wrapper.jar

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Newer Android Studio versions
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ IDEA artifacts
*.iml
*.ipr
*.iws
.idea/

# Temporary folder for Jetifier
.temporary-jars/

# Kotlin
*.kotlin_metadata

# Generated files
gen/
out/

# Debug symbols
*.map
*.dbg
```