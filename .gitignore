# Gradle / Android build output
.gradle/
build/
app/build/
.cxx/
.externalNativeBuild/
captures/
release/
*.apk
*.aab
*.ap_
*.dex
*.class
*.jar
*.hprof

# The Gradle wrapper jar must be tracked so ./gradlew works from a fresh clone
!gradle/wrapper/gradle-wrapper.jar

# Native build artifacts
*.o
*.so
obj/
libs/

# Local configuration (machine-specific, must never be committed)
local.properties
keystore.properties
*.jks
*.keystore

# IDE
.idea/
*.iml
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs and temp files
*.log
*.tmp

# Environment files
.env
.env.local
*.env.*

# Coverage reports
coverage/
htmlcov/
.coverage

# Compressed archives
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.cab
*.arj
*.rpm
*.deb
